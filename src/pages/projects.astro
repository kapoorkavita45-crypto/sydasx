        gctx.fillText(ft.text, ft.x, ft.y);
        gctx.shadowBlur = 0;
      }
      gctx.globalAlpha = 1;

      // Draw player
      const playerAlpha = shieldFlash > 0 ? (Math.sin(shieldFlash * 0.8) > 0 ? 1 : 0.3) : 1;
      drawPlayerJet(player.x, player.y, currentJetCfg, playerAlpha);
      if (shieldFlash > 0) shieldFlash -= dt;

