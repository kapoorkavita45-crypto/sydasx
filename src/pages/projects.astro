    function buildSphere() {
      rawNodes.length = 0;
      for (let i = 0; i < NODE_COUNT; i++) {
        const radius = SPHERE_RADIUS * (0.7 + Math.random() * 0.5);
        const phi    = Math.acos(2 * Math.random() - 1);
        const theta  = Math.random() * Math.PI * 2;
        const x3 = radius * Math.sin(phi) * Math.cos(theta);
        const y3 = radius * Math.sin(phi) * Math.sin(theta);
        const z3 = radius * Math.cos(phi);
        const domain = DOMAINS[i % DOMAINS.length];
        const encoded = encodedDomains.has(domain.id);
        rawNodes.push({
          x3, y3, z3,
          domainId: domain.id,
          color: encoded ? domain.color : 'rgba(80,80,110,0.55)',
          coreColor: domain.color,
          size: encoded ? 3.0 : 2.0,
          pulse: 0,
          pulsing: false,
          baseEncoded: encoded
        });
      }
    }

