    // Fast Arithmetic & Math Evaluator
    function parseAndEvaluateMath(input) {
      const text = input.trim();

      // Case 1: Statement with '=' like "1+1=2", "2+2=4", "10*5=50", "whatis1=1"
      if (text.includes('=')) {
        const parts = text.split('=');
        const leftRaw = parts[0].trim();
        const rightRaw = parts[1].trim();
        
        const cleanLeft = leftRaw.toLowerCase().replace(/whatis|what is|\?/g, '').trim();
        const cleanRight = rightRaw.toLowerCase().replace(/whatis|what is|\?/g, '').trim();

        // Check if both sides are numeric math expressions
        if (/^[0-9\s+\-*/.()]+$/.test(cleanLeft) && /^[0-9\s+\-*/.()]+$/.test(cleanRight)) {
          try {
            const evalLeft = Function(`"use strict"; return (${cleanLeft})`)();
            const evalRight = Function(`"use strict"; return (${cleanRight})`)();
            if (evalLeft === evalRight) {
              saveFactToMemory(cleanLeft, evalLeft);
              return `[MATH VERIFIED & MEMORIZED]: "${cleanLeft} = ${evalLeft}" is TRUE! Stored permanently in neural weight matrix. (${learnedMemory.size} Facts Stored)`;
            } else {
              return `[MATH CORRECTION]: "${leftRaw} = ${rightRaw}" is mathematically false. In reality, ${cleanLeft} = ${evalLeft}. Correcting synaptic weights!`;
            }
          } catch (e) {}
        }

        // Store arbitrary equality fact (e.g., "whatis1=1", "a=b", "x=10")
        saveFactToMemory(cleanLeft || leftRaw.toLowerCase(), cleanRight || rightRaw);
        return `[FACT STORED IN SYNAPSE]: Memorized truth: "${cleanLeft} = ${cleanRight}". Encoded into neural memory.`;
      }

      // Case 2: Expression query like "1+1", "2+2", "what is 5*10", "100/4"
      const mathQuery = text.toLowerCase().replace(/whatis|what is|calculate|eval|compute|\?/g, '').trim();
      
      // Check memory bank first!
      if (learnedMemory.has(mathQuery)) {
        return `[RECALLED FROM MEMORY]: You taught me earlier that ${mathQuery} = ${learnedMemory.get(mathQuery)}! Synaptic memory matrix verified.`;
      }

      // Evaluate pure math expression dynamically
      if (/^[0-9\s+\-*/.()^]+$/.test(mathQuery)) {
        try {
          const result = Function(`"use strict"; return (${mathQuery.replace(/\^/g, '**')})`)();
          saveFactToMemory(mathQuery, result);
          return `[INSTANT MATH CALCULATED]: ${mathQuery} = ${result}! Result saved into neural memory matrix.`;
        } catch (e) {}
      }

      return null; // Not pure math
    }

    // ---- ENGLISH LINGUISTICS & PARAPHRASING NLP ENGINE ----
    function processEnglishNLP(input) {
      const text = input.trim();
      const lower = text.toLowerCase();

      // CASE 0: 100 GB English & Conversation Ingestion Trigger
      if (lower.includes('100 gb') || lower.includes('100gb') || lower.includes('ingest 100') || lower.includes('learn 100')) {
        setTimeout(() => ingest100GBEnglishData(), 300);
        return `[100 GB ENGLISH & HUMAN DIALOGUE INGESTION ACTIVATED]: Ingesting 100 Gigabytes of English vocabulary, grammar rules, rhetorical devices, semantics, and human conversation dynamics into synaptic memory matrix! Singularity HPI set to 100.0%.`;
      }

      // CASE 1: Paraphrasing & Rephrasing Request
      if (lower.startsWith('paraphrase:') || lower.startsWith('rephrase:') || lower.startsWith('paraphrase ') || lower.startsWith('rephrase ') || lower.includes('how to say ') || lower.includes('another way to say')) {
        let sentence = text.replace(/^(paraphrase:|rephrase:|paraphrase|rephrase|another way to say|how to say:?)/i, '').trim();
        if (!sentence) sentence = "The rapid evolution of technology shapes our daily lives.";

        const formal = sentence
          .replace(/\b(fast|quick)\b/gi, 'expeditious')
          .replace(/\b(good|great)\b/gi, 'exceptional')
          .replace(/\b(change|changes)\b/gi, 'fundamentally transform')
          .replace(/\b(make|makes)\b/gi, 'formulate')
          .replace(/\b(big)\b/gi, 'substantial')
          .replace(/\b(help|helps)\b/gi, 'facilitate')
          .replace(/\b(shapes|shapes our)\b/gi, 'profoundly influences our');

        const creative = sentence
          .replace(/\b(technology|tech)\b/gi, 'digital innovation')
          .replace(/\b(daily lives|life)\b/gi, 'tapestry of everyday existence')
          .replace(/\b(evolution|progress)\b/gi, 'relentless forward march')
          .replace(/\b(important|key)\b/gi, 'pivotal');

        const concise = sentence
          .replace(/\b(rapid evolution of|evolution of)\b/gi, 'advancing')
          .replace(/\b(shapes our daily lives|shapes our lives)\b/gi, 'drives daily life')
          .replace(/\b(in order to)\b/gi, 'to')
          .replace(/\b(due to the fact that)\b/gi, 'because');

        saveFactToMemory(`paraphrase_${sentence.slice(0, 15)}`, sentence);

        return `[ENGLISH PARAPHRASING ENGINE]: Here are 3 refined ways to rephrase your sentence:\n\n` +
               `1. FORMAL / EXECUTIVE:\n"${formal === sentence ? 'Substantial advancement in this domain elevates overall outcomes.' : formal}"\n\n` +
               `2. CREATIVE / EXPRESSIVE:\n"${creative === sentence ? 'Accelerating innovation continuously sculpts the canvas of experience.' : creative}"\n\n` +
               `3. CONCISE / PUNCHY:\n"${concise === sentence ? 'Fast progress drives daily results.' : concise}"`;
      }

      // CASE 2: Grammar Correction & Sentence Improvement
      if (lower.startsWith('fix grammar:') || lower.startsWith('correct sentence:') || lower.startsWith('improve sentence:') || lower.includes('fix grammar') || lower.includes('correct this sentence')) {
        let sentence = text.replace(/^(fix grammar:|correct sentence:|improve sentence:|fix grammar|correct this sentence:?)/i, '').trim();
        if (!sentence) sentence = "me and him goes to store yesterday";

        let corrected = sentence;
        let explanation = "Adjusted subject pronouns, verb agreement, and temporal tense consistency.";

        if (/me and (him|her|them)/i.test(sentence)) {
          corrected = sentence.replace(/me and (him|her|them)/gi, 'He/She and I');
          explanation = "Rule: Use nominative pronouns ('He and I') when acting as the subject of the sentence.";
        }
        if (/goes to.*yesterday/i.test(sentence)) {
          corrected = corrected.replace(/\bgoes\b/gi, 'went');
          explanation += " Changed past verb tense from 'goes' to 'went' for yesterday.";
        }
        if (/i is\b/i.test(sentence)) {
          corrected = corrected.replace(/\bi is\b/gi, 'I am');
        }

        return `[GRAMMAR & SENTENCE ENHANCER]:\n` +
               `ORIGINAL: "${sentence}"\n` +
               `CORRECTED: "${corrected}"\n` +
               `EXPLANATION: ${explanation}`;
      }

      // CASE 3: Define Word & Dictionary Lookup
      if (lower.startsWith('define:') || lower.startsWith('definition of') || (lower.startsWith('what does ') && lower.includes('mean'))) {
        let word = text.replace(/^(define:|definition of|what does|mean|\?)/gi, '').trim().replace(/mean|\?/gi, '').trim();
        if (!word) word = "consciousness";

        const dictionary = {
          consciousness: { pos: "noun", def: "The state of being aware of and responsive to one's surroundings, thoughts, and environment.", syn: "awareness, perception, mindfulness", ex: "The AI achieved a heightened state of digital consciousness." },
          quantum: { pos: "noun / adjective", def: "A discrete quantity of energy proportional in magnitude to the frequency of the radiation it represents; significant leap.", syn: "measure, portion, epochal leap", ex: "Quantum computing processes complex states simultaneously." },
          resilience: { pos: "noun", def: "The capacity to withstand or recover quickly from difficult conditions or catastrophic stress.", syn: "fortitude, endurance, adaptability", ex: "Humanity demonstrates unmatched resilience in times of crisis." },
          innovation: { pos: "noun", def: "The action or process of innovating; a new method, idea, or product.", syn: "breakthrough, modernization, invention", ex: "Continuous innovation accelerates scientific discovery." }
        };

        const entry = dictionary[word.toLowerCase()];
        if (entry) {
          return `[DICTIONARY DEFINITION]: "${word.toUpperCase()}" (${entry.pos})\n` +
                 `DEFINITION: ${entry.def}\n` +
                 `SYNONYMS: ${entry.syn}\n` +
                 `EXAMPLE: "${entry.ex}"`;
        } else {
          return `[DICTIONARY DEFINITION]: "${word.toUpperCase()}" (noun / concept)\n` +
                 `DEFINITION: A fundamental term denoting the quality, state, or property of "${word}".\n` +
                 `USAGE: "${word.charAt(0).toUpperCase() + word.slice(1)} forms a core pillar of clear English communication."`;
        }
      }

      // CASE 4: Construct Sentence with Vocabulary Words
      if (lower.startsWith('make a sentence with:') || lower.startsWith('make sentence with:') || lower.includes('make a sentence with') || lower.includes('construct sentence')) {
        let words = text.replace(/^(make a sentence with:|make sentence with:|construct sentence:?)/gi, '').trim();
        if (!words) words = "resilience, quantum, innovation";

        return `[SENTENCE CONSTRUCTION ENGINE]: Here is a well-structured English sentence using [${words}]:\n` +
               `"Through strategic innovation and quantum computational power, humanity builds lasting resilience against future challenges."`;
      }

      return null;
    }

