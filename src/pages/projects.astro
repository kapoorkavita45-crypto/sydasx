      const cosY = Math.cos(qnnRotY), sinY = Math.sin(qnnRotY);
      const x1 = x3 * cosY - z3 * sinY;
      const z1 = x3 * sinY + z3 * cosY;
      const cosX = Math.cos(qnnRotX), sinX = Math.sin(qnnRotX);
      const y2 = y3 * cosX - z1 * sinX;
      const z2 = y3 * sinX + z1 * cosX;
      const scale = FOV / (FOV + z2);
      return { x2D: QCX + x1 * scale, y2D: QCY + y2 * scale, scale, z2 };
