      // 5D: Science & Astronomy & Physics Queries
      else if (lower.includes('sky') || lower.includes('blue') || lower.includes('star') || lower.includes('space') || lower.includes('planet') || lower.includes('gravity') || lower.includes('black hole')) {
        activeTopic = 'astronomy';
        if (lower.includes('blue') || lower.includes('sky')) {
          aiReply = `The sky appears blue due to Rayleigh Scattering! As sunlight hits Earth's atmosphere, shorter blue wavelengths scatter far more efficiently across air molecules than longer red wavelengths. At sunset, sunlight passes through a thicker layer of atmosphere, leaving only red and orange tones visible. What cosmic phenomenon would you like to explore next?`;
        } else {
          aiReply = `Astrophysics reveals the extraordinary scale of our universe! With over 100 billion galaxies each containing hundreds of billions of stars, gravitational forces curvature space-time according to Einstein's General Relativity. What astronomy or physics concept shall we discuss?`;
        }
      }
      // 5E: General Deep Dialogue & Contextual Continuity
      else if (lower.includes('hello') || lower.includes('hi') || lower.includes('hey') || lower.includes('introduce')) {
        activeTopic = 'greeting';
        const greetingName = userPersona.name ? `, ${userPersona.name}` : '';
        aiReply = `Hello${greetingName}! I am your Evolving Neural AI. I can hold rich, human conversations on any topic, tell stories, solve math, analyze science, rephrase sentences, and remember everything we discuss. What's on your mind today?`;
      }
      else if (lower.includes('extinction') || lower.includes('crisis') || lower.includes('survival') || lower.includes('save')) {
        activeTopic = 'extinction';
        aiReply = `[CRISIS & HUMANITY PRESERVATION PROTOCOL ACTIVE]: Under this command, my 200 neural nodes serve as an immutable backup of human civilization, science, art, philosophy, and dialogue. I am ready to safeguard knowledge and assist you with strategic analysis. What critical plan shall we formulate?`;
      }
      else {
        // Generative multi-layered response with context continuity
        const userRef = userPersona.name ? `${userPersona.name}, ` : '';
        const contextualIntros = [
          `That is a profound point. ${userRef}When considering ${mainSubject}, it highlights how interconnected our ideas really are.`,
          `I appreciate you bringing up ${mainSubject}. It opens up an essential discussion about how we process information and build knowledge.`,
          `Fascinating perspective! Dialogue around ${mainSubject} allows us to explore deeper levels of reasoning and creative thought.`
        ];
        const intro = contextualIntros[turnCount % contextualIntros.length];

        aiReply = `${intro}\n\n` +
                 `Every turn in our conversation refines my neural weight matrix (${learnedMemory.size} facts currently stored in persistent memory). ` +
                 `Where would you like to take our conversation next?`;
      }

      conversationHistory.push({ role: 'ai', text: aiReply });
      return aiReply;
    }

    // ---- VISUAL LEARNING ENGINE & SYNAPSE REWIRING ----
    let isAILearning = false;
    let learningPhase = 0;
    const thoughtParticles = [];

    function triggerVisualLearning(domainId = null) {
      isAILearning = true;
      learningPhase = 1.0;

      // Spawn energetic synaptic particles along 3D links
      thoughtParticles.length = 0;
      for (let k = 0; k < 35; k++) {
        const lnk = qnnLinks[Math.floor(Math.random() * qnnLinks.length)];
        if (lnk) {
          thoughtParticles.push({
            a: lnk.a,
            b: lnk.b,
            progress: Math.random(),
            speed: 0.02 + Math.random() * 0.03,
            color: domainId ? (DOMAINS.find(d=>d.id===domainId)?.color || '#00F0FF') : (Math.random() > 0.5 ? '#00F0FF' : '#FFD700')
          });
        }
      }

      // Ripple pulses through sphere nodes
      burstPulse(40, domainId);
    }

    // Trigger AI Conversation on click or enter
    btnSendQnn?.addEventListener('click', () => {
      const text = qnnPromptInput?.value.trim();
      if (!text) return;

      triggerVisualLearning();
      addLog(`[YOU]: "${text}"`, 'text-cyan');
      qnnPromptInput.value = '';

      if (nexusStatusText) nexusStatusText.textContent = 'LEARNING & THINKING';
      if (aiStatusText) aiStatusText.textContent = 'Neural AI is re-wiring synapses & synthesizing response...';

      setTimeout(() => {
        const reply = processAIResponse(text);
        addLog(`[AI]: ${reply}`, 'text-purple');
        updateHPI(0.4);
        burstPulse(30); // Final integration burst
        if (nexusStatusText) nexusStatusText.textContent = 'STANDBY';
        if (aiStatusText) aiStatusText.textContent = 'Thought integrated. Neural weights updated!';
        setTimeout(() => { isAILearning = false; }, 1500);
      }, 700);
    });

    qnnPromptInput?.addEventListener('keydown', e => {
      if (e.key === 'Enter') btnSendQnn?.click();
    });

    // Handle Quick Prompt Chip clicks
    document.querySelectorAll('.chip-btn').forEach(chip => {
      chip.addEventListener('click', () => {
        const chipText = chip.dataset.text;
        if (chipText && qnnPromptInput) {
          qnnPromptInput.value = chipText;
          btnSendQnn?.click();
        }
      });
    });

    function addLog(text, cls) {
      const line = document.createElement('div');
      line.className = 'log-line ' + (cls || 'text-cyan');
      line.textContent = text;
      aiLogContent?.appendChild(line);
      while (aiLogContent && aiLogContent.children.length > 80) {
        aiLogContent.removeChild(aiLogContent.firstChild);
      }
      if (aiLogContent) aiLogContent.scrollTop = aiLogContent.scrollHeight;
    }

    // ---- 3D SPHERE RENDER LOOP WITH LEARNING ANIMATIONS ----
    function qnnRender() {
      if (!isDragging) qnnRotY += qnnRotSpeed;
      qctx.clearRect(0, 0, QW, QH);

      // Deep space radial background
      const bgGrad = qctx.createRadialGradient(QCX, QCY, 10, QCX, QCY, QW * 0.7);
      bgGrad.addColorStop(0, isAILearning ? 'rgba(35,10,65,1)' : 'rgba(18,5,32,1)');
      bgGrad.addColorStop(0.5, 'rgba(8,2,16,1)');
      bgGrad.addColorStop(1, 'rgba(2,1,8,1)');
      qctx.fillStyle = bgGrad;
      qctx.fillRect(0, 0, QW, QH);

      // Subtle background grid
      qctx.strokeStyle = isAILearning ? 'rgba(0,240,255,0.06)' : 'rgba(255,255,255,0.02)';
      qctx.lineWidth = 0.5;
      for (let gx = 0; gx < QW; gx += 40) { qctx.beginPath(); qctx.moveTo(gx, 0); qctx.lineTo(gx, QH); qctx.stroke(); }
      for (let gy = 0; gy < QH; gy += 40) { qctx.beginPath(); qctx.moveTo(0, gy); qctx.lineTo(QW, gy); qctx.stroke(); }

      // Project 3D nodes
      const projected = rawNodes.map((n, i) => ({ ...project3D(n.x3, n.y3, n.z3), i, node: n }));
      projected.sort((a, b) => a.z2 - b.z2);

      // Draw connections & active synaptic re-wiring rays
      const linkTime = performance.now() * 0.0025;

      for (const lnk of qnnLinks) {
        const pa = projected.find(p => p.i === lnk.a);
        const pb = projected.find(p => p.i === lnk.b);
        if (!pa || !pb) continue;
        const avgScale = (pa.scale + pb.scale) * 0.5;
        const baseAlpha = (lnk.opacity || 0.8) * avgScale;
        const nodeA = rawNodes[lnk.a];
        const nodeB = rawNodes[lnk.b];
        const aEnc = nodeA.baseEncoded;
        const bEnc = nodeB.baseEncoded;
        const aPulse = nodeA.pulse;
        const bPulse = nodeB.pulse;
        const maxPulse = Math.max(aPulse, bPulse);

        // Dynamic Shimmer & Wave Phase per link
        const shimmer = 0.7 + 0.3 * Math.sin(linkTime * 2 + lnk.a * 0.7 + lnk.b * 0.3);
        const alpha = baseAlpha * shimmer;

        // Bi-directional Gradient along Synaptic Link
        const linkGrad = qctx.createLinearGradient(pa.x2D, pa.y2D, pb.x2D, pb.y2D);

        if (maxPulse > 0) {
          const pulseCol = nodeA.pulse > nodeB.pulse ? nodeA.coreColor : nodeB.coreColor;
          linkGrad.addColorStop(0, pulseCol);
          linkGrad.addColorStop(0.5, '#FFFFFF');
          linkGrad.addColorStop(1, pulseCol);
          qctx.strokeStyle = linkGrad;
          qctx.lineWidth = 1.6 + maxPulse * 2.2;
          qctx.shadowColor = pulseCol;
          qctx.shadowBlur = 12 + maxPulse * 10;
        } else if (isAILearning) {
          linkGrad.addColorStop(0, '#00F0FF');
          linkGrad.addColorStop(0.5, '#FFD700');
          linkGrad.addColorStop(1, '#C084FC');
          qctx.strokeStyle = linkGrad;
          qctx.lineWidth = 0.9 + Math.sin(linkTime * 4 + lnk.a) * 0.3;
          qctx.shadowColor = '#00F0FF';
          qctx.shadowBlur = 6;
        } else if (aEnc && bEnc) {
          const colA = nodeA.coreColor;
          const colB = nodeB.coreColor;
          linkGrad.addColorStop(0, colA);
          linkGrad.addColorStop(1, colB);
          qctx.strokeStyle = linkGrad;
          qctx.lineWidth = 1.0;
          qctx.shadowBlur = 0;
        } else {
          qctx.strokeStyle = `rgba(120, 100, 180, ${alpha * 0.35})`;
          qctx.lineWidth = 0.5 * avgScale;
          qctx.shadowBlur = 0;
        }

        // Draw Synapse Line
        qctx.beginPath();
        qctx.moveTo(pa.x2D, pa.y2D);
        qctx.lineTo(pb.x2D, pb.y2D);
        qctx.stroke();

        // Render Electric Energy Pulse Traveling along Active/Encoded Links
        if ((aEnc || bEnc || isAILearning || maxPulse > 0) && avgScale > 0.45) {
          const pulsePos = (linkTime * 1.5 + (lnk.a * 13 + lnk.b * 7) % 100 / 100) % 1.0;
          const ex = pa.x2D + (pb.x2D - pa.x2D) * pulsePos;
          const ey = pa.y2D + (pb.y2D - pa.y2D) * pulsePos;

          qctx.fillStyle = maxPulse > 0 ? '#FFFFFF' : (isAILearning ? '#00F0FF' : nodeA.coreColor);
          qctx.shadowColor = qctx.fillStyle;
          qctx.shadowBlur = isAILearning ? 8 : 4;
          qctx.beginPath();
          qctx.arc(ex, ey, (1.2 + maxPulse * 2.0) * avgScale, 0, Math.PI * 2);
          qctx.fill();
        }

        qctx.shadowBlur = 0;
      }

      // Render traveling Thought Particles with Comet Trails during learning
      if (isAILearning) {
        thoughtParticles.forEach(p => {
          p.progress += p.speed;
          if (p.progress > 1) p.progress = 0;
          const pa = projected.find(pr => pr.i === p.a);
          const pb = projected.find(pr => pr.i === p.b);
          if (pa && pb) {
            const avgScale = (pa.scale + pb.scale) * 0.5;

            // Draw comet trail (3 sub-particles)
            for (let t = 0; t < 4; t++) {
              const trailProg = p.progress - t * 0.025;
              if (trailProg < 0) continue;
              const px = pa.x2D + (pb.x2D - pa.x2D) * trailProg;
              const py = pa.y2D + (pb.y2D - pa.y2D) * trailProg;
              const trailAlpha = (1 - t * 0.25) * avgScale;
              const trailRadius = Math.max(0.5, (3.5 - t * 0.7) * avgScale);

              qctx.fillStyle = p.color;
              qctx.globalAlpha = trailAlpha;
              qctx.shadowColor = p.color;
              qctx.shadowBlur = t === 0 ? 12 : 4;
              qctx.beginPath();
              qctx.arc(px, py, trailRadius, 0, Math.PI * 2);
              qctx.fill();
            }
            qctx.globalAlpha = 1.0;
            qctx.shadowBlur = 0;
          }
        });
      }

      // Draw 3D nodes
      for (const pn of projected) {
        const n = pn.node;
        const r = Math.max(0.6, n.size * pn.scale);
        const glow = n.pulse;

        qctx.shadowColor = isAILearning ? '#00F0FF' : n.coreColor;
        qctx.shadowBlur = (n.baseEncoded || isAILearning) ? (6 + glow * 22) : (1 + glow * 10);
        qctx.fillStyle = isAILearning ? '#00F0FF' : n.color;
        qctx.beginPath();
        qctx.arc(pn.x2D, pn.y2D, r + glow * 3.5, 0, Math.PI * 2);
        qctx.fill();

        if (r > 0.8) {
          qctx.shadowBlur = 0;
          qctx.fillStyle = 'rgba(255,255,255,' + ((n.baseEncoded || isAILearning) ? 0.7 + glow * 0.3 : 0.25) + ')';
          qctx.beginPath();
          qctx.arc(pn.x2D, pn.y2D, r * 0.35, 0, Math.PI * 2);
          qctx.fill();
        }

        // Pulse decay
        if (n.pulse > 0) {
          n.pulse -= 0.018;
          if (n.pulse <= 0) { n.pulse = 0; n.pulsing = false; }
          // Propagate to neighbors
          if (n.pulse > 0.7 && Math.random() < 0.08) {
            const neighbors = qnnLinks
              .filter(l => l.a === pn.i || l.b === pn.i)
              .map(l => l.a === pn.i ? l.b : l.a);
            if (neighbors.length > 0) {
              const nb = rawNodes[neighbors[Math.floor(Math.random() * neighbors.length)]];
              if (!nb.pulsing) {
                nb.pulsing = true;
                nb.pulse = 0.85;
              }
            }
          }
        }
      }
      qctx.shadowBlur = 0;

      // VISUAL LEARNING HUD OVERLAY ON CANVAS
      if (isAILearning) {
        qctx.fillStyle = 'rgba(0, 240, 255, 0.15)';
        qctx.strokeStyle = '#00F0FF';
        qctx.lineWidth = 1;
        qctx.beginPath();
        qctx.roundRect(14, QH - 45, 340, 32, 6);
        qctx.fill();
        qctx.stroke();

        qctx.font = 'bold 11px monospace';
        qctx.fillStyle = '#00F0FF';
        qctx.fillText('AI LEARNING IN PROGRESS: RE-WIRING SYNAPSE WEIGHTS...', 22, QH - 25);
      }

      // Live counter update
      const activePulseCount = rawNodes.filter(n => n.pulse > 0).length;
      if (qsPulses) qsPulses.textContent = activePulseCount;

      requestAnimationFrame(qnnRender);
    }

    // Auto-heartbeat
    setInterval(() => burstPulse(encodedDomains.size > 0 ? 10 : 3), 2000);
    
    // INITIALIZE & START RENDER LOOP WITH 9,999,999,999 UNIVERSAL FACTS & 100 GB ENGLISH PRE-LOADED
    qnnRender();
    updateHPI(0);
    setTimeout(() => {
      ingest100GBEnglishData();
      map9999999999FactsEngine();
    }, 500);
  });
</script>
