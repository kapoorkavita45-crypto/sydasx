      F22:    { speed: 6,   fireRate: 160,  color: '#00F0FF', secondColor: '#0088FF', statsText: ['★★★☆☆','★★★☆☆','★★★★★'] },
      Viper:  { speed: 8,   fireRate: 220,  color: '#FF9900', secondColor: '#FF4400', statsText: ['★★★★★','★★☆☆☆','★★★☆☆'] },
      Stealth:{ speed: 5,   fireRate: 100,  color: '#C084FC', secondColor: '#7000FF', statsText: ['★★☆☆☆','★★★★★','★★★★★'] }
    };
    let selectedJet = 'F22';
    let currentJetCfg = JET_CLASSES.F22;

    // Jet class selector
    const jetBtns = document.querySelectorAll('.jet-btn');
    const jetStatsDisplay = document.getElementById('jet-stats-display');
    const statLabels = ['Speed','Fire Rate','Shield'];

    jetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        jetBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedJet = btn.dataset.jet;
        currentJetCfg = JET_CLASSES[selectedJet];
        const s = currentJetCfg.statsText;
        if (jetStatsDisplay) {
          jetStatsDisplay.innerHTML = statLabels.map((l,i) => `<span>${l}: ${s[i]}</span>`).join('');
        }
      });
    });

    // Starfield
    const STAR_COUNT = 120;
    const stars = Array.from({ length: STAR_COUNT }, () => ({
      x: Math.random() * W,
      y: Math.random() * H,
      speed: Math.random() * 1.5 + 0.3,
      size: Math.random() * 2 + 0.5,
      bright: Math.random()
    }));

    // Player
    const player = { x: W / 2, y: H - 80, w: 38, h: 38, vx: 0, vy: 0 };

    let bullets = [];
    let enemyJets = [];
    let enemyBullets = [];
    let particles = [];
    let powerups = [];
    let floatingTexts = [];
    let keys = {};
    let mousePos = { x: W / 2, y: H / 2 };
    let isMouseDown = false;
    let lastFireTime = 0;
    let spreadActive = false;
    let spreadTimer = 0;
    let speedBoostActive = false;
    let speedBoostTimer = 0;
    let shieldFlash = 0;
    let invincible = 0;

    // Controls (Ignore input typing)
    window.addEventListener('keydown', e => {
      if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
      keys[e.key] = true;
      if (e.key === ' ' && isGameRunning) e.preventDefault();
    });
    window.addEventListener('keyup', e => {
      if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return;
      keys[e.key] = false;
    });

    gameCanvas.addEventListener('mousemove', e => {
      const rect = gameCanvas.getBoundingClientRect();
      mousePos.x = (e.clientX - rect.left) * (W / rect.width);
      mousePos.y = (e.clientY - rect.top) * (H / rect.height);
    });
    gameCanvas.addEventListener('mousedown', () => { isMouseDown = true; });
    gameCanvas.addEventListener('mouseup', () => { isMouseDown = false; });

    // Buttons
    btnStartGame?.addEventListener('click', () => {
      pilotName = pilotInput?.value.trim() || 'Maverick';
      currentJetCfg = JET_CLASSES[selectedJet];
      hudPilotName.textContent = pilotName.toUpperCase();
      showScreen('game');
      resetAndStartGame();
    });

    btnPause?.addEventListener('click', () => {
      if (!isGameRunning) return;
      isPaused = true;
      pausedModal?.classList.remove('hidden');
    });

    btnResume?.addEventListener('click', () => {
      isPaused = false;
      pausedModal?.classList.add('hidden');
      if (isGameRunning) {
        lastTime = performance.now();
        animFrameId = requestAnimationFrame(gameLoop);
      }
    });

    btnQuit?.addEventListener('click', () => {
      stopGame();
      pausedModal?.classList.remove('hidden');
      pausedModal?.classList.add('hidden');
      showScreen('start');
    });

    btnRestart?.addEventListener('click', () => {
      gameOverModal?.classList.add('hidden');
      resetAndStartGame();
    });

    btnBackHangar?.addEventListener('click', () => {
      gameOverModal?.classList.add('hidden');
      stopGame();
      showScreen('start');
    });

    function showScreen(which) {
      if (which === 'start') {
        startScreen?.classList.remove('hidden'); startScreen?.classList.add('active');
        gameScreen?.classList.remove('active'); gameScreen?.classList.add('hidden');
      } else {
        gameScreen?.classList.remove('hidden'); gameScreen?.classList.add('active');
        startScreen?.classList.remove('active'); startScreen?.classList.add('hidden');
      }
    }

    function resetAndStartGame() {
      score = 0; playerHp = 100; wave = 1; combo = 0; comboTimer = 0;
      spreadActive = false; speedBoostActive = false;
      invincible = 0; shieldFlash = 0;
      hudScore.textContent = '0';
      hudWave.textContent = '1';
      hudCombo.textContent = 'x1';
      if (comboDisplay) comboDisplay.style.opacity = '0';
      hudHpBar.style.width = '100%';
      hudHpBar.style.background = 'linear-gradient(90deg,#00FF66 0%,#00F0FF 100%)';
      bullets = []; enemyJets = []; enemyBullets = [];
      particles = []; powerups = []; floatingTexts = [];
      player.x = W / 2; player.y = H - 80;
      player.vx = 0; player.vy = 0;
      isGameRunning = true; isPaused = false;
      for (let i = 0; i < waveEnemyCount(); i++) spawnEnemy();
      showWaveAnnounce(wave);
      if (animFrameId) cancelAnimationFrame(animFrameId);
      lastTime = performance.now();
      animFrameId = requestAnimationFrame(gameLoop);
    }

    function stopGame() {
      isGameRunning = false;
      if (animFrameId) cancelAnimationFrame(animFrameId);
      animFrameId = null;
    }

    function waveEnemyCount() { return Math.min(3 + wave, 12); }

    function spawnEnemy() {
      const types = ['scout', 'bomber', 'elite'];
      const waveT = wave >= 3 ? (wave >= 6 ? 2 : 1) : 0;
      const typeIdx = Math.min(waveT, 2);
      const tName = types[Math.random() < 0.6 ? typeIdx : Math.max(0, typeIdx - 1)];
      const cfgs = {
        scout:  { w: 28, h: 28, hp: 1, speed: 1.6 + wave * 0.18, color: '#00FF66', accentColor: '#00AA44', score: 100, shoots: false },
        bomber: { w: 36, h: 36, hp: 2, speed: 1.1 + wave * 0.12, color: '#44FF44', accentColor: '#00CC66', score: 200, shoots: true, fireInterval: Math.max(800, 3000 - wave * 150) },
        elite:  { w: 32, h: 32, hp: 3, speed: 2.2 + wave * 0.2,  color: '#AAFFAA', accentColor: '#00FF88', score: 350, shoots: true, fireInterval: Math.max(600, 1800 - wave * 100) }
      };
      const cfg = cfgs[tName];
      enemyJets.push({
        x: Math.random() * (W - 60) + 30,
        y: -Math.random() * 150 - 50,
        ...cfg,
        type: tName,
        hp: cfg.hp,
        maxHp: cfg.hp,
        lastFire: Date.now() + Math.random() * 2000,
        phase: Math.random() * Math.PI * 2,
        phaseSpeed: (Math.random() - 0.5) * 0.04,
        amplitude: Math.random() * 40 + 15
      });
    }

    function fireBullet() {
      if (!isGameRunning) return;
      const now = Date.now();
      if (now - lastFireTime < currentJetCfg.fireRate) return;
      lastFireTime = now;

      const bx = player.x, by = player.y - 18;
      bullets.push({ x: bx, y: by, speed: 14, vx: 0, w: 4, h: 14, type: 'normal' });
      if (spreadActive) {
        bullets.push({ x: bx, y: by, speed: 13, vx: -3, w: 3, h: 11, type: 'spread' });
        bullets.push({ x: bx, y: by, speed: 13, vx:  3, w: 3, h: 11, type: 'spread' });
      }
    }

    function nukeAll() {
      addFloatingText(player.x, player.y - 40, '☢ NUKE!', '#FFD700', 32);
      for (let i = enemyJets.length - 1; i >= 0; i--) {
        const e = enemyJets[i];
        spawnExplosion(e.x, e.y, e.color, 25);
        score += e.score;
        enemyJets.splice(i, 1);
      }
      hudScore.textContent = score.toString();
      for (let n = 0; n < waveEnemyCount(); n++) spawnEnemy();
    }

    function spawnExplosion(x, y, color, count) {
      count = count || 18;
      for (let p = 0; p < count; p++) {
        const angle = (p / count) * Math.PI * 2;
        const spd = Math.random() * 5 + 2;
        particles.push({
          x, y,
          vx: Math.cos(angle) * spd + (Math.random() - 0.5) * 3,
          vy: Math.sin(angle) * spd + (Math.random() - 0.5) * 3,
          color,
          size: Math.random() * 5 + 2,
          life: 1.0
        });
      }
    }

    function spawnPowerup(x, y) {
      if (Math.random() > 0.4) return;
      const types = ['speed', 'shield', 'spread', 'nuke'];
      const weights = [0.35, 0.3, 0.25, 0.1];
      let r = Math.random(), cumulative = 0, chosen = 'speed';
      for (let i = 0; i < types.length; i++) {
        cumulative += weights[i];
        if (r <= cumulative) { chosen = types[i]; break; }
      }
      powerups.push({ x, y, type: chosen, vy: 1.5, life: 1.0, pulse: 0 });
    }

    const POWERUP_ICONS = { speed: '⚡', shield: '🛡', spread: '💥', nuke: '🌀' };
    const POWERUP_COLORS = { speed: '#FFD700', shield: '#00F0FF', spread: '#FF6600', nuke: '#FF007A' };

    function addFloatingText(x, y, text, color, size) {
      size = size || 20;
      floatingTexts.push({ x, y, text, color, size, vy: -1.5, life: 1.0 });
    }

    function updateCombo(hit) {
      if (hit) {
        combo++;
        comboTimer = 180;
        hudCombo.textContent = 'x' + combo;
        if (comboDisplay) comboDisplay.style.opacity = combo >= 2 ? '1' : '0';
      } else {
        comboTimer--;
        if (comboTimer <= 0 && combo > 0) {
          combo = 0;
          hudCombo.textContent = 'x1';
          if (comboDisplay) comboDisplay.style.opacity = '0';
        }
      }
    }

    function showWaveAnnounce(w) {
      if (!waveAnnounce) return;
      waveAnnounce.textContent = w === 1 ? 'WAVE 1 — ENGAGE!' : 'WAVE ' + w + ' — INCOMING!';
      waveAnnounce.classList.remove('hidden');
      setTimeout(() => waveAnnounce && waveAnnounce.classList.add('hidden'), 2200);
    }

    // ---- DRAW HELPERS ----
    function drawPlayerJet(x, y, cfg, alpha) {
      alpha = alpha === undefined ? 1 : alpha;
      const c = cfg.color;
      const c2 = cfg.secondColor;
      gctx.save();
      gctx.globalAlpha = alpha;
      gctx.translate(x, y);

      // Thruster flame
      const flameH = 12 + Math.random() * 10;
      const grad = gctx.createLinearGradient(0, 14, 0, 14 + flameH);
      grad.addColorStop(0, '#FFFFFF');
      grad.addColorStop(0.3, '#FF9900');
      grad.addColorStop(1, 'rgba(255,80,0,0)');
      gctx.fillStyle = grad;
      gctx.beginPath();
      gctx.moveTo(-6, 14); gctx.lineTo(0, 14 + flameH); gctx.lineTo(6, 14);
      gctx.fill();

      // Wings
      gctx.fillStyle = c2;
      gctx.beginPath();
      gctx.moveTo(-8, 4); gctx.lineTo(-20, 14); gctx.lineTo(-10, 14); gctx.closePath(); gctx.fill();
      gctx.beginPath();
      gctx.moveTo(8, 4); gctx.lineTo(20, 14); gctx.lineTo(10, 14); gctx.closePath(); gctx.fill();

      // Hull
      gctx.fillStyle = c;
      gctx.shadowColor = c;
      gctx.shadowBlur = 14;
      gctx.beginPath();
      gctx.moveTo(0, -18); gctx.lineTo(10, 4); gctx.lineTo(8, 14);
      gctx.lineTo(-8, 14); gctx.lineTo(-10, 4); gctx.closePath(); gctx.fill();

      // Cockpit
      gctx.fillStyle = 'rgba(255,255,255,0.9)';
      gctx.shadowBlur = 0;
      gctx.beginPath(); gctx.arc(0, -4, 4, 0, Math.PI * 2); gctx.fill();
      gctx.fillStyle = c;
      gctx.beginPath(); gctx.arc(0, -4, 2, 0, Math.PI * 2); gctx.fill();

      // Shield ring when invincible
      if (invincible > 0) {
        gctx.strokeStyle = 'rgba(0,240,255,' + ((invincible / 60) * 0.8) + ')';
        gctx.lineWidth = 2;
        gctx.shadowColor = '#00F0FF';
        gctx.shadowBlur = 20;
        gctx.beginPath();
        gctx.arc(0, 0, 26, 0, Math.PI * 2);
        gctx.stroke();
      }

      gctx.restore();
    }

    function drawEnemyJet(e) {
      gctx.save();
      gctx.translate(e.x, e.y);
      gctx.rotate(Math.PI);

      const c = e.color;
      const c2 = e.accentColor;

      // Thruster
      const flameH = 8 + Math.random() * 6;
      const grad = gctx.createLinearGradient(0, 14, 0, 14 + flameH);
      grad.addColorStop(0, '#CCFFCC');
      grad.addColorStop(1, 'rgba(0,200,80,0)');
      gctx.fillStyle = grad;
      gctx.beginPath();
      gctx.moveTo(-5, 14); gctx.lineTo(0, 14 + flameH); gctx.lineTo(5, 14); gctx.fill();

      // Wings
      gctx.fillStyle = c2;
      gctx.beginPath();
      if (e.type === 'bomber') {
        gctx.moveTo(-8, 2); gctx.lineTo(-24, 12); gctx.lineTo(-12, 12); gctx.closePath(); gctx.fill();
        gctx.beginPath();
        gctx.moveTo(8, 2); gctx.lineTo(24, 12); gctx.lineTo(12, 12); gctx.closePath(); gctx.fill();
      } else {
        gctx.moveTo(-7, 2); gctx.lineTo(-18, 10); gctx.lineTo(-9, 10); gctx.closePath(); gctx.fill();
        gctx.beginPath();
        gctx.moveTo(7, 2); gctx.lineTo(18, 10); gctx.lineTo(9, 10); gctx.closePath(); gctx.fill();
      }

      // Hull
      gctx.fillStyle = c;
      gctx.shadowColor = c;
      gctx.shadowBlur = 12;
      gctx.beginPath();
      if (e.type === 'elite') {
        gctx.moveTo(0, -18); gctx.lineTo(12, 2); gctx.lineTo(8, 14);
        gctx.lineTo(-8, 14); gctx.lineTo(-12, 2); gctx.closePath();
      } else {
        gctx.moveTo(0, -16); gctx.lineTo(10, 4); gctx.lineTo(7, 14);
        gctx.lineTo(-7, 14); gctx.lineTo(-10, 4); gctx.closePath();
      }
      gctx.fill();

      // HP bar for multi-HP enemies
      if (e.maxHp > 1) {
        gctx.rotate(-Math.PI);
        const bw = e.w + 4;
        gctx.fillStyle = 'rgba(0,0,0,0.6)';
        gctx.fillRect(-bw/2, -e.h/2 - 10, bw, 5);
        gctx.fillStyle = c;
        gctx.fillRect(-bw/2, -e.h/2 - 10, bw * (e.hp / e.maxHp), 5);
        gctx.rotate(Math.PI);
      }

      // Cockpit
      gctx.fillStyle = 'rgba(255,255,255,0.85)';
      gctx.shadowBlur = 0;
      gctx.beginPath(); gctx.arc(0, -4, 3, 0, Math.PI * 2); gctx.fill();

      gctx.restore();
    }

    // ---- MAIN GAME LOOP ----
    function gameLoop(timestamp) {
      if (!isGameRunning || isPaused) return;
      const dt = Math.min((timestamp - lastTime) / 16.67, 3);
      lastTime = timestamp;

      gctx.clearRect(0, 0, W, H);

      // Starfield
      stars.forEach(s => {
        s.y += s.speed * dt;
        if (s.y > H) { s.y = 0; s.x = Math.random() * W; }
        const alpha = 0.3 + s.bright * 0.6;
        gctx.fillStyle = 'rgba(255,255,255,' + alpha + ')';
        gctx.fillRect(s.x, s.y, s.size, s.size);
      });

      // Nebula
      const nebGrad = gctx.createRadialGradient(W * 0.7, H * 0.3, 20, W * 0.7, H * 0.3, 200);
      nebGrad.addColorStop(0, 'rgba(112,0,255,0.04)');
      nebGrad.addColorStop(1, 'rgba(0,0,0,0)');
      gctx.fillStyle = nebGrad;
      gctx.fillRect(0, 0, W, H);

      // Player movement
      let baseSpeed = currentJetCfg.speed * (speedBoostActive ? 1.6 : 1);
      if (keys['w'] || keys['W'] || keys['ArrowUp'])    player.y -= baseSpeed * dt;
      if (keys['s'] || keys['S'] || keys['ArrowDown'])  player.y += baseSpeed * dt;
      if (keys['a'] || keys['A'] || keys['ArrowLeft'])  player.x -= baseSpeed * dt;
      if (keys['d'] || keys['D'] || keys['ArrowRight']) player.x += baseSpeed * dt;

      // Mouse follow
      const dxM = mousePos.x - player.x;
      const dyM = mousePos.y - player.y;
      const distM = Math.hypot(dxM, dyM);
      if (distM > 5) {
        player.x += (dxM / distM) * Math.min(distM * 0.08, baseSpeed * 0.6) * dt;
        player.y += (dyM / distM) * Math.min(distM * 0.08, baseSpeed * 0.6) * dt;
      }

      player.x = Math.max(20, Math.min(W - 20, player.x));
      player.y = Math.max(20, Math.min(H - 20, player.y));

      if (keys[' '] || isMouseDown) fireBullet();

      if (speedBoostActive) { speedBoostTimer -= dt; if (speedBoostTimer <= 0) speedBoostActive = false; }
      if (spreadActive) { spreadTimer -= dt; if (spreadTimer <= 0) spreadActive = false; }
      if (invincible > 0) invincible -= dt;

      updateCombo(false);

      // Player bullets
      gctx.shadowBlur = 0;
      for (let i = bullets.length - 1; i >= 0; i--) {
        const b = bullets[i];
        b.y -= b.speed * dt;
        if (b.vx) b.x += b.vx * dt;
        if (b.y < -20) { bullets.splice(i, 1); continue; }
        const bColor = currentJetCfg.color;
        gctx.fillStyle = bColor;
        gctx.shadowColor = bColor;
        gctx.shadowBlur = 8;
        gctx.fillRect(b.x - b.w / 2, b.y, b.w, b.h);
        gctx.shadowBlur = 0;
      }

      // Enemy bullets
      for (let i = enemyBullets.length - 1; i >= 0; i--) {
        const eb = enemyBullets[i];
        eb.x += eb.vx * dt;
        eb.y += eb.vy * dt;
        if (eb.y > H + 10 || eb.x < -10 || eb.x > W + 10) { enemyBullets.splice(i, 1); continue; }
        gctx.fillStyle = '#FF4444';
        gctx.shadowColor = '#FF4444';
        gctx.shadowBlur = 8;
        gctx.fillRect(eb.x - 3, eb.y - 6, 5, 12);
        gctx.shadowBlur = 0;

        if (invincible <= 0 && Math.hypot(eb.x - player.x, eb.y - player.y) < 22) {
          enemyBullets.splice(i, 1);
          hitPlayer(12);
        }
      }

      // Enemies
      const now = Date.now();
      for (let i = enemyJets.length - 1; i >= 0; i--) {
        const e = enemyJets[i];
        e.y += e.speed * dt;
        e.phase += e.phaseSpeed * dt;
        e.x += Math.sin(e.phase) * e.amplitude * 0.04 * dt;
        e.x = Math.max(30, Math.min(W - 30, e.x));

        drawEnemyJet(e);

        // Enemy shooting
        if (e.shoots && now - e.lastFire > e.fireInterval) {
          e.lastFire = now;
          const ang = Math.atan2(player.y - e.y, player.x - e.x);
          const spd = 4 + wave * 0.2;
          enemyBullets.push({ x: e.x, y: e.y, vx: Math.cos(ang) * spd, vy: Math.sin(ang) * spd });
        }

        // Bullet hits enemy
        let enemyDead = false;
        for (let j = bullets.length - 1; j >= 0; j--) {
          const b = bullets[j];
          if (Math.hypot(b.x - e.x, b.y - e.y) < (e.w / 2 + 8)) {
            bullets.splice(j, 1);
            e.hp--;
            if (e.hp <= 0) {
              spawnExplosion(e.x, e.y, e.color, 22);
              spawnPowerup(e.x, e.y);
              const comboBonus = Math.max(1, combo);
              const pts = e.score * comboBonus;
              score += pts;
              updateCombo(true);
              addFloatingText(e.x, e.y - 20, '+' + pts, e.color, 18);
              hudScore.textContent = score.toString();
              enemyJets.splice(i, 1);
              enemyDead = true;
              if (enemyJets.length === 0) {
                wave++;
                hudWave.textContent = wave.toString();
                for (let n = 0; n < waveEnemyCount(); n++) spawnEnemy();
                showWaveAnnounce(wave);
              } else {
                spawnEnemy();
              }
              break;
            } else {
              addFloatingText(e.x, e.y, e.hp + 'HP', e.accentColor, 14);
            }
          }
        }
        if (enemyDead) continue;

        // Enemy collides with player
        if (invincible <= 0 && Math.hypot(player.x - e.x, player.y - e.y) < 28) {
          spawnExplosion(e.x, e.y, e.color, 12);
          enemyJets.splice(i, 1);
          spawnEnemy();
          hitPlayer(30);
          continue;
        }

        if (e.y > H + 50) {
          enemyJets.splice(i, 1);
          spawnEnemy();
        }
      }

      // Powerups
      for (let i = powerups.length - 1; i >= 0; i--) {
        const pu = powerups[i];
        pu.y += pu.vy * dt;
        pu.life -= 0.003 * dt;
        pu.pulse = (pu.pulse + 0.08 * dt) % (Math.PI * 2);
        if (pu.life <= 0 || pu.y > H + 20) { powerups.splice(i, 1); continue; }

        const pcol = POWERUP_COLORS[pu.type];
        const pulseR = 14 + Math.sin(pu.pulse) * 3;

        gctx.globalAlpha = Math.min(1, pu.life * 3);
        gctx.shadowColor = pcol;
        gctx.shadowBlur = 16;
        gctx.fillStyle = pcol.replace('#', 'rgba(').slice(0,-1) + ',0.15)';
        gctx.beginPath();
        gctx.arc(pu.x, pu.y, pulseR + 2, 0, Math.PI * 2);
        gctx.fill();

        gctx.font = '16px serif';
        gctx.textAlign = 'center';
        gctx.textBaseline = 'middle';
        gctx.fillStyle = '#FFFFFF';
        gctx.shadowBlur = 0;
        gctx.fillText(POWERUP_ICONS[pu.type], pu.x, pu.y);
        gctx.globalAlpha = 1;

        if (Math.hypot(player.x - pu.x, player.y - pu.y) < 28) {
          powerups.splice(i, 1);
          applyPowerup(pu.type);
        }
      }

      // Particles
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx * dt; p.y += p.vy * dt;
        p.vy += 0.12 * dt;
        p.life -= 0.025 * dt;
        if (p.life <= 0) { particles.splice(i, 1); continue; }
        gctx.globalAlpha = Math.max(0, p.life);
        gctx.fillStyle = p.color;
        gctx.fillRect(p.x, p.y, p.size, p.size);
      }
      gctx.globalAlpha = 1;

      // Floating texts
      gctx.shadowBlur = 0;
      for (let i = floatingTexts.length - 1; i >= 0; i--) {
        const ft = floatingTexts[i];
        ft.y += ft.vy * dt;
        ft.life -= 0.018 * dt;
        if (ft.life <= 0) { floatingTexts.splice(i, 1); continue; }
        gctx.globalAlpha = Math.max(0, ft.life);
        gctx.fillStyle = ft.color;
        gctx.shadowColor = ft.color;
        gctx.shadowBlur = 8;
        gctx.font = 'bold ' + ft.size + 'px monospace';
