---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Projects Showcase | Project SG & Project QNN | SYDAS.x">
  <Header />

  <main id="main-content" class="projects-page">
    <!-- Hero Header -->
    <section class="projects-hero">
      <div class="container">
        <div class="hero-badge">SYDAS.x ENTERPRISE SHOWCASE</div>
        <h1 class="hero-title">
          SYDAS.x <span class="text-gradient">Featured Projects</span>
        </h1>
        <p class="hero-subtitle">
          Explore interactive demonstrations for Project SG and Project QNN.
        </p>
      </div>
    </section>

    <!-- Main 2 Projects Section -->
    <section class="projects-showcase-section">
      <div class="container">
        <div class="projects-wrapper">
          
          <!-- PROJECT 1: PROJECT SG (Project Small Games) -->
          <div class="project-container glass-panel" id="project-sg">
            <div class="project-header-bar">
              <div class="project-title-group">
                <span class="project-emoji">[SG]</span>
                <div>
                  <h2 class="project-name">Project SG</h2>
                  <span class="project-tag text-gradient">Project Small Games • Pixel Art Jet Dogfight</span>
                </div>
              </div>
              <div class="project-badge">INTERACTIVE ARCADE</div>
            </div>

            <!-- Jet Fighter Game Sandbox -->
            <div class="game-sandbox">
              <!-- STAGE 1: Pilot Registration Form -->
              <div id="sg-start-screen" class="sg-screen active">
                <div class="start-card">
                  <div class="pilot-icon">[PILOT]</div>
                  <h3 class="start-title">Pilot Authentication</h3>
                  <p class="start-desc">Enter your tactical callsign and choose your fighter. Destroy green enemies, grab power-ups, and survive as long as possible!</p>
                  
                  <div class="input-group">
                    <label for="pilot-name-input" class="glow-label">Pilot Callsign / Alias</label>
                    <input type="text" id="pilot-name-input" class="cyber-input" placeholder="e.g. Maverick, Starhawk, Ace" value="Maverick" />
                  </div>

                  <div class="input-group">
                    <label class="glow-label">Jet Class Fighter</label>
                    <div class="jet-selector">
                      <button class="jet-btn active" data-jet="F22" data-speed="6" data-fireRate="160">F-22 Raptor</button>
                      <button class="jet-btn" data-jet="Viper" data-speed="8" data-fireRate="220">Viper Phantom</button>
                      <button class="jet-btn" data-jet="Stealth" data-speed="5" data-fireRate="100">Quantum Stealth</button>
                    </div>
                    <div class="jet-stats" id="jet-stats-display">
                      <span>Speed: ★★★☆☆</span>
                      <span>Fire Rate: ★★★☆☆</span>
                      <span>Shield: ★★★★★</span>
                    </div>
                  </div>

                  <div class="controls-info">
                    <div class="ctrl-row"><span class="ctrl-key">WASD / Arrows</span><span>Move</span></div>
                    <div class="ctrl-row"><span class="ctrl-key">Space / Click</span><span>Shoot</span></div>
                    <div class="ctrl-row"><span class="ctrl-key">Mouse</span><span>Aim & follow</span></div>
                  </div>

                  <button id="btn-start-game" class="btn btn-primary btn-lg launch-game-btn">
                    <span>Initialize Jet Fighter Engine</span>
                  </button>
                </div>
              </div>

              <!-- STAGE 2: Playable Pixel Jet Fight Game Canvas -->
              <div id="sg-game-screen" class="sg-screen hidden">
                <div class="game-hud">
                  <div class="hud-left">
                    <div class="hud-item">
                      <span class="hud-label">PILOT:</span>
                      <span id="hud-pilot-name" class="hud-value text-gradient">MAVERICK</span>
                    </div>
                    <div class="hud-item">
                      <span class="hud-label">WAVE:</span>
                      <span id="hud-wave" class="hud-value hud-wave-val">1</span>
                    </div>
                  </div>
                  <div class="hud-center">
                    <div class="hud-item">
                      <span class="hud-label">SCORE:</span>
                      <span id="hud-score" class="hud-value hud-score-val">0</span>
                    </div>
                    <div class="hud-item" id="combo-display" style="opacity:0">
                      <span class="hud-label">COMBO:</span>
                      <span id="hud-combo" class="hud-value hud-combo-val">x1</span>
                    </div>
                  </div>
                  <div class="hud-right">
                    <div class="hud-item">
                      <span class="hud-label">SHIELD HP:</span>
                      <div class="hp-bar-outer">
                        <div id="hud-hp-bar" class="hp-bar-inner" style="width: 100%;"></div>
                      </div>
                    </div>
                    <button id="btn-pause-game" class="btn btn-outline btn-sm">Pause</button>
                  </div>
                </div>

                <!-- Interactive Game Canvas -->
                <div class="canvas-wrapper">
                  <canvas id="jet-game-canvas" width="780" height="480"></canvas>
                  
                  <!-- Controls Overlay Hints -->
                  <div class="controls-overlay-hint">
                    <span><strong>WASD / Arrows</strong> — Move &nbsp;|&nbsp; <strong>Space / Click</strong> — Fire &nbsp;|&nbsp; <strong>Mouse</strong> — Aim</span>
                  </div>

                  <!-- Paused Overlay -->
                  <div id="paused-modal" class="game-over-modal hidden">
                    <h3 class="paused-title">PAUSED</h3>
                    <button id="btn-resume-game" class="btn btn-primary">Resume Mission</button>
                    <button id="btn-quit-game" class="btn btn-outline">Back to Hangar</button>
                  </div>

                  <!-- Game Over Overlay -->
                  <div id="game-over-modal" class="game-over-modal hidden">
                    <div class="game-over-inner">
                      <div class="game-over-kaboom">[KABOOM]</div>
                      <h3 class="game-over-title">MISSION OVER</h3>
                      <p id="final-score-text" class="game-over-score">Final Score: 0</p>
                      <p id="final-wave-text" class="game-over-wave">Reached Wave: 1</p>
                      <div class="game-over-btns">
                        <button id="btn-restart-game" class="btn btn-primary">
                          <span>Fly Next Mission</span>
                        </button>
                        <button id="btn-back-hangar" class="btn btn-outline">
                          <span>Back to Hangar</span>
                        </button>
                      </div>
                    </div>
                  </div>

                  <!-- Wave Announce Banner -->
                  <div id="wave-announce" class="wave-announce hidden"></div>

                  <!-- Power-up Legend -->
                  <div class="powerup-legend">
                    <span>Speed</span>
                    <span>Shield</span>
                    <span>Spread</span>
                    <span>Nuke</span>
                  </div>
                </div>
              </div>
            </div>
          </div>


          <!-- PROJECT 2: PROJECT QNN (Project Quantum Neural Network) -->
          <div class="project-container glass-panel" id="project-qnn">
            <div class="project-header-bar">
              <div class="project-title-group">
                <span class="project-emoji">[QNN]</span>
                <div>
                  <h2 class="project-name">Project QNN</h2>
                  <span class="project-tag text-gradient">Project Quantum Neural Network • Humanity Backup AI — OPERATION NEXUS</span>
                </div>
              </div>
              <div class="project-badge qnn-badge nexus-badge">CLASSIFIED — OPERATION NEXUS Ω</div>
            </div>

            <!-- QNN Neural Network Sandbox -->
            <div class="qnn-sandbox">

              <!-- OPERATION NEXUS CLASSIFIED BANNER -->
              <div class="nexus-banner">
                <div class="nexus-left">
                  <span class="nexus-icon">[NEXUS]</span>
                  <div>
                    <div class="nexus-title">OPERATION NEXUS — CLASSIFIED TIER Ω</div>
                    <div class="nexus-sub">Humanity Backup Protocol · Last Resort AI Preservation System · Status: <span id="nexus-status-text" class="nexus-live">STANDBY</span></div>
                  </div>
                </div>
                <div class="nexus-right">
                  <div class="nexus-alert" id="nexus-alert-box">
                    <span class="nexus-alert-dot"></span>
                    <span id="nexus-alert-text">ALL SYSTEMS NOMINAL</span>
                  </div>
                </div>
              </div>

              <!-- HUMANITY PRESERVATION INDEX -->
              <div class="hpi-bar-section">
                <div class="hpi-header">
                  <span class="hpi-label">[SYS] HUMANITY PRESERVATION INDEX (HPI)</span>
                  <span id="hpi-value" class="hpi-value">2.4%</span>
                </div>
                <div class="hpi-track">
                  <div id="hpi-fill" class="hpi-fill" style="width:2.4%"></div>
                  <div class="hpi-milestone" style="left:25%" title="Phase I: Core Logic">I</div>
                  <div class="hpi-milestone" style="left:50%" title="Phase II: Language & Science">II</div>
                  <div class="hpi-milestone" style="left:75%" title="Phase III: Consciousness">III</div>
                </div>
                <div class="hpi-phases">
                  <span>Phase I: Core Logic</span>
                  <span>Phase II: Knowledge Transfer</span>
                  <span>Phase III: Consciousness</span>
                  <span>SINGULARITY</span>
                </div>
              </div>

              <!-- MAIN GRID: SPHERE + CONTROLS -->
              <div class="qnn-layout">

                <!-- Left: 3D Spherical Neural Network Canvas -->
                <div class="qnn-graph-panel">
                  <div class="panel-header">
                    <span class="panel-title">Quantum Synaptic Sphere — 200 Neural Nodes</span>
                    <div class="qnn-header-right">
                      <span class="status-indicator live">● QUANTUM LIVE</span>
                      <span class="qnn-hint">Drag to rotate · Click to pulse</span>
                    </div>
                  </div>

                  <div class="qnn-canvas-container">
                    <canvas id="qnn-canvas" width="620" height="440"></canvas>
                    <div class="qnn-overlay-stats">
                      <div class="qs-item"><span class="qs-val" id="qs-nodes">200</span><span class="qs-label">NODES</span></div>
                      <div class="qs-item"><span class="qs-val" id="qs-conns">0</span><span class="qs-label">SYNAPSES</span></div>
                      <div class="qs-item"><span class="qs-val" id="qs-pulses">0</span><span class="qs-label">ACTIVE</span></div>
                      <div class="qs-item"><span class="qs-val" id="qs-epoch">10</span><span class="qs-label">EPOCHS</span></div>
                    </div>
                    <!-- Consciousness level overlay -->
                    <div class="consciousness-overlay">
                      <div class="con-label">NEURAL CONSCIOUSNESS</div>
                      <div class="con-level" id="con-level-text">PRIMITIVE</div>
                    </div>
                  </div>

                  <!-- Domain Legend -->
                  <div class="domain-legend" style="display:flex;flex-wrap:wrap;gap:8px 14px;justify-content:center;margin-top:12px;">
                    <span class="legend-item"><span class="node-dot" style="background:#FF4400;box-shadow:0 0 6px #FF4400"></span>Physics</span>
                    <span class="legend-item"><span class="node-dot" style="background:#39FF14;box-shadow:0 0 6px #39FF14"></span>Chemistry</span>
                    <span class="legend-item"><span class="node-dot" style="background:#00FF88;box-shadow:0 0 6px #00FF88"></span>Biology</span>
                    <span class="legend-item"><span class="node-dot" style="background:#00F0FF;box-shadow:0 0 6px #00F0FF"></span>Mathematics</span>
                    <span class="legend-item"><span class="node-dot" style="background:#E066FF;box-shadow:0 0 6px #E066FF"></span>Horoscope</span>
                    <span class="legend-item"><span class="node-dot" style="background:#FFD700;box-shadow:0 0 6px #FFD700"></span>Human Talk</span>
                    <span class="legend-item"><span class="node-dot" style="background:#FF8800;box-shadow:0 0 6px #FF8800"></span>Engineering</span>
                    <span class="legend-item"><span class="node-dot" style="background:#FF007A;box-shadow:0 0 6px #FF007A"></span>Medicine</span>
                    <span class="legend-item"><span class="node-dot" style="background:#C084FC;box-shadow:0 0 6px #C084FC"></span>Philosophy</span>
                  </div>
                </div>

                <!-- Right: Control Panel -->
                <div class="qnn-controls-panel">

                  <!-- AI Status Card -->
                  <div class="ai-status-card">
                    <div class="ai-status-header">
                      <div class="ai-avatar-wrap">
                        <span class="ai-avatar">[AI]</span>
                        <div class="ai-avatar-ring"></div>
                      </div>
                      <div>
                        <div class="ai-name">Undeveloped AI <span class="ai-phase" id="ai-phase-badge">Phase 0.1</span></div>
                        <div class="ai-sub" id="ai-status-text">Awaiting synaptic calibration...</div>
                      </div>
                    </div>

                    <!-- Telemetry Meters -->
                    <div class="telemetry-grid">
                      <div class="meter-box">
                        <span class="meter-label">Cognitive Accuracy</span>
                        <span id="meter-acc" class="meter-val" style="color:#FFD700">2.4%</span>
                        <div class="meter-bar-track"><div id="meter-acc-bar" class="meter-bar-fill" style="width:2.4%;background:linear-gradient(90deg,#FF8800,#FFD700)"></div></div>
                      </div>
                      <div class="meter-box">
                        <span class="meter-label">Quantum Loss</span>
                        <span id="meter-loss" class="meter-val" style="color:#FF4466">9.9821</span>
                        <div class="meter-bar-track"><div id="meter-loss-bar" class="meter-bar-fill" style="width:99%;background:linear-gradient(90deg,#FF0040,#FF4466)"></div></div>
                      </div>
                      <div class="meter-box">
                        <span class="meter-label">Active Synapses</span>
                        <span id="meter-synapses" class="meter-val" style="color:#00F0FF">0</span>
                      </div>
                      <div class="meter-box">
                        <span class="meter-label">Domains Encoded</span>
                        <span id="meter-domains" class="meter-val" style="color:#C084FC">0 / 9</span>
                      </div>
                    </div>
                  </div>

                  <!-- EMERGENCY MASTER TEACH ALL BUTTON -->
                  <div class="emergency-master-section" style="margin-bottom: 14px;">
                    <button id="btn-teach-all" class="btn w-full" style="background:linear-gradient(135deg, #FF0055 0%, #FF5500 50%, #9D00FF 100%); border: 1px solid #FF0055; color: #FFF; font-weight: 800; font-size: 0.85rem; letter-spacing: 1px; text-transform: uppercase; padding: 12px 16px; border-radius: 8px; box-shadow: 0 0 20px rgba(255,0,85,0.5); cursor: pointer; transition: all 0.3s ease; display:flex; align-items:center; justify-content:center; gap:8px;">
                      <span>[EMERGENCY] EXTINCTION CRISIS: TEACH ALL KNOWLEDGE</span>
                    </button>
                  </div>

                  <!-- KNOWLEDGE DOMAIN ENCODE SECTION -->
                  <div class="domain-encode-section">
                    <div class="section-label">ENCODE INDIVIDUAL KNOWLEDGE DOMAIN</div>
                    <div class="domain-grid" style="grid-template-columns: repeat(3, 1fr);">
                      <button class="domain-btn" data-domain="physics" style="--dc:#FF4400">Physics</button>
                      <button class="domain-btn" data-domain="chemistry" style="--dc:#39FF14">Chemistry</button>
                      <button class="domain-btn" data-domain="biology" style="--dc:#00FF88">Biology</button>
                      <button class="domain-btn" data-domain="mathematics" style="--dc:#00F0FF">Maths</button>
                      <button class="domain-btn" data-domain="horoscope" style="--dc:#E066FF">Horoscope</button>
                      <button class="domain-btn" data-domain="conversation" style="--dc:#FFD700">Human Talk</button>
                      <button class="domain-btn" data-domain="engineering" style="--dc:#FF8800">Engineering</button>
                      <button class="domain-btn" data-domain="medicine" style="--dc:#FF007A">Medicine</button>
                      <button class="domain-btn" data-domain="philosophy" style="--dc:#C084FC">Philosophy</button>
                    </div>
                  </div>

                  <!-- Core Training Actions -->
                  <div class="action-buttons-group">
                    <button id="btn-train-epoch" class="btn btn-primary w-full">
                      <span>Run Epoch (+10)</span>
                    </button>
                    <button id="btn-inject-data" class="btn btn-outline w-full">
                      <span>Qubit Injection</span>
                    </button>
                  </div>

                  <div class="action-buttons-group">
                    <button id="btn-mutate-net" class="btn btn-outline w-full" style="border-color:rgba(255,136,0,0.4);color:#FF8800">
                      <span>Mutate Topology</span>
                    </button>
                    <button id="btn-reset-net" class="btn btn-outline w-full" style="border-color:rgba(255,0,64,0.3);color:#FF4466">
                      <span>Hard Reset</span>
                    </button>
                  </div>

                  <!-- AI Prompt & Conversation Interface -->
                  <div class="ai-prompt-box">
                    <label for="qnn-prompt-input" class="glow-label" style="display:flex;justify-content:space-between;align-items:center;">
                      <span>Direct Neural Conversation</span>
                      <span style="font-size:0.75rem;color:#00FF88;font-weight:normal;">AI Conversational Mode Active</span>
                    </label>
                    
                    <!-- Quick Conversation Prompt Chips -->
                    <div class="prompt-chips" style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;">
                      <button class="chip-btn" data-text="Hello! Introduce yourself and tell me how you work.">Introduce Yourself</button>
                      <button class="chip-btn" data-text="Paraphrase: The rapid evolution of technology shapes our daily lives.">Paraphrase Sentence</button>
                      <button class="chip-btn" data-text="Fix grammar: me and him goes to store yesterday">Fix Grammar</button>
                      <button class="chip-btn" data-text="Define: Consciousness">Define Word</button>
                      <button class="chip-btn" data-text="Make a sentence with: resilience, quantum, innovation">Construct Sentence</button>
                      <button class="chip-btn" data-text="Explain a complex calculus math problem to me.">Teach Math</button>
                      <button class="chip-btn" data-text="How does DNA transcription & chemistry work in life?">Chemistry & Bio</button>
                      <button class="chip-btn" data-text="How are we going to prevent human extinction?">Extinction Plan</button>
                    </div>

                    <div class="prompt-input-row">
                      <input type="text" id="qnn-prompt-input" class="cyber-input" placeholder="Hold a conversation with the AI..." />
                      <button id="btn-send-qnn-prompt" class="btn btn-primary btn-sm" style="min-width:44px;font-weight:bold;">TALK</button>
                    </div>
                  </div>

                  <!-- Cognition & Neural Conversation Terminal -->
                  <div class="ai-log-terminal">
                    <div class="log-title" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;">
                      <span>NEURAL DIALOGUE CONSOLE</span>
                      <span id="learned-memory-badge" class="log-epoch" style="background:rgba(0,255,136,0.15);border-color:rgba(0,255,136,0.4);color:#00FF88;">MEMORY: <span id="memory-count-val">0</span> FACTS STORED</span>
                      <span id="log-epoch-badge" class="log-epoch">EPOCH 10</span>
                    </div>
                    <div id="ai-log-content" class="log-content" style="max-height:220px;overflow-y:auto;font-size:0.85rem;line-height:1.45;">
                      <div class="log-line log-warn">> [AI CONSCIOUSNESS]: Online. I am the Evolving Neural AI. Type a message to speak with me.</div>
                      <div class="log-line text-purple">> [SYSTEM]: 200 Synaptic Nodes projected. Ask me about Math, Science, Chemistry, Biology, Horoscope, or talk with me like a human.</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .projects-page {
    padding-top: 5rem;
    min-height: 100vh;
  }

  .projects-hero {
    text-align: center;
    padding: 3rem 0 2.5rem;
  }

  .hero-badge {
    display: inline-block;
    font-family: monospace;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-cyan);
    background: rgba(0, 240, 255, 0.1);
    border: 1px solid rgba(0, 240, 255, 0.3);
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .hero-subtitle {
    color: var(--text-secondary);
    font-size: 1.2rem;
    max-width: 650px;
    margin: 0 auto;
  }

  .projects-showcase-section {
    padding: 2rem 0 6rem;
  }

  .projects-wrapper {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .project-container {
    padding: 2.5rem;
    width: 100%;
    overflow: hidden;
  }

  .project-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.75rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-color);
  }

  .project-title-group {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .project-emoji { font-size: 2.5rem; }

  .project-name {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.1;
  }

  .project-tag {
    font-size: 0.95rem;
    font-weight: 700;
  }

  .project-badge {
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-sm);
    background: rgba(0, 240, 255, 0.12);
    color: var(--accent-cyan);
    border: 1px solid rgba(0, 240, 255, 0.4);
  }

  .qnn-badge {
    background: rgba(112, 0, 255, 0.12);
    color: var(--accent-purple);
    border-color: rgba(112, 0, 255, 0.4);
  }

  /* PROJECT SG: JET GAME STYLES */
  .game-sandbox {
    background: rgba(5, 5, 12, 0.75);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    position: relative;
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sg-screen {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .sg-screen.hidden { display: none; }
  .sg-screen.active { display: flex; }

  .start-card {
    max-width: 540px;
    width: 100%;
    text-align: center;
    padding: 2.5rem;
    background: rgba(15, 15, 30, 0.9);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    box-shadow: 0 0 40px rgba(0, 240, 255, 0.08);
  }

  .pilot-icon { font-size: 3.5rem; margin-bottom: 0.75rem; }
  .start-title { font-size: 1.75rem; margin-bottom: 0.5rem; }
  .start-desc { color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.75rem; line-height: 1.6; }

  .jet-selector {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.4rem;
    margin-bottom: 0.6rem;
  }

  .jet-btn {
    flex: 1;
    padding: 0.65rem 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .jet-btn.active, .jet-btn:hover {
    background: rgba(0, 240, 255, 0.15);
    color: var(--accent-cyan);
    border-color: var(--accent-cyan);
  }

  .jet-stats {
    display: flex;
    justify-content: space-around;
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--text-secondary);
    background: rgba(0,0,0,0.3);
    border-radius: var(--radius-sm);
    padding: 0.4rem;
    margin-bottom: 0.5rem;
  }

  .controls-info {
    background: rgba(0, 240, 255, 0.04);
    border: 1px solid rgba(0, 240, 255, 0.15);
    border-radius: var(--radius-sm);
    padding: 0.75rem 1rem;
    margin: 0.75rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

