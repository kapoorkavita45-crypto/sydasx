      } else if (pct < 0.6) {
        hudHpBar.style.background = 'linear-gradient(90deg,#FF9900 0%,#FFD700 100%)';
      }
      if (playerHp <= 0) {
        spawnExplosion(player.x, player.y, '#00F0FF', 35);
        stopGame();
        finalScoreText.textContent = 'Pilot: ' + pilotName.toUpperCase() + ' | Score: ' + score.toLocaleString();
        finalWaveText.textContent = 'Survived to Wave ' + wave;
        gameOverModal?.classList.remove('hidden');
