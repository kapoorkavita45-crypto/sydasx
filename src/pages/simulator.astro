---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="App Creation | Genesis Matrix (49 Play Store Categories)">
  <Header />
  <main id="main-content" class="min-h-screen bg-[#05070d]">
    <iframe 
      src="/app-creation.html" 
      class="w-full min-h-[100vh] h-full border-0 block"
      style="height: calc(100vh - 80px); min-height: 850px;"
      title="Genesis Matrix App Creation Engine"
    ></iframe>
  </main>
  <Footer />
</Layout>
