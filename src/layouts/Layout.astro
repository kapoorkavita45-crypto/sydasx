---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "SYDAS.x — Next-Gen IT Services & Custom Architecture", 
  description = "Crafting futuristic apps, websites, games, and enterprise software engineered for peak performance." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Immediate Theme Initialization to Prevent Flash of Light Theme -->
    <script is:inline>
      (function() {
        var savedTheme = 'dark';
        try {
          savedTheme = localStorage.getItem('sydas-theme') || localStorage.getItem('theme') || 'dark';
        } catch(e) {}
        document.documentElement.setAttribute('data-theme', savedTheme);
      })();
    </script>

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Preload Critical Hero Image for Instant LCP -->
    <link rel="preload" href="/images/egyptian-bg.png" as="image" fetchpriority="high" />

    <!-- Google Fonts — Optimized Non-Render-Blocking Loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Audiowide&family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..900;1,6..96,400..900&family=Cinzel:wght@500;700;900&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,400..900;1,9..40,400..900&family=Exo+2:ital,wght@0,400..900;1,400..900&family=Fira+Code:wght@400;600;700&family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=IBM+Plex+Mono:ital,wght@0,400;0,600;0,700;1,400&family=Inconsolata:wght@400;600;800&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,400..800;1,400..800&family=Manrope:wght@400..800&family=Montserrat:ital,wght@0,400..900;1,400..900&family=Orbitron:wght@500..900&family=Outfit:wght@400..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&family=Poppins:ital,wght@0,300..900;1,300..900&family=Prata&family=Rajdhani:wght@500;600;700&family=Roboto:ital,wght@0,300..900;1,300..900&family=Sora:wght@400..800&family=Space+Grotesk:wght@400..700&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@500..800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Outfit:wght@800;900&display=swap" rel="stylesheet">
    </noscript>
  </head>
  <body>
    <slot />

    <script>
      import { inject } from '@vercel/analytics';
      import { injectSpeedInsights } from '@vercel/speed-insights';
      inject();
      injectSpeedInsights();

      // Global Theme Sync — Default is Dark Theme
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('sydas-theme')) {
          return localStorage.getItem('sydas-theme');
        }
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'dark';
      })();
      
      document.documentElement.setAttribute('data-theme', theme || 'dark');
    </script>
  </body>
</html>
