---
---

<footer class="footer" id="footer">
  <!-- Pixel Art Animated Background Layers -->
  <div class="footer-pixel-bg bg-1 active" style="background-image: url('/images/pixel-scientist.png');"></div>
  <div class="footer-pixel-bg bg-2" style="background-image: url('/images/pixel-engine.png');"></div>
  <div class="footer-pixel-bg bg-3" style="background-image: url('/images/pixel-planets.png');"></div>
  <div class="footer-pixel-bg bg-4" style="background-image: url('/images/pixel-galaxy.png');"></div>

  <!-- High-Contrast Dark Overlay for Readability -->
  <div class="footer-pixel-overlay"></div>

  <div class="container footer-container-content">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="logo" aria-label="SYDAS.X">
          <span class="logo-x text-gradient">X</span>
          <span class="logo-rollout">SYDAS<span class="text-gradient">.X</span></span>
        </a>
        <p class="brand-desc">
          Engineering tomorrow's digital infrastructure today. World-class performance, bleeding-edge design.
        </p>
      </div>

      <div class="footer-links-group">
        <!-- Column 1: Get In Touch (Email, Phone, LinkedIn, Instagram) -->
        <div class="links-col contact-col" tabindex="0">
          <div class="get-in-touch-header">
            <h4 class="col-title text-gradient">Get In Touch</h4>
            <span class="hover-hint-sub">hover over me</span>
          </div>

          <div class="contact-icons-container">
            <!-- Outlook Email -->
            <a href="mailto:clientsupport@sydasx.com" class="contact-link contact-rollout-item" title="Compose Outlook Email" tabindex="0">
              <span class="contact-icon outlook-icon-ft">
                <svg width="20" height="20" viewBox="0 0 32 32" fill="none">
                  <rect x="2" y="6" width="15" height="20" rx="3" fill="#0078D4"/>
                  <rect x="11" y="9" width="19" height="15" rx="2" fill="#28A8EA"/>
                  <path d="M11 10.5L20.5 17.5L30 10.5" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"/>
                  <circle cx="9.5" cy="16" r="4.5" fill="#005A9E"/>
                  <text x="9.5" y="19" font-family="Arial, sans-serif" font-weight="900" font-size="8" fill="#FFFFFF" text-anchor="middle">O</text>
                </svg>
              </span>
              <span class="contact-rollout-text"><strong>Email:</strong> clientsupport@sydasx.com</span>
            </a>

            <!-- Phone Hotline -->
            <div class="footer-phone-group contact-rollout-item" tabindex="0">
              <span class="contact-icon phone-icon-ft">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <div class="contact-rollout-text footer-phones">
                <a href="tel:+14377992182">+1 437-799-(2182) (CA/US)</a>
                <a href="tel:+917355138799">+91 73551 38799 (IN)</a>
                <a href="tel:+61420706786">+61 420 706 786 (AUS)</a>
              </div>
            </div>

            <!-- LinkedIn -->
            <a href="https://linkedin.com/company/sydasx" target="_blank" rel="noopener noreferrer" class="contact-link contact-rollout-item" title="Open LinkedIn" tabindex="0">
              <span class="contact-icon linkedin-icon-ft">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.7a1.62 1.62 0 1 0 0 3.24 1.62 1.62 0 0 0 0-3.24z"/></svg>
              </span>
              <span class="contact-rollout-text"><strong>LinkedIn:</strong> linkedin.com/company/sydasx</span>
            </a>

            <!-- Instagram -->
            <a href="https://instagram.com/sydasx_official" target="_blank" rel="noopener noreferrer" class="contact-link contact-rollout-item" title="Open Instagram" tabindex="0">
              <span class="contact-icon instagram-icon-ft">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </span>
              <span class="contact-rollout-text"><strong>Instagram:</strong> @sydasx_official</span>
            </a>
          </div>
        </div>

        <!-- Column 2: Navigation / NEXUS with Hover Reveal -->
        <div class="links-col nexus-col" tabindex="0">
          <div class="nexus-header">
            <h4 class="col-title text-gradient">NEXUS</h4>
            <span class="hover-hint-sub">hover over me</span>
          </div>
          <div class="nexus-links-container">
            <a href="/#services" class="nexus-link-item">Capabilities</a>
            <a href="/#builder" class="nexus-link-item">Initialize Project</a>
            <a href="/projects" class="nexus-link-item">Projects Showcase</a>
            <a href="/#contact" class="nexus-link-item">Contact Us</a>
          </div>
        </div>

        <!-- Column 3: Encrypted Uplink -->
        <div class="links-col">
          <h4 class="col-title">Encrypted Uplink</h4>
          <p class="newsletter-text">Join the network for classified briefings and core updates.</p>
          <form class="newsletter-form" id="newsletter-form">
            <input type="email" placeholder="Connect email..." required class="cyber-input" />
            <button type="submit" class="btn btn-primary btn-sm" style="padding: 0.6rem 1rem;">Establish Link</button>
          </form>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">&copy; {new Date().getFullYear()} SYDAS.x Matrix. Systems Operational.</p>
      <div class="social-links">
        <a href="mailto:clientsupport@sydasx.com" aria-label="Outlook Email">OUTLOOK</a>
        <a href="tel:+14377992182" aria-label="Phone US/CA">CALL US/CA</a>
        <a href="tel:+917355138799" aria-label="Phone IN">CALL IN</a>
        <a href="tel:+61420706786" aria-label="Phone AUS">CALL AUS</a>
        <a href="https://linkedin.com/company/sydasx" target="_blank" rel="noopener" aria-label="LinkedIn">LINKEDIN</a>
        <a href="https://instagram.com/sydasx_official" target="_blank" rel="noopener" aria-label="Instagram">INSTAGRAM</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding: 6rem 0 3rem;
    overflow: hidden;
    background: #000;
  }

  .footer-pixel-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 1.5s ease-in-out;
    image-rendering: pixelated;
    filter: brightness(0.65) contrast(1.1);
    z-index: 0;
  }

  .footer-pixel-bg.active {
    opacity: 1;
  }

  .footer-pixel-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(180deg, rgba(5, 5, 10, 0.85) 0%, rgba(5, 5, 10, 0.75) 50%, rgba(5, 5, 10, 0.9) 100%);
    z-index: 1;
    pointer-events: none;
  }

  .footer-container-content {
    position: relative;
    z-index: 2;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr 2.5fr;
    gap: 3.5rem;
    margin-bottom: 4rem;
  }

  .footer-brand {
    max-width: 320px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 900;
    margin-bottom: 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
  }

  .logo-x {
    display: inline-block;
    font-size: 1.3rem;
    font-weight: 900;
    transition: transform 1.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 1.2s ease;
    max-width: 30px;
  }

  .logo-rollout {
    display: inline-block;
    max-width: 0;
    opacity: 0;
    white-space: nowrap;
    overflow: hidden;
    color: var(--text-primary);
    transition: max-width 1.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 1.2s ease;
    transform: translateX(-15px) scaleX(0.85);
  }

  .logo:hover .logo-x {
    max-width: 0;
    opacity: 0;
  }

  .logo:hover .logo-rollout {
    max-width: 200px;
    opacity: 1;
    transform: translateX(0) scaleX(1);
  }

  .brand-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .footer-links-group {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .col-title {
    font-size: 1.05rem;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  /* Get In Touch Header & Hover Hint Subtitle */
  .get-in-touch-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 0.75rem;
    cursor: pointer;
    width: fit-content;
  }

  .get-in-touch-header .col-title {
    margin-bottom: 0.25rem;
  }

  .hover-hint-sub {
    font-size: 0.72rem;
    font-family: monospace;
    color: var(--accent-cyan);
    text-transform: lowercase;
    letter-spacing: 0.08em;
    opacity: 0.8;
    margin-bottom: 0.5rem;
    transition: opacity 0.3s ease, transform 0.3s ease;
    animation: hintPulse 2.5s ease-in-out infinite;
    display: inline-block;
  }

  @keyframes hintPulse {
    0%, 100% { opacity: 0.6; transform: translateY(0); }
    50% { opacity: 1; transform: translateY(2px); }
  }

  /* Icons Container: Hidden by default, revealed on hover/focus of contact-col */
  .contact-icons-container {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(-8px);
    transition: max-height 0.8s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.6s ease,
                transform 0.6s ease,
                margin-top 0.4s ease;
    margin-top: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Reveal ALL 4 ICONS when hovering over GET IN TOUCH / contact-col */
  .contact-col:hover .contact-icons-container,
  .contact-col:focus-within .contact-icons-container {
    max-height: 350px;
    opacity: 1;
    transform: translateY(0);
    margin-top: 0.5rem;
  }

  .contact-col:hover .hover-hint-sub,
  .contact-col:focus-within .hover-hint-sub,
  .nexus-col:hover .hover-hint-sub,
  .nexus-col:focus-within .hover-hint-sub {
    opacity: 0.3;
  }

  /* NEXUS Header & Rollout Container */
  .nexus-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 0.75rem;
    cursor: pointer;
    width: fit-content;
  }

  .nexus-header .col-title {
    margin-bottom: 0.25rem;
    transition: transform 0.3s ease, text-shadow 0.3s ease;
  }

  .nexus-col:hover .nexus-header .col-title,
  .nexus-col:focus-within .nexus-header .col-title {
    transform: translateX(3px);
    text-shadow: 0 0 14px rgba(0, 240, 255, 0.6);
  }

  /* Nexus links container: Hidden by default, smoothly revealed when hovering over NEXUS */
  .nexus-links-container {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(-8px);
    transition: max-height 0.75s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.5s ease,
                transform 0.5s ease,
                margin-top 0.4s ease;
    margin-top: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Reveal all Nexus options upon hovering over NEXUS */
  .nexus-col:hover .nexus-links-container,
  .nexus-col:focus-within .nexus-links-container {
    max-height: 250px;
    opacity: 1;
    transform: translateY(0);
    margin-top: 0.5rem;
  }

  .nexus-link-item {
    display: block;
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
    text-decoration: none;
    transition: color 0.25s ease, transform 0.25s ease, text-shadow 0.25s ease;
    transform: translateX(-6px);
    opacity: 0.85;
  }

  .nexus-col:hover .nexus-link-item,
  .nexus-col:focus-within .nexus-link-item {
    transform: translateX(0);
    opacity: 1;
  }

  .nexus-link-item:hover {
    color: var(--accent-cyan) !important;
    text-shadow: 0 0 10px rgba(0, 240, 255, 0.6);
    transform: translateX(5px) !important;
  }

  .links-col a {
    display: block;
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .links-col a:hover {
    color: var(--accent-cyan);
    text-shadow: 0 0 8px rgba(0, 240, 255, 0.4);
  }

  /* SYDAS.x Logo Style Rollout for Contact Items */
  .contact-rollout-item {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    position: relative;
    cursor: pointer;
    text-decoration: none;
    margin-bottom: 0.9rem;
    padding: 0.3rem 0;
    width: fit-content;
    outline: none;
  }

  .contact-rollout-text {
    display: inline-flex;
    max-width: 0;
    opacity: 0;
    white-space: nowrap;
    overflow: hidden;
    color: var(--text-primary);
    transition: max-width 1.4s cubic-bezier(0.16, 1, 0.3, 1), 
                opacity 0.9s ease, 
                transform 1.1s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform: translateX(-18px) scaleX(0.82);
    transform-origin: left center;
    pointer-events: none;
    font-size: 0.9rem;
    align-items: center;
  }

  /* Rollout expanding on hover & focus */
  .contact-rollout-item:hover .contact-rollout-text,
  .contact-rollout-item:focus-within .contact-rollout-text {
    max-width: 480px;
    opacity: 1;
    transform: translateX(0) scaleX(1);
    pointer-events: auto;
  }

  .footer-phones {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: flex-start;
  }

  .footer-phones a {
    color: var(--text-primary);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 0;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-phones a:hover {
    color: var(--accent-cyan);
    text-decoration: underline;
  }

  .contact-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: rgba(0, 240, 255, 0.08);
    transition: transform 1.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.8s ease, background 0.8s ease, border-color 0.8s ease;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* 1. OUTLOOK FOOTER ICON ANIMATION */
  .outlook-icon-ft {
    color: #0078D4;
    background: rgba(0, 120, 212, 0.14);
    animation: ftFloat 4s ease-in-out infinite;
  }
  .contact-rollout-item:hover .outlook-icon-ft {
    transform: scale(1.22) rotate(-8deg);
    background: rgba(0, 120, 212, 0.3);
    box-shadow: 0 0 16px rgba(0, 120, 212, 0.5);
  }
  .contact-rollout-item:hover .outlook-icon-ft svg {
    animation: ftEnvelopeFlap 0.5s ease-in-out infinite alternate;
  }

  /* 2. PHONE FOOTER ICON ANIMATION (RINGTONE VIBRATION) */
  .phone-icon-ft {
    color: var(--accent-cyan);
    background: rgba(0, 240, 255, 0.14);
    animation: ftFloat 4.4s ease-in-out infinite 0.5s;
  }
  .contact-rollout-item:hover .phone-icon-ft {
    transform: scale(1.22);
    background: rgba(0, 240, 255, 0.3);
    box-shadow: 0 0 16px rgba(0, 240, 255, 0.5);
  }
  .contact-rollout-item:hover .phone-icon-ft svg {
    animation: ftPhoneRing 0.4s ease-in-out infinite;
  }

  /* 3. LINKEDIN FOOTER ICON ANIMATION */
  .linkedin-icon-ft {
    color: #0a66c2;
    background: rgba(10, 102, 194, 0.16);
    animation: ftFloat 4.2s ease-in-out infinite 1s;
  }
  .contact-rollout-item:hover .linkedin-icon-ft {
    transform: scale(1.22) rotate(8deg);
    background: rgba(10, 102, 194, 0.35);
    box-shadow: 0 0 16px rgba(10, 102, 194, 0.6);
  }
  .contact-rollout-item:hover .linkedin-icon-ft svg {
    transform: scale(1.15);
  }

  /* 4. INSTAGRAM FOOTER ICON ANIMATION */
  .instagram-icon-ft {
    color: #e1306c;
    background: linear-gradient(135deg, rgba(240, 148, 51, 0.2), rgba(230, 30, 26, 0.2), rgba(188, 24, 136, 0.2));
    animation: ftFloat 4.6s ease-in-out infinite 1.5s;
  }
  .contact-rollout-item:hover .instagram-icon-ft {
    transform: scale(1.22) rotate(15deg);
    background: linear-gradient(135deg, rgba(240, 148, 51, 0.45), rgba(230, 30, 26, 0.45), rgba(188, 24, 136, 0.45));
    box-shadow: 0 0 16px rgba(225, 48, 108, 0.6);
  }

  /* FOOTER ICON KEYFRAMES */
  @keyframes ftFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  @keyframes ftEnvelopeFlap {
    0% { transform: translateY(0) scale(1); }
    100% { transform: translateY(-2px) scale(1.1); }
  }

  @keyframes ftPhoneRing {
    0% { transform: rotate(0deg); }
    20% { transform: rotate(-14deg); }
    40% { transform: rotate(14deg); }
    60% { transform: rotate(-10deg); }
    80% { transform: rotate(10deg); }
    100% { transform: rotate(0deg); }
  }

  .newsletter-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cyber-input {
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.6);
    border: none;
    color: var(--text-primary);
    font-size: 0.9rem;
    outline: none;
    font-family: monospace;
    transition: all 0.3s ease;
  }

  .cyber-input:focus {
    box-shadow: 0 0 15px rgba(112, 0, 255, 0.4);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2.25rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: monospace;
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .social-links a {
    color: var(--text-secondary);
    transition: color 0.2s ease;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .social-links a:hover {
    color: var(--accent-cyan);
    text-shadow: 0 0 10px rgba(0, 240, 255, 0.6);
  }

  /* Light Mode Specific Enhancements */
  html[data-theme="light"] .footer {
    background: #ffffff;
  }

  html[data-theme="light"] .footer-pixel-bg {
    filter: brightness(1.1) contrast(1.05);
  }

  html[data-theme="light"] .footer-pixel-overlay {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.75) 50%, rgba(255, 255, 255, 0.9) 100%);
  }

  html[data-theme="light"] .col-title,
  html[data-theme="light"] .brand-desc,
  html[data-theme="light"] .links-col a,
  html[data-theme="light"] .contact-link,
  html[data-theme="light"] .newsletter-text,
  html[data-theme="light"] .copyright,
  html[data-theme="light"] .social-links a,
  html[data-theme="light"] .logo-rollout {
    color: #000000 !important;
    font-weight: 700;
    text-shadow: 0 1px 5px rgba(255, 255, 255, 0.95);
  }

  html[data-theme="light"] .cyber-input {
    background: rgba(255, 255, 255, 0.95);
    color: #000000;
    border: 1px solid #cbd5e1;
  }

  @media (max-width: 868px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .footer-links-group {
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    }
    .footer-bottom {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('newsletter-form');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Uplink Established. Systems synchronized.');
      form.reset();
    });

    const bgElements = document.querySelectorAll('.footer-pixel-bg');
    if (bgElements.length) {
      let currentStage = 0;
      setInterval(() => {
        currentStage = (currentStage + 1) % bgElements.length;
        bgElements.forEach((bg, idx) => {
          bg.classList.toggle('active', idx === currentStage);
        });
      }, 5000);
    }
  });
</script>
