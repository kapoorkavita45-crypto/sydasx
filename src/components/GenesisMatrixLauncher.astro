---
---

<section id="builder" class="genesis-launcher-section">
  <!-- Ambient background glow elements -->
  <div class="genesis-glow cyan-glow"></div>
  <div class="genesis-glow green-glow"></div>
  <div class="genesis-glow purple-glow"></div>

  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <div class="matrix-badge">
        <span class="badge-dot"></span>
        <span>AUTONOMOUS SOFTWARE FORGE v7.0</span>
      </div>
      <h2 class="section-title">
        The <span class="text-gradient">Genesis</span> Matrix
      </h2>
      <p class="section-subtitle">
        Dual-engine autonomous creation platform powered by senior engineering architecture.<br/>
        Choose your development vector to synthesize high-conversion web platforms or forge 49-category mobile applications.
      </p>
    </div>

    <!-- DUAL PILLAR ARCHITECTURE GRID (Website Creation vs App Creation) -->
    <div class="genesis-dual-grid">
      
      <!-- PILLAR 1: WEBSITE CREATION -->
      <div class="pillar-card web-pillar glass-panel">
        <div class="pillar-glow-border"></div>
        
        <div class="pillar-content">
          <div class="pillar-header-tag cyan-tag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
            <span>PILLAR I &bull; AUTONOMOUS WEB ENGINE</span>
          </div>

          <h3 class="pillar-title">
            Website <span class="text-gradient-cyan">Creation</span>
          </h3>

          <p class="pillar-desc">
            Synthesize high-conversion, production-ready multi-scroll websites tailored to your exact industry. Choose your brand identity, explore 100+ color & typography themes, and experience live digital checkout in 3 streamlined steps.
          </p>

          <!-- Highlights -->
          <div class="pillar-features-list">
            <div class="feature-item">
              <div class="feature-bullet cyan-bullet">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div class="feature-text">
                <strong>15 Global Industry Verticals</strong>
                <span>E-Commerce, Technology, Food & Drink, Luxury, Medical, Fitness & more.</span>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-bullet cyan-bullet">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div class="feature-text">
                <strong>100+ Visual Presets & Live Studio</strong>
                <span>40 curated themes, 25 typography pairings, and custom 16M RGB palette pickers.</span>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-bullet cyan-bullet">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div class="feature-text">
                <strong>Instant Interactive Preview & Source Export</strong>
                <span>Real-time distraction-free sandbox with zero setup required.</span>
              </div>
            </div>
          </div>

          <!-- Launch Button -->
          <div class="pillar-action">
            <a href="/builder" class="btn btn-primary btn-launch-pillar" id="btn-launch-website-creation">
              <span>Launch Website Creation</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- PILLAR 2: APP CREATION -->
      <div class="pillar-card app-pillar glass-panel">
        <div class="pillar-glow-border app-glow-border"></div>
        
        <div class="pillar-content">
          <div class="pillar-header-tag green-tag">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <line x1="12" y1="18" x2="12.01" y2="18"></line>
            </svg>
            <span>PILLAR II &bull; 49-CATEGORY MOBILE & GAMING FORGE</span>
          </div>

          <h3 class="pillar-title">
            App <span class="text-gradient-green">Creation</span>
          </h3>

          <p class="pillar-desc">
            Forge and test-compile production mobile architectures across all 49 official Google Play Store categories. Select your engine specs, scale concurrency, and inspect simulated hardware latency and cloud budgets.
          </p>

          <!-- Highlights -->
          <div class="pillar-features-list">
            <div class="feature-item">
              <div class="feature-bullet green-bullet">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div class="feature-text">
                <strong>49 Google Play Store Domains</strong>
                <span>32 General Application domains + 17 Real-Time Gaming & Physics Engines.</span>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-bullet green-bullet">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div class="feature-text">
                <strong>Native, Cross-Platform & Hybrid Engine Specs</strong>
                <span>Swift, Kotlin, Flutter, React Native, Capacitor, Unity & Vulkan pipelines.</span>
              </div>
            </div>

            <div class="feature-item">
              <div class="feature-bullet green-bullet">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div class="feature-text">
                <strong>Live Terminal Forge & JSON Blueprint Export</strong>
                <span>Dynamic time-to-market estimates, cloud cost calculations, and 3D device mocks.</span>
              </div>
            </div>
          </div>

          <!-- Launch Button -->
          <div class="pillar-action">
            <a href="/app-creation" class="btn btn-emerald btn-launch-pillar" id="btn-launch-app-creation">
              <span>Launch App Creation</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Feature Highlight Badges (Clean SVG Icons, No Emojis) -->
    <div class="features-pill-row">
      <div class="feature-pill">
        <div class="pill-icon-svg cyan-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
            <line x1="9" y1="22" x2="9" y2="2"></line>
            <line x1="8" y1="6" x2="8.01" y2="6"></line>
            <line x1="16" y1="6" x2="16.01" y2="6"></line>
            <line x1="8" y1="10" x2="8.01" y2="10"></line>
            <line x1="16" y1="10" x2="16.01" y2="10"></line>
            <line x1="8" y1="14" x2="8.01" y2="14"></line>
            <line x1="16" y1="14" x2="16.01" y2="14"></line>
          </svg>
        </div>
        <div class="pill-text">
          <strong>15 Web Verticals</strong>
          <small>Tailored Multi-Scrolls</small>
        </div>
      </div>

      <div class="feature-pill">
        <div class="pill-icon-svg green-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
            <line x1="12" y1="18" x2="12.01" y2="18"></line>
          </svg>
        </div>
        <div class="pill-text">
          <strong>49 App Domains</strong>
          <small>Google Play Store Standard</small>
        </div>
      </div>

      <div class="feature-pill">
        <div class="pill-icon-svg purple-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line>
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </div>
        <div class="pill-text">
          <strong>Pay on Delivery</strong>
          <small>Instant Digital Receipts</small>
        </div>
      </div>

      <div class="feature-pill">
        <div class="pill-icon-svg amber-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
        </div>
        <div class="pill-text">
          <strong>IDE Engine</strong>
          <small>Live Sandbox Synthesis</small>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .genesis-launcher-section {
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
  }

  .genesis-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    filter: blur(140px);
    opacity: 0.12;
    pointer-events: none;
  }

  .cyan-glow {
    top: 20%;
    left: -200px;
    background: var(--accent-cyan);
  }

  .green-glow {
    top: 50%;
    right: -200px;
    background: #00ff88;
    opacity: 0.1;
  }

  .purple-glow {
    bottom: 10%;
    left: 30%;
    background: var(--accent-purple);
  }

  .section-header {
    text-align: center;
    max-width: 850px;
    margin: 0 auto 3.5rem;
  }

  .matrix-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: monospace;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--accent-cyan);
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid rgba(0, 240, 255, 0.25);
    padding: 0.35rem 0.9rem;
    border-radius: 20px;
    margin-bottom: 1.25rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.3); opacity: 1; }
  }

  .section-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .section-subtitle {
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 1.7;
    font-weight: 300;
  }

  /* Dual Pillar Grid */
  .genesis-dual-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto 3rem;
  }

  .pillar-card {
    padding: 2.75rem 2.25rem;
    border-radius: var(--radius-lg);
    background: rgba(8, 10, 18, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .pillar-card:hover {
    transform: translateY(-6px);
  }

  .web-pillar:hover {
    border-color: rgba(0, 240, 255, 0.4);
    box-shadow: 0 25px 60px rgba(0, 240, 255, 0.15);
  }

  .app-pillar:hover {
    border-color: rgba(0, 255, 136, 0.4);
    box-shadow: 0 25px 60px rgba(0, 255, 136, 0.15);
  }

  .pillar-header-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    padding: 0.3rem 0.75rem;
    border-radius: 8px;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .cyan-tag {
    color: var(--accent-cyan);
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid rgba(0, 240, 255, 0.25);
  }

  .green-tag {
    color: #00ff88;
    background: rgba(0, 255, 136, 0.08);
    border: 1px solid rgba(0, 255, 136, 0.25);
  }

  .pillar-title {
    font-size: 2.1rem;
    font-weight: 800;
    margin-bottom: 1rem;
    line-height: 1.2;
    color: #ffffff;
  }

  .text-gradient-cyan {
    background: linear-gradient(135deg, var(--accent-cyan), #38bdf8);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .text-gradient-green {
    background: linear-gradient(135deg, #00ff88, #2dd4bf);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .pillar-desc {
    color: var(--text-secondary);
    font-size: 0.96rem;
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  /* Features list */
  .pillar-features-list {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    margin-bottom: 2.5rem;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .feature-bullet {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .cyan-bullet {
    background: rgba(0, 240, 255, 0.12);
    border: 1px solid rgba(0, 240, 255, 0.35);
    color: var(--accent-cyan);
  }

  .green-bullet {
    background: rgba(0, 255, 136, 0.12);
    border: 1px solid rgba(0, 255, 136, 0.35);
    color: #00ff88;
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .feature-text strong {
    font-size: 0.92rem;
    color: #ffffff;
  }

  .feature-text span {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  /* Pillar Button */
  .pillar-action {
    margin-top: auto;
  }

  .btn-launch-pillar {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1rem 1.75rem;
    font-size: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border-radius: 14px;
    transition: all 0.3s ease;
  }

  .btn-emerald {
    background: linear-gradient(135deg, #00ff88, #059669);
    color: #05070d;
    box-shadow: 0 8px 30px rgba(0, 255, 136, 0.3);
  }

  .btn-emerald:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0, 255, 136, 0.45);
    color: #000000;
  }

  /* Feature Highlight Pills */
  .features-pill-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding-top: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .feature-pill {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1.1rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .feature-pill:hover {
    border-color: rgba(0, 240, 255, 0.3);
    background: rgba(0, 240, 255, 0.03);
    transform: translateY(-2px);
  }

  .pill-icon-svg {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .cyan-icon {
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid rgba(0, 240, 255, 0.2);
    color: var(--accent-cyan);
  }

  .green-icon {
    background: rgba(0, 255, 136, 0.08);
    border: 1px solid rgba(0, 255, 136, 0.2);
    color: #00ff88;
  }

  .purple-icon {
    background: rgba(176, 38, 255, 0.08);
    border: 1px solid rgba(176, 38, 255, 0.2);
    color: var(--accent-purple);
  }

  .amber-icon {
    background: rgba(255, 183, 3, 0.08);
    border: 1px solid rgba(255, 183, 3, 0.2);
    color: #ffb703;
  }

  .pill-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .pill-text strong {
    font-size: 0.88rem;
    color: #ffffff;
  }

  .pill-text small {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  @media (max-width: 992px) {
    .genesis-dual-grid {
      grid-template-columns: 1fr;
    }
    .features-pill-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .features-pill-row {
      grid-template-columns: 1fr;
    }
    .pillar-card {
      padding: 2rem 1.5rem;
    }
  }
</style>
