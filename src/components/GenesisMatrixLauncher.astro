---
---

<section id="builder" class="genesis-launcher-section">
  <!-- Ambient background glow elements -->
  <div class="genesis-glow cyan-glow"></div>
  <div class="genesis-glow purple-glow"></div>

  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <div class="matrix-badge">
        <span class="badge-dot"></span>
        <span>AI ARCHITECTURE MATRIX v7.0</span>
      </div>
      <h2 class="section-title">
        The <span class="text-gradient">Genesis</span> Matrix
      </h2>
      <p class="section-subtitle">
        Industry-grade AI website architect powered by Google Gemini 2.5 Pro.<br/>
        Built by a team of 100 senior engineers at the world's #1 company.
      </p>
    </div>

    <!-- Main Genesis Launch Hub Card -->
    <div class="genesis-launch-card glass-panel">
      <div class="card-glow-border"></div>
      
      <div class="launch-hero-content">
        <div class="launch-tagline">
          <span class="tag-icon">⚡</span>
          <span>AUTONOMOUS MULTI-SCROLL ENGINE</span>
        </div>
        
        <h3 class="launch-title">
          Create Your Custom Website in <span class="text-gradient">3 Simple Steps</span>
        </h3>
        
        <p class="launch-desc">
          Synthesize high-conversion, production-ready multi-scroll websites tailored to your exact industry. Choose your brand identity, explore 100+ color & typography themes, and experience live Cash-on-Delivery checkout architecture in real-time.
        </p>

        <!-- 3 Step Roadmap Preview -->
        <div class="roadmap-grid">
          <div class="roadmap-step">
            <div class="step-num">01</div>
            <div class="step-info">
              <div class="step-title">Brand Identity</div>
              <div class="step-desc">Enter your brand name to personalize header logos, catalog items & digital receipts.</div>
            </div>
          </div>

          <div class="roadmap-step">
            <div class="step-num">02</div>
            <div class="step-info">
              <div class="step-title">Industry Logic</div>
              <div class="step-desc">Select from 15 global verticals (E-Commerce, Fashion, IT, Fine Dining, Luxury, etc.).</div>
            </div>
          </div>

          <div class="roadmap-step">
            <div class="step-num">03</div>
            <div class="step-info">
              <div class="step-title">100+ Visual Studio</div>
              <div class="step-desc">Customize 40 background palettes, 40 tab accents, 25 Google fonts & custom RGB pickers.</div>
            </div>
          </div>
        </div>

        <!-- Action Callout & Launch Button -->
        <div class="launch-action-bar">
          <a href="/builder" class="btn btn-primary btn-mega-launch" id="btn-home-launch-builder">
            <span>Create Your Website (Launch Genesis Matrix)</span>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>

          <div class="launch-guarantees">
            <span class="guarantee-item">✓ Distraction-Free Dedicated Builder</span>
            <span class="guarantee-item">✓ 100% Free Live Sandbox Preview</span>
            <span class="guarantee-item">✓ Instant Source Code Export</span>
          </div>
        </div>
      </div>

      <!-- Feature Highlight Badges -->
      <div class="features-pill-row">
        <div class="feature-pill">
          <span class="pill-icon">🏬</span>
          <div class="pill-text">
            <strong>15 Verticals</strong>
            <small>Tailored Architectures</small>
          </div>
        </div>

        <div class="feature-pill">
          <span class="pill-icon">🎨</span>
          <div class="pill-text">
            <strong>100+ Visual Presets</strong>
            <small>Fonts & 16M Colors</small>
          </div>
        </div>

        <div class="feature-pill">
          <span class="pill-icon">📦</span>
          <div class="pill-text">
            <strong>Pay on Delivery</strong>
            <small>Instant Digital Receipts</small>
          </div>
        </div>

        <div class="feature-pill">
          <span class="pill-icon">💻</span>
          <div class="pill-text">
            <strong>Antigravity IDE</strong>
            <small>Live Sandbox Preview</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .genesis-launcher-section {
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
  }

  .genesis-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    filter: blur(140px);
    opacity: 0.12;
    pointer-events: none;
  }

  .cyan-glow {
    top: 20%;
    left: -200px;
    background: var(--accent-cyan);
  }

  .purple-glow {
    bottom: 10%;
    right: -200px;
    background: var(--accent-purple);
  }

  .section-header {
    text-align: center;
    max-width: 850px;
    margin: 0 auto 3.5rem;
  }

  .matrix-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: monospace;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--accent-cyan);
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid rgba(0, 240, 255, 0.25);
    padding: 0.35rem 0.9rem;
    border-radius: 20px;
    margin-bottom: 1.25rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.3); opacity: 1; }
  }

  .section-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .section-subtitle {
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 1.7;
    font-weight: 300;
  }

  /* Main Launch Card */
  .genesis-launch-card {
    max-width: 1050px;
    margin: 0 auto;
    padding: 3.5rem;
    border-radius: var(--radius-lg);
    background: rgba(8, 10, 18, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    position: relative;
    overflow: hidden;
  }

  .launch-hero-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .launch-tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--accent-pink);
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .launch-title {
    font-size: clamp(1.8rem, 3.8vw, 2.75rem);
    font-weight: 800;
    margin-bottom: 1.25rem;
    line-height: 1.2;
  }

  .launch-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  /* 3-Step Roadmap Grid */
  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 3rem;
    text-align: left;
  }

  .roadmap-step {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: all 0.3s ease;
  }

  .roadmap-step:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 240, 255, 0.3);
    background: rgba(0, 240, 255, 0.04);
    box-shadow: 0 10px 30px rgba(0, 240, 255, 0.08);
  }

  .step-num {
    font-family: monospace;
    font-size: 1.5rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-pink));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .step-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .step-desc {
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* Launch Action Bar */
  .launch-action-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .btn-mega-launch {
    font-size: 1.15rem;
    font-weight: 800;
    padding: 1.1rem 2.75rem;
    border-radius: 16px;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: 0 10px 40px rgba(0, 240, 255, 0.35);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .btn-mega-launch:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 15px 50px rgba(0, 240, 255, 0.5);
  }

  .launch-guarantees {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .guarantee-item {
    color: #10b981;
  }

  /* Feature Highlight Pills */
  .features-pill-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding-top: 2rem;
  }

  .feature-pill {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
  }

  .pill-icon {
    font-size: 1.5rem;
  }

  .pill-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .pill-text strong {
    font-size: 0.88rem;
    color: #ffffff;
  }

  .pill-text small {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  @media (max-width: 992px) {
    .roadmap-grid {
      grid-template-columns: 1fr;
    }
    .features-pill-row {
      grid-template-columns: repeat(2, 1fr);
    }
    .genesis-launch-card {
      padding: 2.25rem 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .features-pill-row {
      grid-template-columns: 1fr;
    }
  }
</style>
