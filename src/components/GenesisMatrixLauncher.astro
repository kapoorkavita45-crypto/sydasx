---
---

<section id="builder" class="genesis-launcher-section">
  <!-- Ambient background glow elements -->
  <div class="genesis-glow cyan-glow"></div>
  <div class="genesis-glow purple-glow"></div>

  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <div class="matrix-badge">
        <span class="badge-dot"></span>
        <span>AI ARCHITECTURE MATRIX v7.0</span>
      </div>
      <h2 class="section-title">
        The <span class="text-gradient">Genesis</span> Matrix
      </h2>
      <p class="section-subtitle">
        Industry-grade AI website architect powered by Google Gemini 2.5 Pro.<br/>
        Built by a team of 100 senior engineers at the world's #1 company.
      </p>
    </div>

    <!-- Main Genesis Launch Hub Card -->
    <div class="genesis-launch-card glass-panel">
      <div class="card-glow-border"></div>
      
      <div class="launch-hero-content">
        <div class="launch-tagline">
          <span class="tag-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </span>
          <span>AUTONOMOUS MULTI-SCROLL ENGINE</span>
        </div>
        
        <h3 class="launch-title">
          Create Your Custom Website in <span class="text-gradient">3 Simple Steps</span>
        </h3>
        
        <p class="launch-desc">
          Synthesize high-conversion, production-ready multi-scroll websites tailored to your exact industry. Choose your brand identity, explore 100+ color & typography themes, and experience live Cash-on-Delivery checkout architecture in real-time.
        </p>

        <!-- 3 Step Roadmap Preview -->
        <div class="roadmap-grid">
          <div class="roadmap-step">
            <div class="step-num">01</div>
            <div class="step-info">
              <div class="step-title">Brand Identity</div>
              <div class="step-desc">Enter your brand name to personalize header logos, catalog items & digital receipts.</div>
            </div>
          </div>

          <div class="roadmap-step">
            <div class="step-num">02</div>
            <div class="step-info">
              <div class="step-title">Industry Logic</div>
              <div class="step-desc">Select from 15 global verticals (E-Commerce, Fashion, IT, Fine Dining, Luxury, etc.).</div>
            </div>
          </div>

          <div class="roadmap-step">
            <div class="step-num">03</div>
            <div class="step-info">
              <div class="step-title">100+ Visual Studio</div>
              <div class="step-desc">Customize 40 background palettes, 40 tab accents, 25 Google fonts & custom RGB pickers.</div>
            </div>
          </div>
        </div>

        <!-- Action Callout & Launch Buttons -->
        <div class="launch-action-bar">
          <div class="action-buttons-wrap" style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;">
            <a href="/builder" class="btn btn-primary btn-mega-launch" id="btn-home-launch-builder">
              <span>Create Your Website (Launch Genesis Matrix)</span>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>

            <a href="/simulator" class="btn btn-outline" style="border-color: rgba(0,240,255,0.4); color: #00f0ff; border-radius: 16px; padding: 1.1rem 2rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.03em;">
              <span>49-Category App Simulator →</span>
            </a>
          </div>

          <div class="launch-guarantees">
            <span class="guarantee-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Distraction-Free Dedicated Builder</span>
            </span>
            <span class="guarantee-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>100% Free Live Sandbox Preview</span>
            </span>
            <span class="guarantee-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>Instant Source Code Export</span>
            </span>
          </div>
        </div>
      </div>

      <!-- Feature Highlight Badges (Clean SVG Icons, No Emojis) -->
      <div class="features-pill-row">
        <div class="feature-pill">
          <div class="pill-icon-svg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
              <line x1="9" y1="22" x2="9" y2="2"></line>
              <line x1="8" y1="6" x2="8.01" y2="6"></line>
              <line x1="16" y1="6" x2="16.01" y2="6"></line>
              <line x1="8" y1="10" x2="8.01" y2="10"></line>
              <line x1="16" y1="10" x2="16.01" y2="10"></line>
              <line x1="8" y1="14" x2="8.01" y2="14"></line>
              <line x1="16" y1="14" x2="16.01" y2="14"></line>
              <line x1="8" y1="18" x2="8.01" y2="18"></line>
              <line x1="16" y1="18" x2="16.01" y2="18"></line>
            </svg>
          </div>
          <div class="pill-text">
            <strong>15 Verticals</strong>
            <small>Tailored Architectures</small>
          </div>
        </div>

        <div class="feature-pill">
          <div class="pill-icon-svg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"></circle>
              <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"></circle>
              <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"></circle>
              <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"></circle>
              <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.5 17.5 2 12 2z"></path>
            </svg>
          </div>
          <div class="pill-text">
            <strong>100+ Visual Presets</strong>
            <small>Fonts & 16M Colors</small>
          </div>
        </div>

        <div class="feature-pill">
          <div class="pill-icon-svg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="16.5" y1="9.4" x2="7.5" y2="4.21"></line>
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
          </div>
          <div class="pill-text">
            <strong>Pay on Delivery</strong>
            <small>Instant Digital Receipts</small>
          </div>
        </div>

        <div class="feature-pill">
          <div class="pill-icon-svg">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <div class="pill-text">
            <strong>IDE</strong>
            <small>Live Sandbox Preview</small>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .genesis-launcher-section {
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
  }

  .genesis-glow {
    position: absolute;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    filter: blur(140px);
    opacity: 0.12;
    pointer-events: none;
  }

  .cyan-glow {
    top: 20%;
    left: -200px;
    background: var(--accent-cyan);
  }

  .purple-glow {
    bottom: 10%;
    right: -200px;
    background: var(--accent-purple);
  }

  .section-header {
    text-align: center;
    max-width: 850px;
    margin: 0 auto 3.5rem;
  }

  .matrix-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: monospace;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--accent-cyan);
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid rgba(0, 240, 255, 0.25);
    padding: 0.35rem 0.9rem;
    border-radius: 20px;
    margin-bottom: 1.25rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.3); opacity: 1; }
  }

  .section-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .section-subtitle {
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 1.7;
    font-weight: 300;
  }

  /* Main Launch Card */
  .genesis-launch-card {
    max-width: 1050px;
    margin: 0 auto;
    padding: 3.5rem;
    border-radius: var(--radius-lg);
    background: rgba(8, 10, 18, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    position: relative;
    overflow: hidden;
  }

  .launch-hero-content {
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .launch-tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--accent-pink);
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .launch-title {
    font-size: clamp(1.8rem, 3.8vw, 2.75rem);
    font-weight: 800;
    margin-bottom: 1.25rem;
    line-height: 1.2;
  }

  .launch-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  /* 3-Step Roadmap Grid */
  .roadmap-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-bottom: 3rem;
    text-align: left;
  }

  .roadmap-step {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: all 0.3s ease;
  }

  .roadmap-step:hover {
    transform: translateY(-4px);
    border-color: rgba(0, 240, 255, 0.3);
    background: rgba(0, 240, 255, 0.04);
    box-shadow: 0 10px 30px rgba(0, 240, 255, 0.08);
  }

  .step-num {
    font-family: monospace;
    font-size: 1.5rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--accent-cyan), var(--accent-pink));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .step-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }

  .step-desc {
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  /* Launch Action Bar */
  .launch-action-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .btn-mega-launch {
    font-size: 1.15rem;
    font-weight: 800;
    padding: 1.1rem 2.75rem;
    border-radius: 16px;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    box-shadow: 0 10px 40px rgba(0, 240, 255, 0.35);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .btn-mega-launch:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 15px 50px rgba(0, 240, 255, 0.5);
  }

  .launch-guarantees {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .guarantee-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #10b981;
  }

  /* Feature Highlight Pills */
  .features-pill-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding-top: 2rem;
  }

  .feature-pill {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1.1rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .feature-pill:hover {
    border-color: rgba(0, 240, 255, 0.3);
    background: rgba(0, 240, 255, 0.03);
    transform: translateY(-2px);
  }

  .pill-icon-svg {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid rgba(0, 240, 255, 0.2);
    color: var(--accent-cyan);
    flex-shrink: 0;
  }

  .pill-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .pill-text strong {
    font-size: 0.88rem;
    color: #ffffff;
  }

  .pill-text small {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  @media (max-width: 992px) {
    .roadmap-grid {
      grid-template-columns: 1fr;
    }
    .features-pill-row {
      grid-template-columns: repeat(2, 1fr);
    }
    .genesis-launch-card {
      padding: 2.25rem 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .features-pill-row {
      grid-template-columns: 1fr;
    }
  }
</style>
