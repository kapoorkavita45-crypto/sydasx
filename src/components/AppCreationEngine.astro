  .controller-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: monospace;
  }

  .ctrl-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 800;
    color: #00f0ff;
  }

  .pulse-dot-cyan {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00f0ff;
    box-shadow: 0 0 8px #00f0ff;
    animation: pulse 1s infinite;
  }

  .ctrl-fps {
    font-size: 0.72rem;
    color: #00ff88;
    font-weight: 800;
  }

  .controller-pills-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .test-action-pill {
    padding: 0.45rem 0.85rem;
    border-radius: 8px;
    background: rgba(5, 7, 13, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #e2e8f0;
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
  }

  .test-action-pill:hover {
    border-color: #00f0ff;
    color: #00f0ff;
    background: rgba(0, 240, 255, 0.1);
  }

  .metrics-two-up-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .metric-card {
    padding: 1.5rem;
    border-radius: 16px;
    background: rgba(15, 20, 36, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .metric-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: monospace;
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .metric-box-title {
    font-family: monospace;
    font-size: 0.82rem;
    font-weight: 800;
    color: #e2e8f0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-transform: uppercase;
  }

  .metric-big-number {
    font-family: monospace;
    font-size: 1.8rem;
    font-weight: 900;
    color: #ffffff;
  }

  .text-green { color: #00ff88; }
  .text-cyan { color: #00f0ff; }
  .text-purple { color: #c084fc; }

  .metric-caption {
    font-size: 0.78rem;
    color: #64748b;
  }

  .tag-optimized {
    font-family: monospace;
    font-size: 0.68rem;
    font-weight: 800;
    color: #b026ff;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: rgba(176, 38, 255, 0.15);
    border: 1px solid rgba(176, 38, 255, 0.3);
  }

  .tech-pills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .stack-badge-pill {
    font-family: monospace;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    background: rgba(5, 7, 13, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #e2e8f0;
  }

  .compliance-metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    text-align: center;
    margin-top: 0.5rem;
  }

  .compliance-box {
    background: rgba(5, 7, 13, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 0.85rem;
  }

  .compliance-val {
    font-family: monospace;
    font-size: 1.15rem;
    font-weight: 900;
  }

  .compliance-lbl {
    font-family: monospace;
    font-size: 0.65rem;
    color: #64748b;
    margin-top: 0.2rem;
  }

  .consultation-cta-card {
    padding: 1.25rem 1.75rem;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(0, 240, 255, 0.08), rgba(5, 7, 13, 0.9));
    border: 1px solid rgba(0, 240, 255, 0.25);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cta-text-content {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .cta-text-content strong {
    font-size: 0.95rem;
    color: #ffffff;
  }

  .cta-text-content span {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .btn-consult-architect {
    padding: 0.65rem 1.25rem;
    border-radius: 8px;
    background: #ffffff;
    color: #05070d;
    font-family: monospace;
    font-size: 0.82rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .btn-consult-architect:hover {
    background: #00f0ff;
  }

  @keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  @media (max-width: 1100px) {
    .blueprint-dashboard-grid {
      grid-template-columns: 1fr;
    }
    .blueprint-phone-col {
      order: 1;
    }
  }

  @media (max-width: 768px) {
    .tech-options-grid,
    .sliders-split-grid,
    .metrics-two-up-row,
    .step-hud-grid {
      grid-template-columns: 1fr;
    }
    .floating-selection-bar {
      flex-direction: column;
      align-items: stretch;
    }
  }
