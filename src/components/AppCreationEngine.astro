    };

    window.pgTouchDown = function(isHeld) {
      if (!pixelGameState) return;
      pixelGameState.player.isDescending = isHeld;
      if (isHeld) pixelGameState.player.vy = Math.min(8, pixelGameState.player.vy + 3.0);
