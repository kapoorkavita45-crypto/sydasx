              💣 L-SHIFT
            </button>
            <button onclick="window.pgShootWeaponTouch()" style="padding: 8px 4px; background: linear-gradient(180deg, #ff4655, #b91c1c); color: #fff; font-weight: 900; font-size: 0.72rem; border: none; border-radius: 6px; cursor: pointer;">
              🔥 R-SHIFT
            </button>
          </div>

          <!-- FOOTER TIP WITH EXACT WASD CONTROLS -->
          <div style="display: flex; justify-content: space-between; padding: 4px 8px; background: #060911; font-size: 0.52rem; color: #64748b;">
            <span>W: Jetpack Up &bull; S: Down &bull; A: Back &bull; D: Forward &bull; L-Shift: Nade &bull; R-Shift / Click: Shoot &bull; Mouse: Target Aim</span>
            <span style="color: #00ff88;">30X VAST MAP &bull; 1v1 BOT DUEL &bull; SOLID FLOATING BRICKS</span>
          </div>

        </div>
      `;

      initPixelArcadeEngine();
    }

    function initPixelArcadeEngine() {
      const canvas = document.getElementById('pixel-game-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const W = canvas.width;
      const H = canvas.height;
      const WORLD_WIDTH = 6000; // 30X Map Scale (6000px length)

      // 5 FAMOUS HEROES SPECIFICATIONS
      const FAMOUS_CHARACTERS = [
        { id: 'john_wick', name: 'JOHN WICK', tag: 'The Baba Yaga', avatarText: 'JW', perk: '+20% Reload & Crit Accuracy', suitColor: '#111827', shirtColor: '#ffffff', tieColor: '#000000', hairColor: '#1f2937', skinColor: '#e0a899', hpMultiplier: 1.0, speed: 2.8, bulletDmgBoost: 1.2 },
        { id: 'master_chief', name: 'MASTER CHIEF', tag: 'Spartan-117 (Halo)', avatarText: 'MC', perk: '+50 Shield Energy Armor', suitColor: '#15803d', shirtColor: '#14532d', tieColor: '#eab308', hairColor: '#14532d', skinColor: '#eab308', hpMultiplier: 1.3, speed: 2.5, bulletDmgBoost: 1.15 },
        { id: 'kratos', name: 'KRATOS', tag: 'Ghost of Sparta', avatarText: 'KR', perk: 'Spartan Rage (+30% Damage)', suitColor: '#78350f', shirtColor: '#f1f5f9', tieColor: '#ef4444', hairColor: '#451a03', skinColor: '#f8fafc', hpMultiplier: 1.25, speed: 2.6, bulletDmgBoost: 1.35 },
        { id: 'terminator', name: 'TERMINATOR', tag: 'Cyberdyne T-800', avatarText: 'T8', perk: 'Titanium Endoskeleton (+40 HP)', suitColor: '#0f172a', shirtColor: '#475569', tieColor: '#ef4444', hairColor: '#334155', skinColor: '#94a3b8', hpMultiplier: 1.4, speed: 2.4, bulletDmgBoost: 1.2 },
        { id: 'neo', name: 'NEO (THE ONE)', tag: 'The Matrix', avatarText: 'NE', perk: 'Bullet Time (+30% Jetpack Nitro)', suitColor: '#030712', shirtColor: '#030712', tieColor: '#00f0ff', hairColor: '#111827', skinColor: '#e0a899', hpMultiplier: 1.05, speed: 3.0, bulletDmgBoost: 1.25 }
      ];

      // 5 WEAPON ARSENAL SPECIFICATIONS
      const WEAPON_TYPES = [
        { name: 'M4A1 RIFLE', ammo: 30, maxAmmo: 30, dmg: 24, rate: 100, spread: 0.06, speed: 11, color: '#ffc837', burst: 1 },
        { name: 'BARRETT SNIPER', ammo: 5, maxAmmo: 5, dmg: 110, rate: 650, spread: 0.005, speed: 19, color: '#00f0ff', burst: 1 },
        { name: 'SAWED SHOTGUN', ammo: 6, maxAmmo: 6, dmg: 18, rate: 450, spread: 0.22, speed: 9, color: '#ff4655', burst: 5 },
        { name: 'RPG ROCKET', ammo: 3, maxAmmo: 3, dmg: 140, rate: 800, spread: 0.02, speed: 7, color: '#00ff88', isExplosive: true, burst: 1 },
        { name: 'DUAL UZI', ammo: 40, maxAmmo: 40, dmg: 16, rate: 65, spread: 0.12, speed: 9.5, color: '#ff007a', burst: 1 }
      ];

      // GENERATE SOLID STEPPABLE FLOATING BRICK PLATFORMS ACROSS 6000m
      function generateSolidBrickPlatforms(groundY, style) {
        const plats = [{ x: 0, y: groundY, w: WORLD_WIDTH, h: 60, isGround: true }]; // Solid Continuous Base Ground
        
        // Multi-tier floating brick structures every 160px across the 6000m map
        for (let x = 120; x < WORLD_WIDTH - 200; x += 180) {
          const w = 130 + ((x * 13) % 90);
          const y = 220 + ((x * 7) % 80);
          plats.push({ x, y, w, h: 16, isBrick: true });
          
          // Higher floating brick perch (step on it)
          if ((x % 360) === 0) {
            plats.push({ x: x + 30, y: Math.max(90, y - 90), w: 100, h: 16, isBrick: true });
          }
        }
        return plats;
      }

      const DAYLIGHT_MAPS = [
        {
          id: 'outpost', name: 'OUTPOST 30X', sub: 'Desert Canyon (6000m)',
          skyTop: '#38bdf8', skyBottom: '#bae6fd', sunColor: '#fef08a', groundColor: '#d97706', grassColor: '#b45309', brickColor: '#b45309',
          platforms: generateSolidBrickPlatforms(370, 'desert')
        },
        {
          id: 'catacon', name: 'CATACON 30X', sub: 'Jungle Ruins (6000m)',
          skyTop: '#0284c7', skyBottom: '#7dd3fc', sunColor: '#fffbeb', groundColor: '#15803d', grassColor: '#4ade80', brickColor: '#1e3a24',
          platforms: generateSolidBrickPlatforms(370, 'jungle')
        },
        {
          id: 'suspension', name: 'SUSPENSION 30X', sub: 'Sky Bridges (6000m)',
          skyTop: '#0369a1', skyBottom: '#e0f2fe', sunColor: '#fde047', groundColor: '#475569', grassColor: '#94a3b8', brickColor: '#334155',
          platforms: generateSolidBrickPlatforms(370, 'sky')
        }
      ];

      // GLOBAL ENGINE STATE
      pixelGameState = {
        screen: 'intro',
        soundEnabled: true,
        worldWidth: WORLD_WIDTH,
        cameraX: 0,
        
        stageIndex: 1,
        score: 0,
        highScore: 0,
        totalKills: 0,
        credits: 1000,
        
        selectedCharIndex: 0,
        selectedWeaponIndex: 0,
        selectedMapIndex: 0,
        
        // PLAYER ENTITY (STARTS AT FAR LEFT END: x = 120)
        player: {
          x: 120,
          y: 330,
          prevY: 330,
          vx: 0,
          vy: 0,
          w: 16,
          h: 24,
          hp: 100,
          maxHp: 100,
          nitro: 100, // LIMITED JETPACK NITRO
          maxNitro: 100,
          isFlying: false,
          isDescending: false,
          isGrounded: true,
          facing: 1,
          grenades: 3,
          reloading: false,
          reloadTimer: 0
        },
        
        // EXACTLY 1 ACTIVE BOT AT A TIME (STARTS AT FAR RIGHT END: x = WORLD_WIDTH - 250)
        bot: null,
        
        aimX: 480,
        aimY: 200,
        
        bullets: [],
        grenadesList: [],
        particles: [],
        
        stageTargetKills: 5,
        stageCurrentKills: 0,
        lastFireTime: 0,
        frameCount: 0
      };

      // Populate Character UI Cards
      const charContainer = document.getElementById('pg-char-cards-container');
      if (charContainer) {
        charContainer.innerHTML = FAMOUS_CHARACTERS.map((c, idx) => `
          <div id="char-card-${idx}" onclick="window.pgSelectChar(${idx})" style="display: flex; align-items: center; justify-content: space-between; background: ${idx === 0 ? 'rgba(0, 240, 255, 0.15)' : '#162032'}; border: 1.5px solid ${idx === 0 ? '#00f0ff' : '#334155'}; border-radius: 6px; padding: 6px 10px; cursor: pointer; transition: all 0.2s ease;">
            <div style="display: flex; align-items: center; gap: 8px;">
              <div style="width: 26px; height: 26px; background: ${c.suitColor}; border: 1px solid #fff; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 0.62rem; font-weight: 900; color: ${c.tieColor};">${c.avatarText}</div>
              <div>
                <div style="font-size: 0.72rem; font-weight: 900; color: #fff;">${c.name}</div>
                <div style="font-size: 0.55rem; color: #00f0ff;">${c.tag}</div>
              </div>
            </div>
            <div style="text-align: right;">
              <div style="font-size: 0.52rem; color: #00ff88; font-weight: 800;">${c.perk}</div>
              <span id="char-badge-${idx}" style="font-size: 0.52rem; background: ${idx === 0 ? '#00f0ff' : 'transparent'}; color: ${idx === 0 ? '#05070d' : '#64748b'}; font-weight: 900; padding: 1px 5px; border-radius: 3px;">${idx === 0 ? 'ACTIVE' : 'SELECT'}</span>
            </div>
          </div>
        `).join('');
      }

      // Populate Weapon Options
      const wepContainer = document.getElementById('pg-wep-options-grid');
      if (wepContainer) {
        wepContainer.innerHTML = WEAPON_TYPES.map((w, idx) => `
          <div id="wep-card-${idx}" onclick="window.pgSelectWeapon(${idx})" style="background: ${idx === 0 ? 'rgba(0, 240, 255, 0.15)' : '#162032'}; border: 1.5px solid ${idx === 0 ? '#00f0ff' : '#334155'}; border-radius: 6px; padding: 6px; cursor: pointer; text-align: center;">
            <div style="font-size: 0.65rem; font-weight: 900; color: #fff;">${w.name}</div>
            <div style="font-size: 0.52rem; color: #00ff88;">DMG: ${w.dmg} &bull; MAG: ${w.ammo}</div>
          </div>
        `).join('');
      }

      // Populate Map Options (30X Daylight Maps)
      const mapContainer = document.getElementById('pg-map-options-grid');
      if (mapContainer) {
        mapContainer.innerHTML = DAYLIGHT_MAPS.map((m, idx) => `
          <div id="map-card-${idx}" onclick="window.pgSelectMap(${idx})" style="background: ${idx === 0 ? 'rgba(0, 255, 136, 0.15)' : '#162032'}; border: 1.5px solid ${idx === 0 ? '#00f0ff' : '#334155'}; border-radius: 6px; padding: 5px; cursor: pointer; text-align: center;">
            <div style="font-size: 0.62rem; font-weight: 900; color: #fff;">${m.name}</div>
            <div style="font-size: 0.48rem; color: #94a3b8;">${m.sub}</div>
          </div>
        `).join('');
      }

      // Skip intro after 2.2s
      setTimeout(() => {
        window.pgSkipIntro();
      }, 2200);

      // Keyboard Controls (WASD, L-Shift, R-Shift, Mouse Aim)
      const handleKeyDown = (e) => {
        if (!document.getElementById('pixel-game-canvas')) {
          window.removeEventListener('keydown', handleKeyDown);
          window.removeEventListener('keyup', handleKeyUp);
          return;
        }
        const key = e.key.toLowerCase();
        const code = e.code;

        // D: Move Forward (Right)
        if (key === 'd' || key === 'arrowright') {
          pixelGameState.player.vx = pixelGameState.player.speed;
        }
        // A: Move Backwards (Left)
        if (key === 'a' || key === 'arrowleft') {
          pixelGameState.player.vx = -pixelGameState.player.speed;
        }
        // W: Move UP and use Jetpack (Limited Nitro)
        if (key === 'w' || key === 'arrowup' || key === ' ') {
          pixelGameState.player.isFlying = true;
        }
        // S: Move DOWN (Drop down from platforms)
        if (key === 's' || key === 'arrowdown') {
          pixelGameState.player.isDescending = true;
          pixelGameState.player.vy = Math.min(8, pixelGameState.player.vy + 3.0);
        }
        // Left Shift: Throw Grenade
        if (code === 'ShiftLeft' || (e.shiftKey && e.location === 1)) {
          e.preventDefault();
          window.pgThrowGrenade();
        }
        // Right Shift: Shoot Weapon
        if (code === 'ShiftRight' || (e.shiftKey && e.location === 2)) {
          e.preventDefault();
          pgShootWeapon();
        }
        if (key === 'r') window.pgReloadWeapon();
        if (key === 'g') window.pgThrowGrenade();
      };

      const handleKeyUp = (e) => {
        const key = e.key.toLowerCase();
        if ((key === 'd' || key === 'arrowright') && pixelGameState.player.vx > 0) pixelGameState.player.vx = 0;
        if ((key === 'a' || key === 'arrowleft') && pixelGameState.player.vx < 0) pixelGameState.player.vx = 0;
        if (key === 'w' || key === 'arrowup' || key === ' ') pixelGameState.player.isFlying = false;
        if (key === 's' || key === 'arrowdown') pixelGameState.player.isDescending = false;
      };
      window.addEventListener('keydown', handleKeyDown);
      window.addEventListener('keyup', handleKeyUp);

      // Mouse / Touch Aim & Shoot
      canvas.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        pixelGameState.aimX = (e.clientX - rect.left) * (W / rect.width);
        pixelGameState.aimY = (e.clientY - rect.top) * (H / rect.height);
      });
      canvas.addEventListener('mousedown', (e) => {
        if (pixelGameState.screen === 'game') pgShootWeapon();
      });
      canvas.addEventListener('touchmove', (e) => {
        e.preventDefault();
        const rect = canvas.getBoundingClientRect();
        const touch = e.touches[0];
        pixelGameState.aimX = (touch.clientX - rect.left) * (W / rect.width);
        pixelGameState.aimY = (touch.clientY - rect.top) * (H / rect.height);
      }, { passive: false });
      canvas.addEventListener('touchstart', (e) => {
        if (pixelGameState.screen === 'game') {
          e.preventDefault();
          const rect = canvas.getBoundingClientRect();
          const touch = e.touches[0];
          pixelGameState.aimX = (touch.clientX - rect.left) * (W / rect.width);
          pixelGameState.aimY = (touch.clientY - rect.top) * (H / rect.height);
          pgShootWeapon();
        }
      }, { passive: false });

      // MAIN ANIMATION LOOP
      function pixelGameLoop() {
        if (!document.getElementById('pixel-game-canvas')) return;
        pixelGameState.frameCount++;
        
        if (pixelGameState.screen === 'game' || pixelGameState.screen === 'menu') {
          updatePixelGame(W, H, WORLD_WIDTH);
        }
        drawPixelGame(ctx, W, H, WORLD_WIDTH);

        requestAnimationFrame(pixelGameLoop);
      }
      pixelGameLoop();
    }

    // ═══ SCREEN NAVIGATION ═══
    window.pgSkipIntro = function() {
      const intro = document.getElementById('pg-intro-screen');
      const menu = document.getElementById('pg-menu-screen');
      if (intro) intro.style.display = 'none';
      if (menu) menu.style.display = 'flex';
      if (pixelGameState) pixelGameState.screen = 'menu';
      window.playMatrixChime();
    };

    window.pgBackToMenu = function() {
      document.getElementById('pg-char-screen').style.display = 'none';
      document.getElementById('pg-wep-screen').style.display = 'none';
      document.getElementById('pg-settings-screen').style.display = 'none';
      document.getElementById('pg-gameover-screen').style.display = 'none';
      document.getElementById('pg-menu-screen').style.display = 'flex';
      if (pixelGameState) pixelGameState.screen = 'menu';
      window.playMatrixChime();
    };

    window.pgOpenCharSelect = function() {
      document.getElementById('pg-menu-screen').style.display = 'none';
      document.getElementById('pg-char-screen').style.display = 'flex';
      if (pixelGameState) pixelGameState.screen = 'char';
      window.playMatrixChime();
    };

    window.pgSelectChar = function(idx) {
      if (!pixelGameState) return;
      pixelGameState.selectedCharIndex = idx;
      for (let i = 0; i < 5; i++) {
        const card = document.getElementById(`char-card-${i}`);
        const badge = document.getElementById(`char-badge-${i}`);
        if (card && badge) {
          if (i === idx) {
            card.style.background = 'rgba(0, 240, 255, 0.15)';
            card.style.borderColor = '#00f0ff';
            badge.style.background = '#00f0ff';
            badge.style.color = '#05070d';
            badge.textContent = 'ACTIVE';
          } else {
            card.style.background = '#162032';
            card.style.borderColor = '#334155';
            badge.style.background = 'transparent';
            badge.style.color = '#64748b';
            badge.textContent = 'SELECT';
          }
        }
      }
      window.playMatrixChime();
    };

    window.pgOpenWeaponSelect = function() {
      document.getElementById('pg-char-screen').style.display = 'none';
      document.getElementById('pg-wep-screen').style.display = 'flex';
      if (pixelGameState) pixelGameState.screen = 'wep';
      window.playMatrixChime();
    };

    window.pgSelectWeapon = function(idx) {
      if (!pixelGameState) return;
      pixelGameState.selectedWeaponIndex = idx;
      for (let i = 0; i < 5; i++) {
        const card = document.getElementById(`wep-card-${i}`);
        if (card) {
          card.style.background = i === idx ? 'rgba(0, 240, 255, 0.15)' : '#162032';
          card.style.borderColor = i === idx ? '#00f0ff' : '#334155';
        }
      }
      window.playMatrixChime();
    };

    window.pgSelectMap = function(idx) {
      if (!pixelGameState) return;
      pixelGameState.selectedMapIndex = idx;
      for (let i = 0; i < 3; i++) {
        const card = document.getElementById(`map-card-${i}`);
        if (card) {
          card.style.background = i === idx ? 'rgba(0, 255, 136, 0.15)' : '#162032';
          card.style.borderColor = i === idx ? '#00ff88' : '#334155';
        }
      }
      window.playMatrixChime();
    };

    window.pgOpenSettings = function() {
      document.getElementById('pg-menu-screen').style.display = 'none';
      document.getElementById('pg-settings-screen').style.display = 'flex';
      if (pixelGameState) pixelGameState.screen = 'settings';
      window.playMatrixChime();
    };

    window.pgToggleSound = function(btn) {
      if (!pixelGameState) return;
      pixelGameState.soundEnabled = !pixelGameState.soundEnabled;
      btn.textContent = pixelGameState.soundEnabled ? 'ON' : 'OFF';
      btn.style.background = pixelGameState.soundEnabled ? '#00ff88' : '#64748b';
