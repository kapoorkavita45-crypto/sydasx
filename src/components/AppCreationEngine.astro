            <p style="font-size: 0.78rem; color: #cbd5e1; line-height: 1.45;">
              Explore the global neural ecosystem for <strong>${State.appName}</strong>. All remote nodes synced.
            </p>
          </div>
        `;
      } else if (tabName === 'action') {
        bodyEl.innerHTML = `
          <div class="live-action-card">
            <div class="live-card-header"><span>QUICK ACTIONS</span><span>TRIGGER</span></div>
            <button onclick="alert('High-priority vector action executed!')" style="padding: 0.65rem; background: #00f0ff; color: #05070d; font-weight: 800; font-family: monospace; border: none; border-radius: 8px; cursor: pointer;">EXECUTE VECTOR</button>
