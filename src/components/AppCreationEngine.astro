    window.pgShootWeaponTouch = function() {
      pgShootWeapon();
    };

    window.pgReloadWeapon = function() {
      if (!pixelGameState || pixelGameState.player.reloading) return;
      const wep = getSelectedWeapon();
      pixelGameState.player.reloading = true;
      pixelGameState.player.reloadTimer = 45;
      const ammoEl = document.getElementById('hud-ammo-cur');
      if (ammoEl) ammoEl.textContent = '...';
      window.playMatrixChime();
    };

    window.pgThrowGrenade = function() {
      if (!pixelGameState || pixelGameState.player.grenades <= 0 || pixelGameState.screen !== 'game') return;
      pixelGameState.player.grenades--;
      const p = pixelGameState.player;
      const worldAimX = pixelGameState.aimX + pixelGameState.cameraX;
      const angle = Math.atan2(pixelGameState.aimY - p.y, worldAimX - p.x);
      
      pixelGameState.grenadesList.push({
        x: p.x + 8,
        y: p.y,
        vx: Math.cos(angle) * 7.5,
        vy: Math.sin(angle) * 7.5 - 2,
        timer: 70
      });
      window.playMatrixChime();
    };

    function pgShootWeapon() {
      if (!pixelGameState || pixelGameState.player.reloading || pixelGameState.screen !== 'game') return;
      const wep = getSelectedWeapon();
      const char = getSelectedChar();
      const now = pixelGameState.frameCount;

      if (now - pixelGameState.lastFireTime < Math.floor(wep.rate / 16.67)) return;
      pixelGameState.lastFireTime = now;

      const p = pixelGameState.player;
      const worldAimX = pixelGameState.aimX + pixelGameState.cameraX;
      const baseAngle = Math.atan2(pixelGameState.aimY - (p.y + 10), worldAimX - (p.x + 8));

      for (let b = 0; b < wep.burst; b++) {
        const spread = (Math.random() - 0.5) * wep.spread * 2;
        const angle = baseAngle + spread;
        pixelGameState.bullets.push({
          x: p.x + 8,
          y: p.y + 10,
          vx: Math.cos(angle) * wep.speed,
          vy: Math.sin(angle) * wep.speed,
          dmg: wep.dmg * char.dmgBoost,
          color: wep.color,
          isExplosive: wep.isExplosive || false,
          isPlayer: true,
          life: 90
        });
      }

      for (let i = 0; i < 3; i++) {
        pixelGameState.particles.push({
          x: p.x + 8,
          y: p.y + 10,
          vx: Math.cos(baseAngle) * 4 + (Math.random() - 0.5) * 2,
          vy: Math.sin(baseAngle) * 4 + (Math.random() - 0.5) * 2,
          color: '#ffc837',
          size: 2.5,
          life: 8, maxLife: 8
        });
      }

      window.playMatrixChime();
    }

    // ═══ 30X WORLD PHYSICS, CAMERA & AI UPDATE ═══
    function updatePixelGame(W, H, WORLD_WIDTH) {
      if (!pixelGameState) return;
      const p = pixelGameState.player;
      const bot = pixelGameState.bot;
      const map = getSelectedMap();

      p.prevY = p.y;

      // 1. Player Jetpack Flight & Limited Nitro System
      if (p.isFlying && p.nitro > 0) {
        p.vy = -3.5;
        p.nitro = Math.max(0, p.nitro - 0.8); // Drains limited nitro
        if (pixelGameState.frameCount % 2 === 0) {
          pixelGameState.particles.push({
            x: p.x + (p.facing === 1 ? 2 : 14),
            y: p.y + 20,
            vx: (Math.random() - 0.5) * 1.5,
            vy: 2 + Math.random() * 2,
            color: Math.random() > 0.5 ? '#00f0ff' : '#ffc837',
            size: 3,
            life: 10, maxLife: 10
          });
        }
      } else {
        p.vy = Math.min(6.5, p.vy + 0.28);
      }

      p.x += p.vx;
      p.y += p.vy;

      // STRICT SCREEN BOUNDS CLAMP FOR PLAYER (NO LEAVING SCREEN/MAP)
      if (p.x < 15) p.x = 15;
      if (p.x > WORLD_WIDTH - p.w - 15) p.x = WORLD_WIDTH - p.w - 15;
      if (p.y < 16) {
        p.y = 16;
        p.vy = Math.max(0, p.vy); // Ceiling hit
      }

      // STEP ON FLOATING BRICK PLATFORMS & GROUND COLLISION
      p.isGrounded = false;
      
      // Check ground level (y = 370)
      if (p.y + p.h >= 370 && p.vy >= 0) {
        p.y = 370 - p.h;
        p.vy = 0;
        p.isGrounded = true;
      }

      // Check all solid floating brick platforms to step on
      for (let platX = 120; platX < WORLD_WIDTH - 200; platX += 180) {
        const platW = 130 + ((platX * 13) % 90);
        const platY = 220 + ((platX * 7) % 80);
        
        // Tier 1 Brick Platform
        if (!p.isDescending && p.vy >= 0 && p.prevY + p.h <= platY + 6 && p.y + p.h >= platY && p.y + p.h <= platY + 16) {
          if (p.x + p.w > platX && p.x < platX + platW) {
            p.y = platY - p.h;
            p.vy = 0;
            p.isGrounded = true;
          }
        }

        // Tier 2 High Brick Perch
        if ((platX % 360) === 0) {
          const p2X = platX + 30;
          const p2Y = Math.max(90, platY - 90);
          const p2W = 100;
          if (!p.isDescending && p.vy >= 0 && p.prevY + p.h <= p2Y + 6 && p.y + p.h >= p2Y && p.y + p.h <= p2Y + 16) {
            if (p.x + p.w > p2X && p.x < p2X + p2W) {
              p.y = p2Y - p.h;
              p.vy = 0;
              p.isGrounded = true;
            }
          }
        }
      }

      // Nitro only recharges when standing on a platform or ground!
      if (p.isGrounded) {
        p.nitro = Math.min(100, p.nitro + 0.6);
      }

      // Smooth Camera Tracking (Centers on Player)
      const targetCamX = p.x - W / 2;
      pixelGameState.cameraX += (targetCamX - pixelGameState.cameraX) * 0.15;
      if (pixelGameState.cameraX < 0) pixelGameState.cameraX = 0;
      if (pixelGameState.cameraX > WORLD_WIDTH - W) pixelGameState.cameraX = WORLD_WIDTH - W;

      const worldAimX = pixelGameState.aimX + pixelGameState.cameraX;
      p.facing = worldAimX >= p.x + p.w / 2 ? 1 : -1;

      // Update HUD Bars
      const hpBar = document.getElementById('hud-hp-bar');
      const hpVal = document.getElementById('hud-hp-val');
      const nitroBar = document.getElementById('hud-nitro-bar');
      if (hpBar) hpBar.style.width = `${Math.max(0, (p.hp / p.maxHp) * 100)}%`;
      if (hpVal) hpVal.textContent = Math.max(0, Math.floor(p.hp));
      if (nitroBar) nitroBar.style.width = `${p.nitro}%`;

      // Update Radar Overview
      const pDot = document.getElementById('radar-player-dot');
      const bDot = document.getElementById('radar-bot-dot');
      const distText = document.getElementById('hud-bot-distance');

      if (pDot) pDot.style.left = `${Math.min(98, Math.max(2, (p.x / WORLD_WIDTH) * 100))}%`;
      
      if (bot) {
        if (bDot) {
          bDot.style.display = 'block';
          bDot.style.left = `${Math.min(98, Math.max(2, (bot.x / WORLD_WIDTH) * 100))}%`;
        }
        const dist = Math.abs(Math.floor(bot.x - p.x));
        const dirArrow = bot.x > p.x ? '▶' : '◀';
        if (distText) distText.textContent = `DISTANCE: ${dist}m ${dirArrow}`;
      } else {
        if (bDot) bDot.style.display = 'none';
        if (distText) distText.textContent = 'DUEL OPPONENT ELIMINATED! 🏆';
      }

      // 2. SINGLE ENEMY BOT AI & NAVIGATION (LIMITED JETPACK & BOUNDARY ENFORCED)
      if (bot) {
        bot.prevY = bot.y;
        const distToPlayer = p.x - bot.x;
        const absDist = Math.abs(distToPlayer);

        // Move towards player
        bot.vx = Math.sign(distToPlayer) * (absDist > 300 ? 2.2 : 1.2);
        
        // Limited Jetpack AI: Flies when needed, but stops when nitro empty!
        bot.flyTimer++;
        if (bot.flyTimer > 80) {
          bot.flyTimer = 0;
          bot.isFlying = (Math.random() > 0.45) && (bot.nitro > 25);
        }

        if (bot.isFlying && bot.nitro > 0) {
          bot.vy = -3.0;
          bot.nitro = Math.max(0, bot.nitro - 0.85); // Drains bot nitro
          if (pixelGameState.frameCount % 3 === 0) {
            pixelGameState.particles.push({
              x: bot.x + 8, y: bot.y + 22, vx: (Math.random() - 0.5), vy: 2, color: '#ff4655', size: 2.5, life: 8, maxLife: 8
            });
          }
        } else {
          bot.isFlying = false;
          bot.vy = Math.min(6.0, bot.vy + 0.28);
        }

        bot.x += bot.vx;
        bot.y += bot.vy;

        // STRICT SCREEN BOUNDS CLAMP FOR BOT (NO LEAVING SCREEN/MAP)
        if (bot.x < 15) bot.x = 15;
        if (bot.x > WORLD_WIDTH - bot.w - 15) bot.x = WORLD_WIDTH - bot.w - 15;
        if (bot.y < 16) {
          bot.y = 16;
          bot.vy = Math.max(0, bot.vy);
          bot.isFlying = false;
        }

        // STEP ON FLOATING BRICK PLATFORMS (BOT)
        bot.isGrounded = false;
        if (bot.y + bot.h >= 370 && bot.vy >= 0) {
          bot.y = 370 - bot.h;
          bot.vy = 0;
          bot.isGrounded = true;
        }

        for (let platX = 120; platX < WORLD_WIDTH - 200; platX += 180) {
          const platW = 130 + ((platX * 13) % 90);
          const platY = 220 + ((platX * 7) % 80);
          
          if (bot.vy >= 0 && bot.prevY + bot.h <= platY + 6 && bot.y + bot.h >= platY && bot.y + bot.h <= platY + 16) {
            if (bot.x + bot.w > platX && bot.x < platX + platW) {
              bot.y = platY - bot.h;
              bot.vy = 0;
              bot.isGrounded = true;
            }
          }
          if ((platX % 360) === 0) {
            const p2X = platX + 30;
            const p2Y = Math.max(90, platY - 90);
            const p2W = 100;
            if (bot.vy >= 0 && bot.prevY + bot.h <= p2Y + 6 && bot.y + bot.h >= p2Y && bot.y + bot.h <= p2Y + 16) {
              if (bot.x + bot.w > p2X && bot.x < p2X + p2W) {
                bot.y = p2Y - bot.h;
                bot.vy = 0;
                bot.isGrounded = true;
              }
            }
          }
        }

        // Bot Nitro recharges only on ground or platform
        if (bot.isGrounded) {
          bot.nitro = Math.min(100, bot.nitro + 0.6);
        }

        bot.facing = Math.sign(distToPlayer);

        // Bot shoots when in combat range (< 500px)
        if (absDist < 520 && pixelGameState.screen === 'game') {
          bot.shootTimer++;
          if (bot.shootTimer >= bot.shootCooldown) {
            bot.shootTimer = 0;
            const bAngle = Math.atan2(p.y - bot.y, p.x - bot.x);
            pixelGameState.bullets.push({
              x: bot.x + 8,
              y: bot.y + 10,
              vx: Math.cos(bAngle) * 7.5,
              vy: Math.sin(bAngle) * 7.5,
              dmg: 14 + pixelGameState.stageIndex * 3,
              color: '#ff4655',
              isPlayer: false,
              life: 80
            });
          }
        }
      }

      // 3. BULLETS PHYSICS & SOLID WALL / BRICK PLATFORM COLLISION
      for (let i = pixelGameState.bullets.length - 1; i >= 0; i--) {
        const b = pixelGameState.bullets[i];
        b.x += b.vx;
        b.y += b.vy;
        b.life--;

        // SOLID FLOATING BRICK / WALL COLLISION: BULLETS CANNOT PASS THROUGH WALLS
        if (b.y >= 370) {
          spawnSparks(b.x, b.y, '#d97706', 4);
          b.life = 0;
        } else {
          for (let platX = 120; platX < WORLD_WIDTH - 200; platX += 180) {
            const platW = 130 + ((platX * 13) % 90);
            const platY = 220 + ((platX * 7) % 80);
            
            // Check collision with Tier 1 Platform
            if (b.x >= platX && b.x <= platX + platW && b.y >= platY && b.y <= platY + 16) {
              spawnSparks(b.x, b.y, '#b45309', 4);
              b.life = 0;
              break;
            }

            // Check collision with Tier 2 Platform
            if ((platX % 360) === 0) {
              const p2X = platX + 30;
              const p2Y = Math.max(90, platY - 90);
              const p2W = 100;
              if (b.x >= p2X && b.x <= p2X + p2W && b.y >= p2Y && b.y <= p2Y + 16) {
                spawnSparks(b.x, b.y, '#b45309', 4);
                b.life = 0;
                break;
              }
            }
          }
        }

        // Player bullet hits the 1 bot
        if (b.life > 0 && b.isPlayer && bot) {
          if (b.x > bot.x && b.x < bot.x + bot.w && b.y > bot.y && b.y < bot.y + bot.h) {
            bot.hp -= b.dmg;
            spawnDamagePopup(b.x - pixelGameState.cameraX, b.y, `-${Math.floor(b.dmg)}`, '#ffc837');
            spawnSparks(b.x, b.y, b.color, 8);
            b.life = 0;

            if (bot.hp <= 0) {
              handleSingleBotEliminated();
            }
          }
        } else if (b.life > 0 && !b.isPlayer) {
          // Bot bullet hits player
          if (b.x > p.x && b.x < p.x + p.w && b.y > p.y && b.y < p.y + p.h) {
            p.hp -= b.dmg;
            spawnDamagePopup(b.x - pixelGameState.cameraX, b.y, `-${Math.floor(b.dmg)}`, '#ff4655');
            spawnSparks(b.x, b.y, '#ff4655', 8);
            b.life = 0;

            if (p.hp <= 0) triggerGameOver(false);
          }
        }

        if (b.life <= 0 || b.x < 0 || b.x > WORLD_WIDTH || b.y < 0 || b.y > 450) {
          pixelGameState.bullets.splice(i, 1);
        }
      }

      // 4. Grenades Physics & Wall Bounce
      for (let i = pixelGameState.grenadesList.length - 1; i >= 0; i--) {
        const g = pixelGameState.grenadesList[i];
        g.x += g.vx;
        g.y += g.vy;
        g.vy += 0.28;
        g.vx *= 0.98;

        if (g.y >= 365) {
          g.y = 365;
          g.vy = -g.vy * 0.55;
        }

        g.timer--;
        if (g.timer <= 0) {
          detonateFragGrenade(g.x, g.y);
          pixelGameState.grenadesList.splice(i, 1);
        }
      }

      // 5. Particles Update
      for (let i = pixelGameState.particles.length - 1; i >= 0; i--) {
        const pt = pixelGameState.particles[i];
        pt.x += pt.vx;
        pt.y += pt.vy;
        pt.life--;
        if (pt.life <= 0) pixelGameState.particles.splice(i, 1);
      }
    }

    function handleSingleBotEliminated() {
      const bot = pixelGameState.bot;
      if (!bot) return;

      pixelGameState.totalKills++;
      pixelGameState.stageCurrentKills++;
      pixelGameState.score += 500;

      const killEl = document.getElementById('hud-target-kills');
      if (killEl) killEl.textContent = pixelGameState.stageCurrentKills;

      spawnSparks(bot.x + 8, bot.y + 12, '#ff4655', 30);
      spawnSparks(bot.x + 8, bot.y + 12, '#ffc837', 25);
      showToast(`${bot.name} ELIMINATED! (+500 PTS) 💀`);

      pixelGameState.bot = null;

      // Check Stage Target Clear
      if (pixelGameState.stageCurrentKills >= pixelGameState.stageTargetKills) {
        setTimeout(() => {
          triggerGameOver(true);
        }, 800);
      } else {
        // Spawn next 1v1 Bot opponent at the opposite side relative to player
        setTimeout(() => {
          if (!pixelGameState || pixelGameState.screen !== 'game') return;
          const p = pixelGameState.player;
          const spawnX = p.x < pixelGameState.worldWidth / 2 
            ? pixelGameState.worldWidth - 250 
            : 150;
          spawnSingle1v1Bot(spawnX);
          showToast('NEW DUEL OPPONENT SPAWNED AT FAR BASE! ⚔️');
          window.playMatrixChime();
        }, 1500);
      }
    }

    function detonateFragGrenade(x, y) {
      const flare = document.getElementById('pixel-blast-flare');
      if (flare) {
        flare.style.opacity = '1';
        setTimeout(() => { if (flare) flare.style.opacity = '0'; }, 120);
      }
      spawnSparks(x, y, '#ffc837', 35);
      spawnSparks(x, y, '#ff4655', 30);

      const bot = pixelGameState.bot;
      if (bot) {
        const dist = Math.hypot(bot.x + 8 - x, bot.y + 12 - y);
        if (dist < 80) {
          const dmg = Math.floor(120 * (1 - dist / 80));
          bot.hp -= dmg;
          spawnDamagePopup(bot.x - pixelGameState.cameraX, bot.y, `-${dmg} BLAST`, '#ff007a');
          if (bot.hp <= 0) handleSingleBotEliminated();
        }
      }
    }

    function triggerGameOver(isWin) {
      const goScreen = document.getElementById('pg-gameover-screen');
      const goTitle = document.getElementById('go-title');
      const goSub = document.getElementById('go-subtitle');
      const btnNext = document.getElementById('btn-next-stage');
      const kStat = document.getElementById('go-stat-kills');
      const sStat = document.getElementById('go-stat-score');
      const nStat = document.getElementById('go-stat-next');

      if (!goScreen) return;
      goScreen.style.display = 'flex';
      pixelGameState.screen = 'gameover';

      if (isWin) {
        goTitle.textContent = '30X STAGE CLEAR! 🏆';
        goTitle.style.color = '#00ff88';
        goSub.textContent = `ALL 1v1 DUEL OPPONENTS DEFEATED IN STAGE ${pixelGameState.stageIndex}`;
        if (btnNext) btnNext.style.display = 'block';
        if (nStat) nStat.textContent = `STAGE ${pixelGameState.stageIndex + 1}`;
      } else {
        goTitle.textContent = 'FALLEN IN ACTION 💀';
        goTitle.style.color = '#ff4655';
        goSub.textContent = 'HERO ELIMINATED IN 1v1 DUEL';
        if (btnNext) btnNext.style.display = 'none';
        if (nStat) nStat.textContent = 'RETRY DUEL';
      }

      if (kStat) kStat.textContent = pixelGameState.stageCurrentKills;
      if (sStat) sStat.textContent = pixelGameState.score;
      window.playMatrixChime();
    }

    function spawnDamagePopup(x, y, text, color) {
      const layer = document.getElementById('pixel-damage-layer');
      if (!layer) return;
      const el = document.createElement('div');
      el.style.cssText = `
        position: absolute;
        left: ${x}px;
        top: ${y}px;
        color: ${color};
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        font-weight: 900;
        text-shadow: 1px 1px 0 #000, 0 0 6px ${color};
        pointer-events: none;
        transform: translate(-50%, -50%);
        transition: all 0.55s cubic-bezier(0.25, 1, 0.5, 1);
        opacity: 1;
      `;
      el.textContent = text;
      layer.appendChild(el);
      requestAnimationFrame(() => {
        el.style.top = `${y - 25}px`;
        el.style.opacity = '0';
      });
      setTimeout(() => { if (el.parentNode) el.parentNode.removeChild(el); }, 580);
    }

    function spawnSparks(x, y, color, count) {
      for (let i = 0; i < count; i++) {
        pixelGameState.particles.push({
          x, y,
          vx: (Math.random() - 0.5) * 7,
          vy: (Math.random() - 0.5) * 7 - 1,
          color,
          size: 2 + Math.random() * 2.5,
          life: 14 + Math.random() * 8,
          maxLife: 22
        });
      }
    }

    // ═══ HIGH-RES PIXEL ART RENDERER WITH SOLID FLOATING BRICKS ═══
    function drawPixelGame(ctx, W, H, WORLD_WIDTH) {
      if (!pixelGameState) return;
      const map = getSelectedMap();
      const camX = pixelGameState.cameraX || 0;

      // 1. SKYBOX & PARALLAX SUN & MOUNTAINS
      const skyGrad = ctx.createLinearGradient(0, 0, 0, H);
      skyGrad.addColorStop(0, map.skyTop);
      skyGrad.addColorStop(1, map.skyBottom);
      ctx.fillStyle = skyGrad;
      ctx.fillRect(0, 0, W, H);

      // Parallax Daylight Sun
      const sunScreenX = 750 - (camX * 0.05);
      ctx.fillStyle = '#fffbeb';
      ctx.beginPath(); ctx.arc(sunScreenX, 55, 20, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = 'rgba(254, 240, 138, 0.35)';
      ctx.beginPath(); ctx.arc(sunScreenX, 55, 30, 0, Math.PI * 2); ctx.fill();

      // Parallax Distant Mountains
      ctx.fillStyle = 'rgba(15, 23, 42, 0.25)';
      for (let m = 0; m < WORLD_WIDTH; m += 400) {
        const mx = m - (camX * 0.2);
        if (mx > -400 && mx < W + 400) {
          ctx.beginPath();
          ctx.moveTo(mx, 370);
          ctx.lineTo(mx + 200, 180);
          ctx.lineTo(mx + 400, 370);
          ctx.closePath();
          ctx.fill();
        }
      }

      // 2. WORLD SPACE RENDERING (APPLY CAMERA OFFSET)
      ctx.save();
      ctx.translate(-camX, 0);

      // Continuous 6000m Ground
      ctx.fillStyle = map.grassColor;
      ctx.fillRect(0, 370, WORLD_WIDTH, 6);
      ctx.fillStyle = map.groundColor;
      ctx.fillRect(0, 376, WORLD_WIDTH, 80);

      // Render Solid Floating Brick Platforms
      for (let platX = 120; platX < WORLD_WIDTH - 200; platX += 180) {
        if (platX > camX - 300 && platX < camX + W + 300) {
          const platW = 130 + ((platX * 13) % 90);
          const platY = 220 + ((platX * 7) % 80);
          
          drawSolidBrickPlatform(ctx, platX, platY, platW, 16, map.grassColor, map.groundColor);

          // Tier 2 High Brick Perch
          if ((platX % 360) === 0) {
            const p2X = platX + 30;
            const p2Y = Math.max(90, platY - 90);
            drawSolidBrickPlatform(ctx, p2X, p2Y, 100, 16, '#00f0ff', map.groundColor);
          }
        }
      }

      // Render Frag Grenades
      pixelGameState.grenadesList.forEach(g => {
        ctx.fillStyle = '#15803d'; ctx.fillRect(g.x - 3, g.y - 3, 6, 6);
        ctx.fillStyle = '#ef4444'; ctx.fillRect(g.x - 1, g.y - 4, 2, 2);
      });

      // Render the 1 Single Enemy Bot Duelist
      const bot = pixelGameState.bot;
      if (bot) {
        drawPixelBot(ctx, bot.x, bot.y, bot.w, bot.h, bot.hp, bot.maxHp, bot.name, bot.nitro);
      }

      // Render Hero Player (At starting base x = 120)
      if (pixelGameState.screen === 'game' || pixelGameState.screen === 'menu') {
        const p = pixelGameState.player;
        const char = getSelectedChar();
        drawPixelHero(ctx, p.x, p.y, p.w, p.h, char, p.facing);
      }

      // Render Bullets
      pixelGameState.bullets.forEach(b => {
        ctx.fillStyle = b.color;
        ctx.fillRect(b.x - 2, b.y - 2, 4, 4);
      });

      // Render Particles
      pixelGameState.particles.forEach(pt => {
        ctx.globalAlpha = pt.life / pt.maxLife;
        ctx.fillStyle = pt.color;
        ctx.fillRect(pt.x - pt.size / 2, pt.y - pt.size / 2, pt.size, pt.size);
      });
      ctx.globalAlpha = 1;

      ctx.restore(); // END WORLD SPACE

      // 3. SCREEN SPACE AIM CROSSHAIR
      if (pixelGameState.screen === 'game') {
        const cx = pixelGameState.aimX;
        const cy = pixelGameState.aimY;
        ctx.strokeStyle = '#00f0ff';
        ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.arc(cx, cy, 6, 0, Math.PI * 2); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(cx - 9, cy); ctx.lineTo(cx + 9, cy);
        ctx.moveTo(cx, cy - 9); ctx.lineTo(cx, cy + 9); ctx.stroke();
      }
    }

    // High-Res Solid Brick Platform Texture
    function drawSolidBrickPlatform(ctx, x, y, w, h, topColor, bodyColor) {
      // Grass / Trim top
      ctx.fillStyle = topColor;
      ctx.fillRect(x, y, w, 4);

      // Brick body
      ctx.fillStyle = bodyColor;
      ctx.fillRect(x, y + 4, w, h - 4);

      // Brick mortar lines
      ctx.fillStyle = 'rgba(0,0,0,0.3)';
      for (let bx = x; bx < x + w; bx += 20) {
        ctx.fillRect(bx, y + 4, 1.5, h - 4);
      }
      ctx.fillRect(x, y + (h / 2), w, 1.5);
    }

    // High-Res Bot Sprite
    function drawPixelBot(ctx, x, y, w, h, hp, maxHp, name, nitro) {
      // HP Bar & Nitro Bar
      const barW = 26;
      ctx.fillStyle = 'rgba(0,0,0,0.7)';
      ctx.fillRect(x - 4, y - 13, barW, 4);
      ctx.fillStyle = hp > maxHp * 0.5 ? '#00ff88' : '#ff4655';
      ctx.fillRect(x - 4, y - 13, barW * (hp / maxHp), 4);

      // Bot Nitro (Limited Jetpack Indicator)
      ctx.fillStyle = '#00f0ff';
      ctx.fillRect(x - 4, y - 8, barW * ((nitro || 100) / 100), 2);

      // Name
      ctx.font = "900 8px 'JetBrains Mono', monospace";
      ctx.fillStyle = '#ff4655';
      ctx.textAlign = 'center';
      ctx.fillText(name || 'BOT DUELIST', x + w / 2, y - 16);

      // Bot Head & Visor
      ctx.fillStyle = '#475569';
      ctx.fillRect(x + 3, y, 12, 8);
      ctx.fillStyle = '#ef4444';
      ctx.fillRect(x + 5, y + 2, 8, 2);

      // Torso
      ctx.fillStyle = '#334155';
      ctx.fillRect(x + 2, y + 8, 14, 11);
      ctx.fillStyle = '#ff4655'; // Core
      ctx.fillRect(x + 7, y + 11, 4, 4);

      // Legs
      ctx.fillStyle = '#1e293b';
      ctx.fillRect(x + 3, y + 19, 4, 7);
      ctx.fillRect(x + 11, y + 19, 4, 7);

      // Weapon
      ctx.fillStyle = '#0f172a';
      ctx.fillRect(x - 3, y + 11, 8, 3);
    }

    // High-Res Hero Sprite
    function drawPixelHero(ctx, x, y, w, h, char, facing) {
      ctx.save();
      ctx.fillStyle = char.skinColor;
      ctx.fillRect(x + 4, y + 2, 8, 7);

      ctx.fillStyle = char.hairColor;
      ctx.fillRect(x + 3, y, 10, 4);
      if (char.id === 'john_wick') {
        ctx.fillRect(x + 2, y + 2, 2, 6);
        ctx.fillRect(x + 12, y + 2, 2, 6);
        ctx.fillStyle = '#111827';
        ctx.fillRect(x + 5, y + 7, 6, 2);
      } else if (char.id === 'kratos') {
        ctx.fillStyle = '#ef4444';
        ctx.fillRect(x + 5, y + 1, 2, 8);
        ctx.fillStyle = '#451a03';
        ctx.fillRect(x + 4, y + 7, 8, 3);
      } else if (char.id === 'master_chief') {
        ctx.fillStyle = '#eab308';
        ctx.fillRect(x + 5, y + 3, 6, 3);
      } else if (char.id === 'terminator') {
        ctx.fillStyle = '#000000';
        ctx.fillRect(x + 4, y + 3, 8, 3);
        ctx.fillStyle = '#ef4444';
        ctx.fillRect(x + 9, y + 4, 2, 2);
      } else if (char.id === 'neo') {
        ctx.fillStyle = '#000000';
        ctx.fillRect(x + 4, y + 3, 8, 2);
      }

      ctx.fillStyle = char.suitColor;
      ctx.fillRect(x + 3, y + 9, 10, 10);
      
      ctx.fillStyle = char.shirtColor;
      ctx.fillRect(x + 6, y + 9, 4, 5);
      ctx.fillStyle = char.tieColor;
      ctx.fillRect(x + 7, y + 10, 2, 6);

      ctx.fillStyle = char.suitColor;
      ctx.fillRect(x + 3, y + 19, 4, 5);
      ctx.fillRect(x + 9, y + 19, 4, 5);

      ctx.fillStyle = '#0f172a';
      if (facing === 1) {
        ctx.fillRect(x + 11, y + 11, 8, 3);
      } else {
        ctx.fillRect(x - 3, y + 11, 8, 3);
      }
      ctx.restore();
    }
