      if (badgeEl) badgeEl.textContent = `${cat.name} (${cat.pillar.toUpperCase()})`;
      if (avatarEl) avatarEl.innerHTML = getDomainSvg(cat.id, isGame);

      if (!bodyEl) return;

      const type = cat.type || (isGame ? 'game' : 'task');

      if (type === 'map') {
        renderMapApp(bodyEl, appName);
      } else if (type === 'finance') {
        renderFinanceApp(bodyEl, appName);
      } else if (type === 'commerce' || type === 'food') {
        renderCommerceApp(bodyEl, appName, cat);
      } else if (type === 'social') {
        renderSocialApp(bodyEl, appName);
      } else if (type === 'health') {
        renderHealthApp(bodyEl, appName);
      } else if (type === 'music') {
        renderMusicApp(bodyEl, appName);
      } else if (type === 'game') {
        renderGameApp(bodyEl, appName, cat);
      } else if (type === 'weather') {
        renderWeatherApp(bodyEl, appName);
      } else {
        renderProductivityApp(bodyEl, appName, cat);
      }
    }

