    function renderMasterCategories(list) {
      const gridApps = document.getElementById('grid-apps');
      const gridGames = document.getElementById('grid-games');
      if (!gridApps || !gridGames) return;

      gridApps.innerHTML = '';
      gridGames.innerHTML = '';

      list.forEach(cat => {
        const isGame = cat.pillar === 'games';
        const isSelected = State.selectedCategory && State.selectedCategory.id === cat.id;

        const card = document.createElement('div');
        card.id = `matrix-card-${cat.id}`;
        card.className = `matrix-cat-card ${isSelected ? (isGame ? 'active-selected-green' : 'active-selected-cyan') : ''}`;
        card.onclick = () => window.selectMatrixCategory(cat);

        card.innerHTML = `
          <div>
            <div class="cat-avatar ${isGame ? 'green-box' : 'cyan-box'}">
              <span style="font-size: 1.2rem;">${cat.icon}</span>
            </div>
            <h4 class="cat-title">${cat.name}</h4>
          </div>
          <p class="cat-desc">${cat.desc}</p>
        `;

        if (cat.pillar === 'apps') {
          gridApps.appendChild(card);
        } else {
          gridGames.appendChild(card);
        }
      });
    }

    window.selectMatrixCategory = function(cat) {
      State.selectedCategory = cat;
      const previewIcon = document.getElementById('selected-preview-icon');
      const previewName = document.getElementById('selected-preview-name');
      const nextBtn = document.getElementById('btn-step1-next');

      if (previewIcon) {
        previewIcon.innerHTML = `<span style="font-size: 1.3rem;">${cat.icon}</span>`;
        previewIcon.className = `preview-icon-box ${cat.pillar === 'games' ? 'green-box' : 'cyan-box'}`;
      }
      if (previewName) {
        previewName.textContent = `${cat.name} (${cat.pillar === 'games' ? 'Game Engine' : 'App'})`;
      }

      if (nextBtn) {
        nextBtn.disabled = false;
        nextBtn.className = "btn-continue-architecture ready";
      }

      document.querySelectorAll('.matrix-cat-card').forEach(el => {
        el.classList.remove('active-selected-cyan', 'active-selected-green');
      });

      const activeCard = document.getElementById(`matrix-card-${cat.id}`);
      if (activeCard) {
        activeCard.classList.add(cat.pillar === 'games' ? 'active-selected-green' : 'active-selected-cyan');
