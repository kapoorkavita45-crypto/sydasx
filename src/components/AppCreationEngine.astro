    function initGpsCanvas() {
      const canvas = document.getElementById('gps-radar-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let angle = 0;

      function draw() {
        if (!document.getElementById('gps-radar-canvas')) return;
        ctx.fillStyle = '#050b14';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.strokeStyle = 'rgba(0, 240, 255, 0.15)';
        ctx.lineWidth = 1;
        for (let x = 0; x < canvas.width; x += 30) {
          ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); ctx.stroke();
        }
        for (let y = 0; y < canvas.height; y += 30) {
          ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); ctx.stroke();
        }

        ctx.strokeStyle = '#00f0ff';
        ctx.lineWidth = 3;
        ctx.shadowColor = '#00f0ff';
        ctx.shadowBlur = 10;
        ctx.beginPath();
        ctx.moveTo(40, 140);
        ctx.lineTo(120, 80);
        ctx.lineTo(200, 110);
        ctx.lineTo(260, 40);
        ctx.stroke();
        ctx.shadowBlur = 0;

        ctx.fillStyle = '#00ff88';
        ctx.beginPath();
        ctx.arc(120, 80, 6, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = '#ff007a';
        ctx.beginPath();
        ctx.arc(260, 40, 7, 0, Math.PI * 2);
        ctx.fill();

        ctx.strokeStyle = 'rgba(0, 255, 136, 0.4)';
        ctx.beginPath();
        ctx.moveTo(120, 80);
        ctx.lineTo(120 + Math.cos(angle) * 70, 80 + Math.sin(angle) * 70);
        ctx.stroke();

        angle += 0.04;
        requestAnimationFrame(draw);
      }
      draw();
    }

