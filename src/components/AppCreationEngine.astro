    window.updateMatrixComplexity = function(val) {
      State.complexityStars = parseInt(val, 10);
      const meterEl = document.getElementById('complexity-bars-meter');
      const textEl = document.getElementById('val-complexity-text');
      
      if (meterEl) {
        const bars = meterEl.querySelectorAll('.c-bar');
        bars.forEach((bar, idx) => {
          if (idx < State.complexityStars) {
            bar.classList.add('active');
          } else {
            bar.classList.remove('active');
          }
        });
      }
      if (textEl) textEl.textContent = State.complexityLabels[State.complexityStars - 1];
    };

