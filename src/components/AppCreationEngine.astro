    window.searchMatrixCategories = function(query) {
      const term = query.toLowerCase().trim();
      const filtered = MATRIX_CATEGORIES.filter(c => 
        c.name.toLowerCase().includes(term) || 
        c.desc.toLowerCase().includes(term) ||
        c.id.toLowerCase().includes(term)
      );
      renderMasterCategories(filtered);
    };

    window.goToMatrixStep = function(stepNum) {
      if (stepNum === 2 && !State.selectedCategory) return;
      State.currentStep = stepNum;

      for (let i = 1; i <= 4; i++) {
        const view = document.getElementById(`view-step-${i}`);
        const nav = document.getElementById(`nav-step-${i}`);
        if (view) {
          view.className = i === stepNum ? "matrix-step-view active-view" : "matrix-step-view hidden-view";
        }
        if (nav) {
          if (i === stepNum) {
            nav.className = "step-nav-card active";
          } else if (i < stepNum) {
            nav.className = "step-nav-card completed";
          } else {
            nav.className = "step-nav-card disabled";
          }
        }
      }

      if (stepNum === 2 && State.selectedCategory) {
        const titleEl = document.getElementById('step2-category-title');
        const iconEl = document.getElementById('step2-category-icon');
        if (titleEl) titleEl.textContent = State.selectedCategory.name;
        if (iconEl) iconEl.innerHTML = getDomainSvg(State.selectedCategory.id, State.selectedCategory.pillar === 'games');
        
        const inputName = document.getElementById('input-app-name');
        const counter = document.getElementById('name-counter');
        if (inputName) inputName.value = State.appName;
        if (counter) counter.textContent = `${State.appName.length}/32`;
      }

      if (stepNum === 4) {
        renderLiveInteractiveApp();
        renderBlueprintTelemetry();
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

