    window.filterMatrixPillar = function(type) {
      const btnAll = document.getElementById('btn-pillar-all');
      const btnApps = document.getElementById('btn-pillar-apps');
      const btnGames = document.getElementById('btn-pillar-games');
      const secApps = document.getElementById('pillar-apps-section');
      const secGames = document.getElementById('pillar-games-section');

      [btnAll, btnApps, btnGames].forEach(b => {
        if (b) b.className = "pillar-tab-btn";
      });

      if (type === 'all') {
        if (btnAll) btnAll.className = "pillar-tab-btn active-cyan";
        if (secApps) secApps.style.display = 'flex';
        if (secGames) secGames.style.display = 'flex';
      } else if (type === 'apps') {
        if (btnApps) btnApps.className = "pillar-tab-btn active-cyan";
        if (secApps) secApps.style.display = 'flex';
        if (secGames) secGames.style.display = 'none';
      } else if (type === 'games') {
        if (btnGames) btnGames.className = "pillar-tab-btn active-green";
        if (secApps) secApps.style.display = 'none';
        if (secGames) secGames.style.display = 'flex';
      }
    };

    window.searchMatrixCategories = function(query) {
      const term = query.toLowerCase().trim();
      const filtered = MATRIX_CATEGORIES.filter(c => 
        c.name.toLowerCase().includes(term) || 
        c.desc.toLowerCase().includes(term) ||
        c.id.toLowerCase().includes(term)
      );
      renderMasterCategories(filtered);
    };

    window.goToMatrixStep = function(stepNum) {
      if (stepNum === 2 && !State.selectedCategory) return;
      State.currentStep = stepNum;

      for (let i = 1; i <= 4; i++) {
        const view = document.getElementById(`view-step-${i}`);
        const nav = document.getElementById(`nav-step-${i}`);
        if (view) {
          view.className = i === stepNum ? "matrix-step-view active-view" : "matrix-step-view hidden-view";
        }
        if (nav) {
          if (i === stepNum) {
            nav.className = "step-nav-card active";
          } else if (i < stepNum) {
            nav.className = "step-nav-card completed";
          } else {
            nav.className = "step-nav-card disabled";
          }
        }
      }

      if (stepNum === 2 && State.selectedCategory) {
        const titleEl = document.getElementById('step2-category-title');
        const iconEl = document.getElementById('step2-category-icon');
        if (titleEl) titleEl.textContent = State.selectedCategory.name;
        if (iconEl) iconEl.innerHTML = `<span style="font-size: 1.5rem;">${State.selectedCategory.icon}</span>`;
        
        if (!State.appName || State.appName === 'Nexus Protocol') {
          const defaultNames = {
            'art_design': 'VectorFlow AI',
            'business': 'EnterprisePulse',
            'finance': 'OrbitPay Matrix',
            'social': 'SphereNet',
            'game_action': 'CyberVanguard RTS',
            'game_rpg': 'ChronoRealm Legends'
          };
          State.appName = defaultNames[State.selectedCategory.id] || `${State.selectedCategory.name.split(' ')[0]}Pro`;
          const inputName = document.getElementById('input-app-name');
          const counter = document.getElementById('name-counter');
          if (inputName) inputName.value = State.appName;
          if (counter) counter.textContent = `${State.appName.length}/32`;
        }
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    window.handleAppNameInput = function(val) {
      State.appName = val.trim() || 'Genesis App';
      const counter = document.getElementById('name-counter');
      if (counter) counter.textContent = `${val.length}/32`;
    };

    window.handleMatrixTechChange = function(type) {
      State.techType = type;
      document.querySelectorAll('.tech-radio-card').forEach(card => {
        const input = card.querySelector('input');
        const dot = card.querySelector('.tech-dot');
        if (input && input.value === type) {
          card.classList.add('active');
          if (dot) dot.classList.add('active');
        } else {
          card.classList.remove('active');
          if (dot) dot.classList.remove('active');
        }
      });
    };

    window.updateMatrixUsers = function(val) {
      State.userScaleIndex = parseInt(val, 10);
      const userValEl = document.getElementById('val-users');
      if (userValEl) userValEl.textContent = State.userScaleLabels[State.userScaleIndex - 1];
    };

    window.updateMatrixComplexity = function(val) {
      State.complexityStars = parseInt(val, 10);
      const starStrings = ['★☆☆☆☆', '★★☆☆☆', '★★★☆☆', '★★★★☆', '★★★★★'];
      const starEl = document.getElementById('star-rating');
      const textEl = document.getElementById('val-complexity-text');
      if (starEl) starEl.textContent = starStrings[State.complexityStars - 1];
      if (textEl) textEl.textContent = State.complexityLabels[State.complexityStars - 1];
    };

    window.startMatrixCompilation = function() {
      window.goToMatrixStep(3);

      const appName = State.appName || 'Nexus Protocol';
      const category = State.selectedCategory || { name: 'Core Application', pillar: 'apps' };
      const tech = State.techType;

      const appNameEl = document.getElementById('compiling-app-name');
      if (appNameEl) appNameEl.textContent = appName;

      const terminalLogs = document.getElementById('terminal-logs');
      const progressBar = document.getElementById('forge-progress-bar');
      const percentageText = document.getElementById('compile-percentage');
      const actionText = document.getElementById('compile-current-action');

      if (terminalLogs) terminalLogs.innerHTML = '';
      if (progressBar) progressBar.style.width = '0%';
      if (percentageText) percentageText.textContent = '0%';

      const steps = [
        { pct: 15, msg: `Initializing Genesis Virtual Core for [${appName}]...`, action: 'Allocating Distributed GPU Shards...' },
        { pct: 30, msg: `Injecting [${category.name}] domain schemas & security protocols...`, action: 'Synthesizing Data Pipeline...' },
        { pct: 50, msg: `Configuring ${tech.toUpperCase()} runtime binaries & WebRTC channels...`, action: `Compiling ${tech.toUpperCase()} Toolchain...` },
        { pct: 70, msg: `Benchmarking load tolerance for ${State.userScaleLabels[State.userScaleIndex - 1]} concurrency...`, action: 'Stress Testing Virtual Nodes...' },
        { pct: 88, msg: `Optimizing memory buffers for ${State.complexityStars}★ feature complexity...`, action: 'Finalizing Latency Tuning...' },
        { pct: 100, msg: `SUCCESS: System Blueprint [${appName}.x] forged and verified.`, action: 'Compiling Completed!' }
      ];

      let currentStepIndex = 0;

      function runNextStep() {
        if (currentStepIndex >= steps.length) {
          setTimeout(() => {
            renderBlueprintTelemetry();
            window.goToMatrixStep(4);
          }, 600);
          return;
        }

        const step = steps[currentStepIndex];
        if (progressBar) progressBar.style.width = `${step.pct}%`;
        if (percentageText) percentageText.textContent = `${step.pct}%`;
        if (actionText) actionText.textContent = step.action;

        if (terminalLogs) {
          const logEntry = document.createElement('div');
          logEntry.className = "log-row";
          logEntry.innerHTML = `
            <span style="color: ${step.pct === 100 ? '#00ff88' : '#e2e8f0'};">> ${step.msg}</span>
            <span style="color: #64748b; font-size: 0.68rem;">${new Date().toISOString().substring(14, 22)}</span>
          `;
          terminalLogs.prepend(logEntry);
        }

        currentStepIndex++;
        setTimeout(runNextStep, 500);
      }

      runNextStep();
    };

    function renderBlueprintTelemetry() {
      const appName = State.appName || 'Nexus Protocol';
      const cat = State.selectedCategory || { name: 'General App', pillar: 'apps', icon: '📱' };
      const tech = State.techType;
      const users = State.userScaleIndex;
      const stars = State.complexityStars;

      // 1. Update Mock Phone Display
      const mockName = document.getElementById('mock-app-name');
      const mockCat = document.getElementById('mock-app-category');
      const mockIcon = document.getElementById('mock-app-icon');
      const mockTech = document.getElementById('mock-tech-badge');

      if (mockName) mockName.textContent = appName;
      if (mockCat) mockCat.textContent = `${cat.name} (${cat.pillar.toUpperCase()})`;
      if (mockIcon) mockIcon.innerHTML = `<span style="font-size: 1.5rem;">${cat.icon}</span>`;
      if (mockTech) mockTech.textContent = tech.toUpperCase();

      // 2. Timeline calculations
      let minWeeks = 4 + (stars * 2);
      let maxWeeks = 6 + (stars * 3.5);
      if (tech === 'native') {
        minWeeks += 2;
        maxWeeks += 3;
      } else if (tech === 'hybrid') {
        minWeeks = Math.max(3, minWeeks - 2);
        maxWeeks = Math.max(5, maxWeeks - 2);
      }
      const timelineEl = document.getElementById('metric-timeline');
      const timelineDescEl = document.getElementById('metric-timeline-desc');
      if (timelineEl) timelineEl.textContent = `${Math.round(minWeeks)} - ${Math.round(maxWeeks)} Weeks`;
      if (timelineDescEl) timelineDescEl.textContent = `Full cycle agile sprint based on ${tech.toUpperCase()} core & ${stars}★ complexity.`;

      // 3. Infrastructure Cost
      const costMultipliers = [25, 60, 150, 450, 950, 2400, 5800];
      const baseCost = costMultipliers[users - 1] || 150;
      const complexityMultiplier = 0.8 + (stars * 0.25);
      const finalCost = Math.round(baseCost * complexityMultiplier);
      
      const costEl = document.getElementById('metric-cost');
      const costDescEl = document.getElementById('metric-cost-desc');
      if (costEl) costEl.textContent = `$${finalCost.toLocaleString()} / mo`;
      if (costDescEl) costDescEl.textContent = `Auto-scaling Kubernetes mesh for ${State.userScaleLabels[users - 1]}.`;

      // 4. Populate Stack Pills
      const stackPillsContainer = document.getElementById('metric-stack-pills');
      if (stackPillsContainer) {
        stackPillsContainer.innerHTML = '';
        let stacks = [];
        if (tech === 'native') {
          stacks = ['Kotlin 2.0', 'Swift 6', 'Android Jetpack', 'SwiftUI', 'PostgreSQL', 'Redis Cluster', 'GraphQL Mesh', 'gRPC'];
        } else if (tech === 'cross') {
          stacks = ['Flutter 3.x / React Native', 'Dart', 'TypeScript', 'Node.js Fastify', 'Supabase', 'Docker', 'Google Cloud Run'];
        } else {
          stacks = ['Capacitor 6', 'Astro Web Core', 'Tailwind CSS', 'WebSockets', 'Cloudflare Workers', 'Edge DB', 'Vite'];
        }

        if (cat.pillar === 'games') {
          stacks.unshift('Unity / Unreal C++', 'Vulkan Shaders');
        }

        stacks.forEach(techItem => {
          const pill = document.createElement('span');
          pill.className = "stack-badge-pill";
          pill.textContent = techItem;
          stackPillsContainer.appendChild(pill);
        });
      }
    }

    window.exportMatrixBlueprint = function() {
      const catName = State.selectedCategory ? State.selectedCategory.name : 'General App';
      const catPillar = State.selectedCategory ? State.selectedCategory.pillar : 'apps';
      const timelineVal = document.getElementById('metric-timeline') ? document.getElementById('metric-timeline').textContent : '6 - 8 Weeks';
      const costVal = document.getElementById('metric-cost') ? document.getElementById('metric-cost').textContent : '$120 / mo';

      const blueprintData = {
        system: "SYDAS.x Genesis Matrix",
        version: "7.0",
        timestamp: new Date().toISOString(),
        application: {
          name: State.appName,
          category: catName,
          pillar: catPillar,
          technology_engine: State.techType,
          scale: State.userScaleLabels[State.userScaleIndex - 1],
          complexity_stars: State.complexityStars
        },
        metrics: {
          estimated_timeline: timelineVal,
          estimated_monthly_infra: costVal,
          uptime_sla: "99.98%",
          encryption: "AES-256 GCM",
          compliance: "SOC-2 Type II Ready"
        }
      };

      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(blueprintData, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `${State.appName.toLowerCase().replace(/\s+/g, '_')}_genesis_blueprint.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    };

    window.resetMatrixEngine = function() {
      State.selectedCategory = null;
      State.appName = 'Nexus Protocol';
      State.currentStep = 1;
      
      const searchInput = document.getElementById('category-search-input');
      if (searchInput) searchInput.value = '';

      window.filterMatrixPillar('all');
      renderMasterCategories(MATRIX_CATEGORIES);

      const previewName = document.getElementById('selected-preview-name');
      const nextBtn = document.getElementById('btn-step1-next');
      if (previewName) previewName.textContent = 'None Selected';
      if (nextBtn) {
        nextBtn.disabled = true;
        nextBtn.className = "btn-continue-architecture disabled";
      }

      window.goToMatrixStep(1);
    };

    // Initialize on load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => renderMasterCategories(MATRIX_CATEGORIES));
    } else {
      renderMasterCategories(MATRIX_CATEGORIES);
    }
  })();
</script>
