    // Touch Controls
    window.pgTouchMove = function(dir, isHeld) {
      if (!pixelGameState) return;
      const char = getSelectedChar();
      pixelGameState.player.vx = isHeld ? (dir * char.speed) : 0;
    };

    window.pgTouchFly = function(isHeld) {
