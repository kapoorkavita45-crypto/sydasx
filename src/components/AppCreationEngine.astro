    // Web Audio synthesizer for tactile feel
    window.playMatrixChime = function() {
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        const ctx = new AudioContext();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(880, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(1320, ctx.currentTime + 0.1);
        gain.gain.setValueAtTime(0.08, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.12);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.12);
      } catch(e) {}
    };

    window.triggerLivePhoneEvent = function(type) {
      if (type === 'refresh') {
        renderLiveInteractiveApp();
        alert(`State reloaded for [${State.appName}]`);
      } else if (type === 'test_notify') {
        alert(`[${State.appName} Push]: Real-time event dispatched to virtual device!`);
      } else if (type === 'benchmark') {
        alert(`Benchmark Completed: 100,000 requests handled in 14ms with 0 errors.`);
      }
      window.playMatrixChime();
    };

    window.toggleAppPhoneMode = function(mode) {
      State.activeMode = mode;
      const btnInter = document.getElementById('btn-mode-interactive');
      const btnBlue = document.getElementById('btn-mode-blueprint');
      if (btnInter && btnBlue) {
        if (mode === 'interactive') {
          btnInter.className = "btn-mode-toggle active-mode";
          btnBlue.className = "btn-mode-toggle";
          renderLiveInteractiveApp();
        } else {
          btnBlue.className = "btn-mode-toggle active-mode";
          btnInter.className = "btn-mode-toggle";
          const bodyEl = document.getElementById('live-interactive-app-body');
          if (bodyEl) {
            bodyEl.innerHTML = `
              <div class="live-action-card">
                <div class="live-card-header"><span>SYSTEM ARCHITECTURE</span><span>v1.0.0</span></div>
                <div style="font-family: monospace; font-size: 0.75rem; color: #94a3b8; display: flex; flex-direction: column; gap: 0.4rem;">
                  <div>ENGINE: <strong style="color: #00f0ff;">${State.techType.toUpperCase()}</strong></div>
                  <div>SCALE: <strong style="color: #00ff88;">${State.userScaleLabels[State.userScaleIndex-1]}</strong></div>
                  <div>COMPLEXITY: <strong style="color: #b026ff;">${State.complexityStars} Stars</strong></div>
                </div>
              </div>
            `;
          }
        }
      }
      window.playMatrixChime();
    };

    function renderBlueprintTelemetry() {
      const cat = State.selectedCategory || MATRIX_CATEGORIES[0];
      const tech = State.techType;
      const users = State.userScaleIndex;
      const stars = State.complexityStars;

      let minWeeks = 4 + (stars * 2);
      let maxWeeks = 6 + (stars * 3.5);
      if (tech === 'native') {
        minWeeks += 2;
        maxWeeks += 3;
      } else if (tech === 'hybrid') {
        minWeeks = Math.max(3, minWeeks - 2);
        maxWeeks = Math.max(5, maxWeeks - 2);
      }
      const timelineEl = document.getElementById('metric-timeline');
      const timelineDescEl = document.getElementById('metric-timeline-desc');
      if (timelineEl) timelineEl.textContent = `${Math.round(minWeeks)} - ${Math.round(maxWeeks)} Weeks`;
      if (timelineDescEl) timelineDescEl.textContent = `Full cycle agile sprint based on ${tech.toUpperCase()} core & ${stars}★ complexity.`;

      const costMultipliers = [25, 60, 150, 450, 950, 2400, 5800];
      const baseCost = costMultipliers[users - 1] || 150;
      const complexityMultiplier = 0.8 + (stars * 0.25);
      const finalCost = Math.round(baseCost * complexityMultiplier);
      
      const costEl = document.getElementById('metric-cost');
      const costDescEl = document.getElementById('metric-cost-desc');
      if (costEl) costEl.textContent = `$${finalCost.toLocaleString()} / mo`;
      if (costDescEl) costDescEl.textContent = `Auto-scaling Kubernetes mesh for ${State.userScaleLabels[users - 1]}.`;

      const stackPillsContainer = document.getElementById('metric-stack-pills');
      if (stackPillsContainer) {
        stackPillsContainer.innerHTML = '';
        let stacks = [];
        if (tech === 'native') {
          stacks = ['Kotlin 2.0', 'Swift 6', 'Android Jetpack', 'SwiftUI', 'PostgreSQL', 'Redis Cluster', 'GraphQL Mesh', 'gRPC'];
        } else if (tech === 'cross') {
          stacks = ['Flutter 3.x / React Native', 'Dart', 'TypeScript', 'Node.js Fastify', 'Supabase', 'Docker', 'Google Cloud Run'];
        } else {
          stacks = ['Capacitor 6', 'Astro Web Core', 'Tailwind CSS', 'WebSockets', 'Cloudflare Workers', 'Edge DB', 'Vite'];
        }

        if (cat.pillar === 'games') {
          stacks.unshift('Unity / Unreal C++', 'Vulkan Shaders');
        }

        stacks.forEach(techItem => {
          const pill = document.createElement('span');
          pill.className = "stack-badge-pill";
          pill.textContent = techItem;
          stackPillsContainer.appendChild(pill);
        });
      }
    }

    window.exportMatrixBlueprint = function() {
      const catName = State.selectedCategory ? State.selectedCategory.name : 'General App';
      const catPillar = State.selectedCategory ? State.selectedCategory.pillar : 'apps';
      const timelineVal = document.getElementById('metric-timeline') ? document.getElementById('metric-timeline').textContent : '6 - 8 Weeks';
      const costVal = document.getElementById('metric-cost') ? document.getElementById('metric-cost').textContent : '$120 / mo';

      const blueprintData = {
        system: "SYDAS.x Genesis Matrix",
        version: "7.0",
        timestamp: new Date().toISOString(),
        application: {
          name: State.appName,
          category: catName,
          pillar: catPillar,
          technology_engine: State.techType,
          scale: State.userScaleLabels[State.userScaleIndex - 1],
          complexity_stars: State.complexityStars
        },
        metrics: {
          estimated_timeline: timelineVal,
          estimated_monthly_infra: costVal,
          uptime_sla: "99.98%",
          encryption: "AES-256 GCM",
          compliance: "SOC-2 Type II Ready"
        }
      };

      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(blueprintData, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `${State.appName.toLowerCase().replace(/\s+/g, '_')}_genesis_blueprint.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    };

    window.resetMatrixEngine = function() {
      State.selectedCategory = null;
      State.appName = 'Nexus Protocol';
      State.currentStep = 1;
      
      const searchInput = document.getElementById('category-search-input');
      if (searchInput) searchInput.value = '';

      window.filterMatrixPillar('all');
      renderMasterCategories(MATRIX_CATEGORIES);

      const previewName = document.getElementById('selected-preview-name');
      const nextBtn = document.getElementById('btn-step1-next');
      if (previewName) previewName.textContent = 'None Selected';
      if (nextBtn) {
        nextBtn.disabled = true;
        nextBtn.className = "btn-continue-architecture disabled";
      }

      window.goToMatrixStep(1);
    };

    // Initialize on load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => renderMasterCategories(MATRIX_CATEGORIES));
    } else {
      renderMasterCategories(MATRIX_CATEGORIES);
    }
  })();
</script>
