      `;
    }

    window.toggleTaskItem = function(idx) {
      if (State.liveData.tasks[idx]) {
        State.liveData.tasks[idx].done = !State.liveData.tasks[idx].done;
        renderLiveInteractiveApp();
        window.playMatrixChime();
      }
    };

    window.addNewTaskItem = function() {
      const input = document.getElementById('new-task-input');
      if (!input || !input.value.trim()) return;
      State.liveData.tasks.push({ text: input.value.trim(), done: false });
      renderLiveInteractiveApp();
      window.playMatrixChime();
    };

    // Bottom Navigation inside phone
    window.switchPhoneTab = function(tabName, btnEl) {
      State.currentTab = tabName;
      document.querySelectorAll('.phone-nav-tab').forEach(b => b.classList.remove('active'));
      if (btnEl) btnEl.classList.add('active');

      const bodyEl = document.getElementById('live-interactive-app-body');
