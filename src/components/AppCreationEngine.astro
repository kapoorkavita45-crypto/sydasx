          : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:middle; margin-right:4px;"><rect width="20" height="14" x="2" y="5" rx="2" ry="2"></rect><path d="M18 12h.01"></path><path d="M19 8l2 2-2 2"></path></svg><span>TILT PHONE 🔄</span>';
