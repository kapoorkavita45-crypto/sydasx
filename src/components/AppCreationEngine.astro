    // ARCHETYPE 9: PRODUCTIVITY & TASK MANAGER
    function renderProductivityApp(container, appName, cat) {
      container.innerHTML = `
        <div class="live-action-card">
          <div class="live-card-header"><span>ACTIVE SPRINT LOGS</span><span>${State.liveData.tasks.length} TASKS</span></div>
          <div id="todo-tasks-list" style="display: flex; flex-direction: column; gap: 0.4rem;">
            ${State.liveData.tasks.map((t, idx) => `
              <div onclick="window.toggleTaskItem(${idx})" style="display: flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.5rem; background: #05070d; border: 1px solid #1e293b; border-radius: 8px; font-size: 0.75rem; cursor: pointer;">
                <span style="color: ${t.done ? '#00ff88' : '#64748b'}; font-weight: 800; font-family: monospace;">[${t.done ? 'X' : ' '}]</span>
                <span style="text-decoration: ${t.done ? 'line-through' : 'none'}; color: ${t.done ? '#64748b' : '#fff'}; flex: 1;">${t.text}</span>
