---
---

<div class="app-creation-matrix-wrapper">
  <!-- Ambient Glow Blobs -->
  <div class="ambient-glow cyan-glow"></div>
  <div class="ambient-glow purple-glow"></div>
  <div class="ambient-glow green-glow"></div>

  <div class="matrix-app-container">
    
    <!-- HEADER -->
    <header class="app-matrix-header">

      <h1 class="matrix-app-title">
        App <span class="text-gradient">Creation</span>
      </h1>
      <p class="matrix-app-subtitle">
        Forge, test-compile, and <span class="highlight-emerald">interactively run</span> production-grade applications across all 49 Google Play Store domains with real-time hardware telemetry and playable mobile sandbox.
      </p>

      <!-- STEP PROGRESS HUD BAR -->
      <div class="step-hud-container">
        <div class="step-hud-grid">
          
          <!-- Step Tab 1 -->
          <div id="nav-step-1" class="step-nav-card active" onclick="window.goToMatrixStep(1)">
            <div class="step-nav-header">
              <span class="step-badge-num">1</span>
              <span class="step-nav-label">Genesis</span>
            </div>
            <span class="step-nav-sub">Category (49)</span>
          </div>

          <!-- Step Tab 2 -->
          <div id="nav-step-2" class="step-nav-card disabled" onclick="window.goToMatrixStep(2)">
            <div class="step-nav-header">
              <span class="step-badge-num">2</span>
              <span class="step-nav-label">Blueprint</span>
            </div>
            <span class="step-nav-sub">Specs & Scale</span>
          </div>

          <!-- Step Tab 3 -->
          <div id="nav-step-3" class="step-nav-card disabled" onclick="window.goToMatrixStep(3)">
            <div class="step-nav-header">
              <span class="step-badge-num">3</span>
              <span class="step-nav-label">The Forge</span>
            </div>
            <span class="step-nav-sub">Compilation</span>
          </div>

          <!-- Step Tab 4 -->
          <div id="nav-step-4" class="step-nav-card disabled" onclick="window.goToMatrixStep(4)">
            <div class="step-nav-header">
              <span class="step-badge-num">4</span>
              <span class="step-nav-label">Live App</span>
            </div>
            <span class="step-nav-sub">Interactive Sandbox</span>
          </div>

        </div>
      </div>
    </header>


    <!-- ================================================================= -->
    <!-- STEP 1: CATEGORY SELECTION (49 CATEGORIES WITH CLEAN SVGs)        -->
    <!-- ================================================================= -->
    <section id="view-step-1" class="matrix-step-view active-view">
      
      <!-- Top Control Bar -->
      <div class="control-hud-bar">
        <div class="pillar-switch-group">
          <button id="btn-pillar-all" onclick="window.filterMatrixPillar('all')" class="pillar-tab-btn active-cyan">
            All Pillars (49)
          </button>
          <button id="btn-pillar-apps" onclick="window.filterMatrixPillar('apps')" class="pillar-tab-btn">
            <span class="dot-cyan"></span>General Apps (32)
          </button>
          <button id="btn-pillar-games" onclick="window.filterMatrixPillar('games')" class="pillar-tab-btn">
            <span class="dot-green"></span>Gaming Engines (17)
          </button>
        </div>

        <!-- Search Input -->
        <div class="search-input-wrap">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input 
            type="text" 
            id="category-search-input" 
            placeholder="Search all 49 categories..." 
            oninput="window.searchMatrixCategories(this.value)"
            class="matrix-search-field"
          />
        </div>
      </div>

      <!-- Categories Container -->
      <div class="categories-master-wrapper">

        <!-- PILLAR 1: GENERAL APPS (32 CATEGORIES) -->
        <div id="pillar-apps-section" class="pillar-category-block">
          <div class="pillar-section-header">
            <div class="header-left-info">
              <div class="pillar-icon-box cyan-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
              </div>
              <div>
                <h3 class="pillar-section-title">Pillar I: General Applications</h3>
                <p class="pillar-section-desc">32 Official Google Play Store Ecosystem Domains</p>
              </div>
            </div>
            <span class="pillar-count-badge cyan-count">32 DOMAINS</span>
          </div>

          <div id="grid-apps" class="categories-cards-grid"></div>
        </div>

        <!-- PILLAR 2: GAMING ENGINES (17 CATEGORIES) -->
        <div id="pillar-games-section" class="pillar-category-block">
          <div class="pillar-section-header">
            <div class="header-left-info">
              <div class="pillar-icon-box green-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="6" y1="12" x2="10" y2="12"></line><line x1="8" y1="10" x2="8" y2="14"></line><line x1="15" y1="13" x2="15.01" y2="13"></line><line x1="18" y1="11" x2="18.01" y2="11"></line><rect x="2" y="6" width="20" height="12" rx="2"></rect></svg>
              </div>
              <div>
                <h3 class="pillar-section-title">Pillar II: Gaming Engines & Real-Time Worlds</h3>
                <p class="pillar-section-desc">17 Specialized Game Architectures & Physics</p>
              </div>
            </div>
            <span class="pillar-count-badge green-count">17 ENGINES</span>
          </div>

          <div id="grid-games" class="categories-cards-grid"></div>
        </div>

      </div>

      <!-- Bottom Floating Action Bar -->
      <div class="floating-selection-bar">
        <div class="selection-preview-info">
          <div id="selected-preview-icon" class="preview-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect></svg>
          </div>
          <div>
            <div class="preview-tiny-tag">SELECTED MATRIX VECTOR:</div>
            <div id="selected-preview-name" class="preview-main-text">None Selected</div>
          </div>
        </div>

        <button 
          id="btn-step1-next" 
          onclick="window.goToMatrixStep(2)" 
          disabled 
          class="btn-continue-architecture disabled"
        >
          <span>Continue to Architecture</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </button>
      </div>

    </section>


    <!-- ================================================================= -->
    <!-- STEP 2: BLUEPRINT ARCHITECTURE                                    -->
    <!-- ================================================================= -->
    <section id="view-step-2" class="matrix-step-view hidden-view">
      <div class="step2-layout-container">
        
        <div class="step2-category-banner">
          <div class="banner-left">
            <div id="step2-category-icon" class="banner-icon-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
            </div>
            <div>
              <span class="banner-tag">Configuring Architecture For</span>
              <h2 id="step2-category-title" class="banner-category-name">Selected Category</h2>
            </div>
          </div>
          <button onclick="window.goToMatrixStep(1)" class="btn-change-cat">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
            Change Category
          </button>
        </div>

        <div class="step2-specs-card">
          
          <!-- 1. App Name Input -->
          <div class="spec-group">
            <div class="spec-label-row">
              <label for="input-app-name" class="spec-label">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                1. Application / Project Name
              </label>
              <span id="name-counter" class="char-counter">0/32</span>
            </div>
            <input 
              type="text" 
              id="input-app-name" 
              maxlength="32" 
              placeholder="e.g., Nexus Protocol, HyperPulse, OrbitPay..."
              oninput="window.handleAppNameInput(this.value)"
              class="matrix-app-input"
            />
          </div>

          <!-- 2. Technology Type -->
          <div class="spec-group">
            <label class="spec-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
              2. Core Technology Engine
            </label>

            <div class="tech-options-grid">
              <label class="tech-radio-card active" onclick="window.handleMatrixTechChange('native')">
                <input type="radio" name="matrix_tech_type" value="native" class="sr-only" checked />
                <div class="tech-card-top">
                  <span class="tech-name">
                    <span class="tech-dot active"></span>
                    Native Core
                  </span>
                  <span class="tech-badge-pill cyan-pill">MAX SPEED</span>
                </div>
                <p class="tech-desc">Kotlin & Swift direct hardware level compilation for flawless 120 FPS latency.</p>
                <div class="tech-stack-foot">Stack: Kotlin, Swift, Android NDK</div>
              </label>

              <label class="tech-radio-card" onclick="window.handleMatrixTechChange('cross')">
                <input type="radio" name="matrix_tech_type" value="cross" class="sr-only" />
                <div class="tech-card-top">
                  <span class="tech-name">
                    <span class="tech-dot"></span>
                    Cross-Platform
                  </span>
                  <span class="tech-badge-pill purple-pill">VERSATILE</span>
                </div>
                <p class="tech-desc">Unified high-performance codebase targeting Android, iOS, and Web simultaneously.</p>
                <div class="tech-stack-foot">Stack: Flutter, React Native, Rust</div>
              </label>

              <label class="tech-radio-card" onclick="window.handleMatrixTechChange('hybrid')">
                <input type="radio" name="matrix_tech_type" value="hybrid" class="sr-only" />
                <div class="tech-card-top">
                  <span class="tech-name">
                    <span class="tech-dot"></span>
                    Hybrid Edge
                  </span>
                  <span class="tech-badge-pill green-pill">RAPID DEPLOY</span>
                </div>
                <p class="tech-desc">Web-view progressive architecture with native bridge bindings for swift iteration.</p>
                <div class="tech-stack-foot">Stack: Capacitor, Astro, WebGL</div>
              </label>
            </div>
          </div>

          <!-- 3. Sliders -->
          <div class="sliders-split-grid">
            <div class="slider-box">
              <div class="slider-header-row">
                <label class="slider-label">Target Monthly Users</label>
                <span id="val-users" class="slider-val-badge">500K Users</span>
              </div>
              <input type="range" id="slider-users" min="1" max="7" value="4" step="1" oninput="window.updateMatrixUsers(this.value)" class="matrix-range" />
              <div class="slider-ticks">
                <span>1K (MVP)</span>
                <span>50K</span>
                <span>500K</span>
                <span>2M</span>
                <span>10M+</span>
              </div>
            </div>

            <div class="slider-box">
              <div class="slider-header-row">
                <label class="slider-label">Feature Complexity</label>
                <div class="complexity-rating-wrap">
                  <div id="complexity-bars-meter" class="complexity-bars-row">
                    <span class="c-bar active"></span>
                    <span class="c-bar active"></span>
                    <span class="c-bar active"></span>
                    <span class="c-bar"></span>
                    <span class="c-bar"></span>
                  </div>
                  <span id="val-complexity-text" class="complexity-subtext">Level 3: Advanced System</span>
                </div>
              </div>
              <input type="range" id="slider-complexity" min="1" max="5" value="3" step="1" oninput="window.updateMatrixComplexity(this.value)" class="matrix-range" />
              <div class="slider-ticks">
                <span>Tier 1: Minimal</span>
                <span>Tier 2: Standard</span>
                <span>Tier 3: Advanced</span>
                <span>Tier 4: Complex</span>
                <span>Tier 5: Enterprise</span>
              </div>
            </div>
          </div>

        </div>

        <div class="step2-actions-row">
          <button onclick="window.goToMatrixStep(1)" class="btn-step-back">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"></path></svg>
            <span>Back to Categories</span>
          </button>

          <button onclick="window.startMatrixCompilation()" class="btn-step-compile">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            <span>Initialize Genesis & Compile</span>
          </button>
        </div>

      </div>
    </section>


    <!-- ================================================================= -->
    <!-- STEP 3: THE MATRIX FORGE (COMPILATION)                            -->
    <!-- ================================================================= -->
    <section id="view-step-3" class="matrix-step-view hidden-view">
      <div class="step3-forge-container">
        <div class="forge-hud-card">
          
          <div class="forge-scanner-area">
            <div class="radar-core-circle">
              <div class="spinning-outer-dashed"></div>
              <div class="pulsing-ping-ring"></div>
              <div class="inner-cpu-core">
                <svg class="cpu-icon animate-pulse" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect><rect x="9" y="9" width="6" height="6"></rect><line x1="9" y1="1" x2="9" y2="4"></line><line x1="15" y1="1" x2="15" y2="4"></line><line x1="9" y1="20" x2="9" y2="23"></line><line x1="15" y1="20" x2="15" y2="23"></line><line x1="20" y1="9" x2="23" y2="9"></line><line x1="20" y1="14" x2="23" y2="14"></line><line x1="1" y1="9" x2="4" y2="9"></line><line x1="1" y1="14" x2="4" y2="14"></line></svg>
                <span id="compile-percentage" class="percentage-readout">0%</span>
              </div>
            </div>

            <h3 class="forge-compiling-title">
              Forging <span id="compiling-app-name" class="highlight-cyan">Application</span>
            </h3>
            <p id="compile-current-action" class="forge-action-status">
              Allocating Genesis Matrix Virtual Nodes...
            </p>

            <div class="forge-progress-track">
              <div id="forge-progress-bar" class="forge-progress-fill"></div>
            </div>
          </div>

          <div class="terminal-log-window">
            <div class="terminal-header-bar">
              <span>TERMINAL TELEMETRY FEED (MATRIX_STDOUT)</span>
              <span class="terminal-active-indicator">
                <span class="green-dot animate-pulse"></span>
                ACTIVE
              </span>
            </div>
            <div id="terminal-logs" class="terminal-entries-list"></div>
          </div>

        </div>
      </div>
    </section>


    <!-- ================================================================= -->
    <!-- STEP 4: LIVE INTERACTIVE APP & SYSTEM BLUEPRINT DASHBOARD         -->
    <!-- ================================================================= -->
    <section id="view-step-4" class="matrix-step-view hidden-view">
      <div class="step4-output-container">
        
        <!-- Top Success Header & Mode Switcher -->
        <div class="output-success-banner">
          <div class="success-left">
            <div class="success-icon-badge">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <div>
              <span class="success-tiny-tag">APPLICATION FORGED & ONLINE</span>
              <h2 class="success-headline">Live Interactive Sandbox Ready</h2>
            </div>
          </div>

          <div class="success-actions-wrap">
            <button onclick="window.togglePhoneTilt()" id="btn-toggle-tilt" class="btn-mode-toggle" style="background: linear-gradient(135deg, rgba(0,240,255,0.2), rgba(0,255,136,0.2)); border: 1.5px solid #00f0ff; color: #00f0ff; font-weight: 900;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:middle; margin-right:4px;"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect><path d="M12 18h.01"></path><path d="M19 8l2 2-2 2"></path></svg>
              <span>TILT PHONE 🔄</span>
            </button>
            <button onclick="window.toggleAppPhoneMode('interactive')" id="btn-mode-interactive" class="btn-mode-toggle active-mode">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:middle; margin-right:4px;"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
              Interactive App
            </button>
            <button onclick="window.toggleAppPhoneMode('blueprint')" id="btn-mode-blueprint" class="btn-mode-toggle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:middle; margin-right:4px;"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
              System Telemetry
            </button>
            <button onclick="window.exportMatrixBlueprint()" class="btn-export-blueprint">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              Export JSON
            </button>
            <button onclick="window.resetMatrixEngine()" class="btn-reset-matrix">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
              Reset
            </button>
          </div>
        </div>

        <!-- Main Full-Width Dashboard Grid -->
        <div class="blueprint-dashboard-grid">
          
          <!-- LEFT COLUMN: LIVE RUNNING INTERACTIVE MOBILE PHONE DISPLAY -->
          <div class="blueprint-phone-col">
            <div class="mobile-phone-casing" id="phone-casing">
              
              <!-- Top Speaker Notch -->
              <div class="phone-speaker-notch">
                <div class="notch-camera"></div>
                <div class="notch-speaker"></div>
              </div>

              <!-- Inner Device Screen with Real Interactive App OS -->
              <div class="phone-screen-display" id="phone-screen-root">
                
                <!-- System Status Bar -->
                <div class="phone-status-bar">
                  <span id="phone-live-clock">9:41 AM</span>
                  <div class="phone-status-icons">
                    <span class="phone-5g-tag">5G</span>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#00f0ff" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0"></path><path d="M1.42 9a16 16 0 0 1 21.16 0"></path><path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path><line x1="12" y1="20" x2="12.01" y2="20"></line></svg>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#00ff88" stroke-width="2"><rect x="1" y="6" width="18" height="12" rx="2"></rect><line x1="23" y1="13" x2="23" y2="11"></line></svg>
                  </div>
                </div>

                <!-- Interactive App Header Bar -->
                <div class="phone-app-topbar">
                  <div class="topbar-left">
                    <div id="live-app-avatar" class="app-avatar-box">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    </div>
                    <div>
                      <h4 id="live-app-title" class="live-app-heading">App Title</h4>
                      <span id="live-app-badge" class="live-app-category-sub">Category</span>
                    </div>
                  </div>
                  <div class="topbar-actions">
                    <button class="topbar-btn" title="Tilt Phone Edge-to-Edge" onclick="window.togglePhoneTilt()" style="color: #00f0ff; border-color: rgba(0,240,255,0.4); font-weight: 800; font-size: 0.65rem; display: flex; align-items: center; gap: 3px;">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6"></path><path d="M9 21H3v-6"></path><path d="M21 3l-7 7"></path><path d="M3 21l7-7"></path></svg>
      <span>TILT 🔄</span>
    </button>
    <button class="topbar-btn" title="Tactile Chimes" onclick="window.playMatrixChime()">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00f0ff" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                    </button>
                    <div class="online-indicator-pill">
                      <span class="online-dot"></span> LIVE
                    </div>
                  </div>
                </div>

                <!-- DYNAMIC CATEGORY-SPECIFIC INTERACTIVE APP CONTAINER -->
                <div id="live-interactive-app-body" class="live-interactive-viewport">
                  <!-- Injected dynamically with clean vector SVGs -->
                </div>

                <!-- PHONE BOTTOM TAB BAR (WITH CLEAN SVGs) -->
                <div class="phone-bottom-nav-bar" id="phone-nav-bar">
                  <button class="phone-nav-tab active" onclick="window.switchPhoneTab('home', this)">
                    <span class="nav-tab-icon">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                    </span>
                    <span class="nav-tab-lbl">Home</span>
                  </button>
                  <button class="phone-nav-tab" onclick="window.switchPhoneTab('explore', this)">
                    <span class="nav-tab-icon">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon></svg>
                    </span>
                    <span class="nav-tab-lbl">Explore</span>
                  </button>
                  <button class="phone-nav-tab" onclick="window.switchPhoneTab('action', this)">
                    <span class="nav-tab-icon">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                    </span>
                    <span class="nav-tab-lbl">Action</span>
                  </button>
                  <button class="phone-nav-tab" onclick="window.switchPhoneTab('settings', this)">
                    <span class="nav-tab-icon">
