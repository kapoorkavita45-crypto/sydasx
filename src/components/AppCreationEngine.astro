        { pct: 88, msg: `Optimizing memory buffers for Level ${State.complexityStars} feature complexity...`, action: 'Finalizing Latency Tuning...' },
        { pct: 100, msg: `SUCCESS: System Blueprint [${appName}.x] forged and verified.`, action: 'Compiling Completed!' }
      ];

      let currentStepIndex = 0;

      function runNextStep() {
        if (currentStepIndex >= steps.length) {
          setTimeout(() => {
            window.goToMatrixStep(4);
          }, 600);
          return;
        }

        const step = steps[currentStepIndex];
        if (progressBar) progressBar.style.width = `${step.pct}%`;
        if (percentageText) percentageText.textContent = `${step.pct}%`;
        if (actionText) actionText.textContent = step.action;

        if (terminalLogs) {
          const logEntry = document.createElement('div');
          logEntry.className = "log-row";
          logEntry.innerHTML = `
            <span style="color: ${step.pct === 100 ? '#00ff88' : '#e2e8f0'};">> ${step.msg}</span>
            <span style="color: #64748b; font-size: 0.68rem;">${new Date().toISOString().substring(14, 22)}</span>
          `;
          terminalLogs.prepend(logEntry);
        }

        currentStepIndex++;
        setTimeout(runNextStep, 500);
      }

      runNextStep();
    };

