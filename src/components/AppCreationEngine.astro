    // Render Categories with SVG Icons & Smooth JavaScript + CSS Hover Bindings
    function renderMasterCategories(list) {
      const gridApps = document.getElementById('grid-apps');
      const gridGames = document.getElementById('grid-games');
      if (!gridApps || !gridGames) return;

      gridApps.innerHTML = '';
      gridGames.innerHTML = '';

      list.forEach(cat => {
        const isGame = cat.pillar === 'games';
        const isSelected = State.selectedCategory && State.selectedCategory.id === cat.id;

        const card = document.createElement('div');
        card.id = `matrix-card-${cat.id}`;
        card.className = `matrix-cat-card ${isGame ? 'is-game-card' : 'is-app-card'} ${isSelected ? (isGame ? 'active-selected-green' : 'active-selected-cyan') : ''}`;
        
        // Direct event listeners for bulletproof hover interactions
        card.addEventListener('mouseenter', () => {
          card.classList.add('is-hovered');
        });
        card.addEventListener('mouseleave', () => {
          card.classList.remove('is-hovered');
        });

        card.onclick = () => window.selectMatrixCategory(cat);

        card.innerHTML = `
          <div class="card-top-row">
            <div class="cat-avatar ${isGame ? 'green-box' : 'cyan-box'}">
              ${getDomainSvg(cat.id, isGame)}
            </div>
            <div class="cat-card-text">
              <h4 class="cat-title">${cat.name}</h4>
              <span class="cat-sub-hint">${isGame ? 'Game Engine' : 'Play Store Domain'}</span>
