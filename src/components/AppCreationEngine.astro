      if (progressBar) progressBar.style.width = '0%';
      if (percentageText) percentageText.textContent = '0%';

      const steps = [
        { pct: 15, msg: `Initializing Genesis Virtual Core for [${appName}]...`, action: 'Allocating Distributed GPU Shards...' },
        { pct: 30, msg: `Injecting [${category.name}] domain schemas & security protocols...`, action: 'Synthesizing Data Pipeline...' },
