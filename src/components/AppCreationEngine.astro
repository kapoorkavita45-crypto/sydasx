    let playerX = 140;
    let playerY = 130;
    let starsList = [];

    function initMiniGameCanvas() {
      const canvas = document.getElementById('mini-arcade-canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      starsList = [];
      for (let i = 0; i < 20; i++) {
        starsList.push({ x: Math.random() * canvas.width, y: Math.random() * canvas.height, speed: 1 + Math.random() * 2 });
      }
      function gameLoop() {
        if (!document.getElementById('mini-arcade-canvas')) return;
        ctx.fillStyle = '#030712';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#64748b';
        starsList.forEach(s => {
          ctx.fillRect(s.x, s.y, 2, 2);
          s.y += s.speed;
          if (s.y > canvas.height) { s.y = 0; s.x = Math.random() * canvas.width; }
        });
        ctx.fillStyle = '#00f0ff';
        ctx.shadowColor = '#00f0ff';
        ctx.shadowBlur = 12;
        ctx.beginPath();
        ctx.moveTo(playerX, playerY);
        ctx.lineTo(playerX - 12, playerY + 20);
        ctx.lineTo(playerX + 12, playerY + 20);
        ctx.closePath();
        ctx.fill();
        ctx.shadowBlur = 0;
        ctx.fillStyle = '#00ff88';
        ctx.fillRect(playerX - 3, playerY + 22, 6, 6);
        requestAnimationFrame(gameLoop);
      }
      gameLoop();
    }

    window.gameTapMove = function(action) {
      if (action === 'left') { playerX = Math.max(20, playerX - 25); }
      else if (action === 'right') { playerX = Math.min(280, playerX + 25); }
      else if (action === 'jump') {
        State.liveData.gameScore += 10;
        if (State.liveData.gameScore > State.liveData.gameHigh) State.liveData.gameHigh = State.liveData.gameScore;
        const scoreEl = document.getElementById('game-score-readout');
        if (scoreEl) scoreEl.textContent = State.liveData.gameScore;
      }
      window.playMatrixChime();
    };

