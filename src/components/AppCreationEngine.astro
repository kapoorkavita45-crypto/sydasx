    // ═══ SAVE & LOAD SYSTEM ═══
    window.pgSaveCurrentGame = function() {
      if (!pixelGameState) return;
      const saveData = {
        stageIndex: pixelGameState.stageIndex,
        score: pixelGameState.score,
        highScore: Math.max(pixelGameState.highScore, pixelGameState.score),
        totalKills: pixelGameState.totalKills,
        credits: pixelGameState.credits,
        selectedCharIndex: pixelGameState.selectedCharIndex,
        selectedWeaponIndex: pixelGameState.selectedWeaponIndex,
        selectedMapIndex: pixelGameState.selectedMapIndex,
        savedAt: new Date().toISOString()
      };
      try {
        localStorage.setItem('SYDASX_PIXEL_COMBAT_SAVE', JSON.stringify(saveData));
        showToast('PROGRESS SAVED (STAGE ' + pixelGameState.stageIndex + ') 💾');
      } catch (e) {
        showToast('PROGRESS SAVED 💾');
      }
      window.playMatrixChime();
    };

    window.pgLoadSavedGame = function() {
      try {
        const raw = localStorage.getItem('SYDASX_PIXEL_COMBAT_SAVE');
        if (raw) {
          const data = JSON.parse(raw);
          pixelGameState.stageIndex = data.stageIndex || 1;
          pixelGameState.score = data.score || 0;
          pixelGameState.highScore = data.highScore || 0;
          pixelGameState.totalKills = data.totalKills || 0;
          pixelGameState.credits = data.credits || 1000;
          pixelGameState.selectedCharIndex = data.selectedCharIndex || 0;
          pixelGameState.selectedWeaponIndex = data.selectedWeaponIndex || 0;
          pixelGameState.selectedMapIndex = data.selectedMapIndex || 0;

          const stEl = document.getElementById('menu-stat-stage');
          if (stEl) stEl.textContent = `${pixelGameState.stageIndex}-1`;
          
          showToast('SAVE LOADED: STAGE ' + pixelGameState.stageIndex + ' 📂');
          window.pgStartGameSession();
          return;
        }
      } catch (e) {}
      showToast('NO SAVE FILE FOUND! STARTING STAGE 1');
      window.pgOpenCharSelect();
    };

    function showToast(msg) {
      const toast = document.getElementById('pg-toast-banner');
      if (!toast) return;
      toast.textContent = msg;
      toast.style.opacity = '1';
      setTimeout(() => { if (toast) toast.style.opacity = '0'; }, 2000);
    }

    // ═══ START GAME SESSION (DEPLOY INTO 30X MAP 1v1 DUEL) ═══
    window.pgStartGameSession = function() {
      document.getElementById('pg-wep-screen').style.display = 'none';
      document.getElementById('pg-menu-screen').style.display = 'none';
      document.getElementById('pg-gameover-screen').style.display = 'none';
      
      const char = getSelectedChar();
      const wep = getSelectedWeapon();
      const map = getSelectedMap();

      pixelGameState.screen = 'game';
      
      // Auto-trigger smooth edge-to-edge tilt on start
      const casing = document.getElementById('phone-casing');
      const grid = document.querySelector('.blueprint-dashboard-grid');
      if (casing && !casing.classList.contains('tilted-landscape')) {
        casing.classList.add('tilted-landscape');
        if (grid) grid.classList.add('tilted-grid');
        const btn = document.getElementById('btn-toggle-tilt');
        if (btn) btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline-block; vertical-align:middle; margin-right:4px;"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"></rect><path d="M18 12h.01"></path></svg><span>PORTRAIT 📱</span>';
      }

      // 1. PLAYER STARTS AT THE FAR LEFT END (x = 120)
      pixelGameState.player.x = 120;
      pixelGameState.player.y = 330;
      pixelGameState.player.prevY = 330;
      pixelGameState.player.vx = 0;
      pixelGameState.player.vy = 0;
      pixelGameState.player.hp = 100 * char.hpMultiplier;
      pixelGameState.player.maxHp = 100 * char.hpMultiplier;
      pixelGameState.player.nitro = 100;
      pixelGameState.player.speed = char.speed;
      pixelGameState.player.grenades = 3;
      pixelGameState.bullets = [];
      pixelGameState.grenadesList = [];
      pixelGameState.particles = [];
      
      pixelGameState.stageTargetKills = 5;
      pixelGameState.stageCurrentKills = 0;

      // 2. SINGLE ENEMY BOT SPAWNS AT THE FAR RIGHT OPPOSITE END (x = 5750)
      spawnSingle1v1Bot(pixelGameState.worldWidth - 250);

      // Update HUD Elements
      const hAvatar = document.getElementById('hud-hero-avatar');
      const hName = document.getElementById('hud-weapon-name');
      const hAmmo = document.getElementById('hud-ammo-cur');
      const hStage = document.getElementById('hud-stage-name');
      const hKills = document.getElementById('hud-target-kills');
      const hMax = document.getElementById('hud-target-max');

      if (hAvatar) hAvatar.textContent = char.avatarText;
      if (hName) hName.textContent = wep.name;
      if (hAmmo) hAmmo.textContent = wep.ammo;
      if (hStage) hStage.textContent = `STAGE ${pixelGameState.stageIndex} • ${map.name}`;
      if (hKills) hKills.textContent = '0';
      if (hMax) hMax.textContent = pixelGameState.stageTargetKills;

      window.playMatrixChime();
    };

    function spawnSingle1v1Bot(spawnX) {
      if (!pixelGameState) return;
      const botNames = ['OMEGA TITAN', 'VIPER SHADOW', 'REAPER CYBORG', 'PHANTOM ELITE', 'RAVAGER X'];
      const name = botNames[Math.min(pixelGameState.stageCurrentKills, botNames.length - 1)];

      pixelGameState.bot = {
        name,
        x: spawnX,
        y: 330,
        prevY: 330,
        vx: -1.4 - Math.random() * 0.5, // Moves towards player
        vy: 0,
        w: 18,
        h: 26,
        hp: 80 + pixelGameState.stageIndex * 25,
        maxHp: 80 + pixelGameState.stageIndex * 25,
        nitro: 100, // LIMITED JETPACK NITRO FOR BOT
        maxNitro: 100,
        shootCooldown: 60 + Math.floor(Math.random() * 40),
        shootTimer: 0,
        isFlying: false,
        isGrounded: true,
        flyTimer: 0,
        facing: -1
      };
    }

