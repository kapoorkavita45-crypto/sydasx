            <button onclick="window.addNewTaskItem()" style="background: #00ff88; color: #05070d; font-weight: 800; border: none; border-radius: 8px; padding: 0.4rem 0.7rem; font-size: 0.75rem; cursor: pointer;">+ ADD</button>
          </div>
