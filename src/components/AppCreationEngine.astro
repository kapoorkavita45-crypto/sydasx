    window.startMatrixCompilation = function() {
      window.goToMatrixStep(3);

      const appName = State.appName || 'Nexus Protocol';
      const category = State.selectedCategory || MATRIX_CATEGORIES[0];
      const tech = State.techType;

      const appNameEl = document.getElementById('compiling-app-name');
      if (appNameEl) appNameEl.textContent = appName;

      const terminalLogs = document.getElementById('terminal-logs');
      const progressBar = document.getElementById('forge-progress-bar');
      const percentageText = document.getElementById('compile-percentage');
      const actionText = document.getElementById('compile-current-action');

      if (terminalLogs) terminalLogs.innerHTML = '';
      if (progressBar) progressBar.style.width = '0%';
      if (percentageText) percentageText.textContent = '0%';

      const steps = [
        { pct: 15, msg: `Initializing Genesis Virtual Core for [${appName}]...`, action: 'Allocating Distributed GPU Shards...' },
        { pct: 30, msg: `Injecting [${category.name}] domain schemas & security protocols...`, action: 'Synthesizing Data Pipeline...' },
        { pct: 50, msg: `Configuring ${tech.toUpperCase()} runtime binaries & WebRTC channels...`, action: `Compiling ${tech.toUpperCase()} Toolchain...` },
        { pct: 70, msg: `Benchmarking load tolerance for ${State.userScaleLabels[State.userScaleIndex - 1]} concurrency...`, action: 'Stress Testing Virtual Nodes...' },
        { pct: 88, msg: `Optimizing memory buffers for ${State.complexityStars}★ feature complexity...`, action: 'Finalizing Latency Tuning...' },
        { pct: 100, msg: `SUCCESS: System Blueprint [${appName}.x] forged and verified.`, action: 'Compiling Completed!' }
      ];

      let currentStepIndex = 0;

      function runNextStep() {
        if (currentStepIndex >= steps.length) {
          setTimeout(() => {
            window.goToMatrixStep(4);
          }, 600);
          return;
        }

        const step = steps[currentStepIndex];
        if (progressBar) progressBar.style.width = `${step.pct}%`;
        if (percentageText) percentageText.textContent = `${step.pct}%`;
        if (actionText) actionText.textContent = step.action;

        if (terminalLogs) {
          const logEntry = document.createElement('div');
          logEntry.className = "log-row";
          logEntry.innerHTML = `
            <span style="color: ${step.pct === 100 ? '#00ff88' : '#e2e8f0'};">> ${step.msg}</span>
            <span style="color: #64748b; font-size: 0.68rem;">${new Date().toISOString().substring(14, 22)}</span>
          `;
          terminalLogs.prepend(logEntry);
        }

        currentStepIndex++;
        setTimeout(runNextStep, 500);
      }

      runNextStep();
    };

