  /* STEP 3 FORGE */
  .step3-forge-container {
    max-width: 850px;
    margin: 0 auto;
  }

  .forge-hud-card {
    padding: 3rem 2.5rem;
    border-radius: 20px;
    background: rgba(15, 20, 36, 0.85);
    border: 1px solid rgba(0, 240, 255, 0.35);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
