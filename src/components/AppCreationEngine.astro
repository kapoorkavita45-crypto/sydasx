  /* Full Screen 2-Column Dashboard Grid */
  .blueprint-dashboard-grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 2rem;
    width: 100%;
    align-items: start;
  }

  /* Phone Column */
  .blueprint-phone-col {
    display: flex;
    justify-content: center;
  }

  .mobile-phone-casing {
    width: 360px;
    max-width: 100%;
    background: #0a0d18;
    border: 4px solid #1e293b;
    border-radius: 44px;
    padding: 0.85rem 0.75rem;
    box-shadow: 0 25px 60px rgba(0, 240, 255, 0.25), 0 0 40px rgba(0, 255, 136, 0.15);
    position: relative;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: center center;
    will-change: width, max-width, transform;
  }

  /* EDGE-TO-EDGE EXPANSIVE LANDSCAPE ARCADE EXPERIENCE */
  .mobile-phone-casing.tilted-landscape {
    width: 100% !important;
    max-width: 1120px !important;
    min-height: 520px !important;
    padding: 0.85rem 2.8rem !important;
    border-radius: 32px !important;
    border-color: rgba(0, 240, 255, 0.45) !important;
    box-shadow: 0 35px 100px rgba(0, 240, 255, 0.35), 0 0 80px rgba(0, 255, 136, 0.2) !important;
    animation: phonePhysicalTilt 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .mobile-phone-casing.tilted-landscape .phone-screen-display {
    min-height: 500px !important;
    max-height: none !important;
    width: 100% !important;
    padding: 0.85rem !important;
  }

  .mobile-phone-casing.tilted-landscape #pixel-game-root {
    max-width: 100% !important;
    width: 100% !important;
  }

  .mobile-phone-casing.tilted-landscape #pixel-canvas-wrapper {
    height: 440px !important;
    width: 100% !important;
  }

  .mobile-phone-casing.tilted-landscape .phone-speaker-notch {
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    margin: 0;
    background: #05070d;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .mobile-phone-casing.tilted-landscape .phone-home-indicator {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    margin: 0;
    width: 90px;
  }

  .blueprint-dashboard-grid.tilted-grid {
    grid-template-columns: 1fr !important;
    width: 100% !important;
  }

  @keyframes phonePhysicalTilt {
    0% { transform: scale(0.92) rotate(0deg); opacity: 0.9; }
    35% { transform: scale(1.02) rotate(-3.5deg); }
    70% { transform: scale(1.005) rotate(1.5deg); }
    100% { transform: scale(1) rotate(0deg); opacity: 1; }
  }

  .phone-speaker-notch {
    width: 90px;
    height: 16px;
    background: #05070d;
    border-radius: 9999px;
    margin: 0 auto 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
