---
---

<section id="builder" class="builder-section">
  <!-- Full Width Edge-to-Edge Ambient Glows -->
  <div class="builder-glow cyan-glow"></div>
  <div class="builder-glow purple-glow"></div>

  <div class="container">
    
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- STEP 1: BRAND NAME INPUT                                       -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <div id="step-1" class="builder-step active">
      <div class="section-header">
        <h2 class="section-title">
          The <span class="text-gradient">Genesis</span> Matrix
        </h2>
        <p class="section-subtitle">
          Industry-grade AI website architect powered by Google Gemini 2.5 Pro.<br/>
          Built by a team of 100 senior engineers at the world's #1 company.
        </p>
      </div>

      <div class="step-card glass-panel">
        <div class="wizard-header">
          <span class="wizard-step-badge">STEP 1 OF 3</span>
          <h3 class="wizard-title">What's Your Brand Name?</h3>
          <p class="wizard-subtitle">Enter the name of your brand or company to initialize your digital architecture.</p>
        </div>

        <div class="brand-input-container">
          <label for="brand-name-input" class="glow-label">Brand Name</label>
          <input type="text" id="brand-name-input" class="cyber-input brand-mega-input" placeholder="e.g. Nike, Zara, Deloitte, Emirates..." maxlength="60" />
          <div class="brand-input-hint">This will appear as your brand title, header logo, catalog items, and order receipts.</div>
        </div>

        <button id="btn-to-step2" class="btn btn-primary btn-block" style="margin-top: 1.5rem;" disabled>
          <span>Continue to Industry Selection →</span>
        </button>
      </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- STEP 2: INDUSTRY / COMPANY TYPE SELECTION                      -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <div id="step-2" class="builder-step hidden">
      <div class="section-header">
        <h2 class="section-title">
          Select Your <span class="text-gradient">Industry</span>
        </h2>
        <p class="section-subtitle">
          Choose your company vertical. E-Commerce includes 100% Cash-on-Delivery checkout and digital receipt generation. Other verticals generate industry-tailored consultation, booking, and quotation systems.
        </p>
      </div>

      <div class="step-card glass-panel">
        <div class="wizard-header">
          <span class="wizard-step-badge">STEP 2 OF 3</span>
          <h3 class="wizard-title">Company Type</h3>
          <p class="wizard-subtitle">Select the industry that best matches your business.</p>
        </div>

        <div class="industry-grid" id="industry-grid">
          <!-- Footwear -->
          <button class="industry-card" data-industry="footwear">
            <div class="ind-icon" style="color:#ff4d00;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 1.515a3 3 0 0 0-3 0L3.91 5.25a3 3 0 0 0-1.5 2.598v7.304a3 3 0 0 0 1.5 2.598l6.59 3.735a3 3 0 0 0 3 0l6.59-3.735a3 3 0 0 0 1.5-2.598V7.848a3 3 0 0 0-1.5-2.598L13.5 1.515z"/></svg>
            </div>
            <h4 class="ind-title">Footwear</h4>
            <p class="ind-examples">Like Nike, Adidas, New Balance</p>
          </button>

          <!-- Clothing -->
          <button class="industry-card" data-industry="clothing">
            <div class="ind-icon" style="color:#e2c08d;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M16 21H8a1 1 0 0 1-1-1V8L2 3h20l-5 5v12a1 1 0 0 1-1 1z"/></svg>
            </div>
            <h4 class="ind-title">Clothing</h4>
            <p class="ind-examples">Like Zara, H&M, Gucci</p>
          </button>

          <!-- E-Commerce -->
          <button class="industry-card" data-industry="ecommerce">
            <div class="ind-icon" style="color:#3b82f6;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0 0 20.01 5H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
            </div>
            <h4 class="ind-title">E-Commerce</h4>
            <p class="ind-examples">Like Flipkart, Amazon, Shopify</p>
          </button>

          <!-- IT & Consulting -->
          <button class="industry-card" data-industry="it">
            <div class="ind-icon" style="color:#00d4aa;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M20 18c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z"/></svg>
            </div>
            <h4 class="ind-title">IT & Consulting</h4>
            <p class="ind-examples">Like Deloitte, Cognizant, Accenture</p>
          </button>

          <!-- Jewellery -->
          <button class="industry-card" data-industry="jewellery">
            <div class="ind-icon" style="color:#d4af37;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L6 8.5l6 13.5 6-13.5L12 2zm0 3.5L14.5 8h-5L12 5.5z"/></svg>
            </div>
            <h4 class="ind-title">Jewellery</h4>
            <p class="ind-examples">Like Swarovski, Tanishq, Tiffany</p>
          </button>

          <!-- Dine-In -->
          <button class="industry-card" data-industry="dinein">
            <div class="ind-icon" style="color:#c8553d;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8.1 13.34l2.83-2.83L3.91 3.5c-1.56 1.56-1.56 4.09 0 5.66l4.19 4.18zm6.78-1.81c1.53.71 3.68.21 5.27-1.38 1.91-1.91 2.28-4.65.81-6.12-1.46-1.46-4.2-1.1-6.12.81-1.59 1.59-2.09 3.74-1.38 5.27L3.7 19.87l1.41 1.41L12 14.41l6.88 6.88 1.41-1.41L13.41 13.0l1.47-1.47z"/></svg>
            </div>
            <h4 class="ind-title">Dine-In</h4>
            <p class="ind-examples">Like Black + Blue, Nobu</p>
          </button>

          <!-- Hotels -->
          <button class="industry-card" data-industry="hotels">
            <div class="ind-icon" style="color:#b08d57;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M7 13c1.66 0 3-1.34 3-3S8.66 7 7 7s-3 1.34-3 3 1.34 3 3 3zm12-6h-8v7H3V5H1v15h2v-3h18v3h2v-9c0-2.21-1.79-4-4-4z"/></svg>
            </div>
            <h4 class="ind-title">Hotels</h4>
            <p class="ind-examples">Like Marriott, Four Seasons, Ritz</p>
          </button>

          <!-- Restaurants -->
          <button class="industry-card" data-industry="restaurants">
            <div class="ind-icon" style="color:#e8a838;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2v7zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4z"/></svg>
            </div>
            <h4 class="ind-title">Restaurants</h4>
            <p class="ind-examples">Like McDonald's, Chipotle, Subway</p>
          </button>

          <!-- Portfolios -->
          <button class="industry-card" data-industry="portfolios">
            <div class="ind-icon" style="color:#a78bfa;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
            </div>
            <h4 class="ind-title">Portfolios</h4>
            <p class="ind-examples">Personal & Creative Portfolios</p>
          </button>

          <!-- Security -->
          <button class="industry-card" data-industry="security">
            <div class="ind-icon" style="color:#22d3ee;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
            </div>
            <h4 class="ind-title">Security</h4>
            <p class="ind-examples">Like Paragon, CrowdStrike, Palo Alto</p>
          </button>

          <!-- Grocery -->
          <button class="industry-card" data-industry="grocery">
            <div class="ind-icon" style="color:#22c55e;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M15.55 13c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0 0 20.01 4H5.21l-.94-2H1v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96C5 16.1 5.9 17 7 17h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45zM6.16 6h12.15l-2.76 5H8.53L6.16 6zM7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/></svg>
            </div>
            <h4 class="ind-title">Grocery Store</h4>
            <p class="ind-examples">Like No Frills, Whole Foods, Costco</p>
          </button>

          <!-- Construction -->
          <button class="industry-card" data-industry="construction">
            <div class="ind-icon" style="color:#f59e0b;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M13 3v2h-2V3h2zm-6 2V3H5v2h2zm12 0V3h-2v2h2zM3 21h18v-2H3v2zM3 9v10h2V9H3zm16 10V9h2v10h-2zM7 19V9h10v10H7z"/></svg>
            </div>
            <h4 class="ind-title">Construction</h4>
            <p class="ind-examples">Like Turner, Bechtel, Skanska</p>
          </button>

          <!-- Machinery -->
          <button class="industry-card" data-industry="machinery">
            <div class="ind-icon" style="color:#eab308;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
            </div>
            <h4 class="ind-title">Machinery</h4>
            <p class="ind-examples">Like CAT, John Deere, Komatsu</p>
          </button>

          <!-- Aerospace -->
          <button class="industry-card" data-industry="aerospace">
            <div class="ind-icon" style="color:#dc2626;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z"/></svg>
            </div>
            <h4 class="ind-title">Aerospace</h4>
            <p class="ind-examples">Like Emirates, Air Canada, Boeing</p>
          </button>

          <!-- Fun & Entertainment -->
          <button class="industry-card" data-industry="entertainment">
            <div class="ind-icon" style="color:#f472b6;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            </div>
            <h4 class="ind-title">Entertainment</h4>
            <p class="ind-examples">Like Wonderland, Disney, Six Flags</p>
          </button>
        </div>

        <div class="step2-nav-bar">
          <button id="btn-back-step1" class="btn btn-outline">
            <span>← Back</span>
          </button>
        </div>
      </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- STEP 3: STYLING & CUSTOMIZATION STUDIO                         -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <div id="step-3" class="builder-step hidden">
      <div class="section-header">
        <h2 class="section-title">
          Customize <span class="text-gradient">Aesthetic & Theme</span>
        </h2>
        <p class="section-subtitle">
          Choose your website's background color, tab/accent styling, and typography font.
        </p>
      </div>

      <div class="step-card glass-panel">
        <div class="wizard-header">
          <span class="wizard-step-badge">STEP 3 OF 3</span>
          <h3 class="wizard-title">Design Studio</h3>
          <p class="wizard-subtitle">Tailor the visual identity for <strong id="studio-brand-label" class="text-gradient">Your Brand</strong>.</p>
        </div>

        <!-- 1. Background Color Options -->
        <div class="style-section-block">
          <label class="glow-label">1. Background Color Palette</label>
          <div class="color-swatches-grid" id="bg-swatches-grid">
            <button type="button" class="swatch-btn active" data-color="#08090d" style="background: #08090d;" title="Void Onyx">
              <span class="swatch-name">Void Onyx</span>
            </button>
            <button type="button" class="swatch-btn" data-color="#060e1e" style="background: #060e1e;" title="Cyber Navy">
              <span class="swatch-name">Cyber Navy</span>
            </button>
            <button type="button" class="swatch-btn" data-color="#0d0818" style="background: #0d0818;" title="Obsidian Purple">
              <span class="swatch-name">Obsidian</span>
            </button>
            <button type="button" class="swatch-btn" data-color="#06130e" style="background: #06130e;" title="Emerald Noir">
              <span class="swatch-name">Emerald Noir</span>
            </button>
            <button type="button" class="swatch-btn" data-color="#16080a" style="background: #16080a;" title="Crimson Stealth">
              <span class="swatch-name">Crimson</span>
            </button>
            <button type="button" class="swatch-btn" data-color="#121316" style="background: #121316;" title="Carbon Titanium">
              <span class="swatch-name">Carbon</span>
            </button>
            <button type="button" class="swatch-btn" data-color="#140b07" style="background: #140b07;" title="Sunset Amber">
              <span class="swatch-name">Sunset</span>
            </button>
            <button type="button" class="swatch-btn" data-color="#0a0a0a" style="background: #0a0a0a;" title="Pure Charcoal">
              <span class="swatch-name">Charcoal</span>
            </button>
            <button type="button" class="swatch-btn light-swatch" data-color="#f8fafc" style="background: #f8fafc; color: #0f172a;" title="Soft Pearl">
              <span class="swatch-name">Soft Pearl</span>
            </button>
            <button type="button" class="swatch-btn light-swatch" data-color="#faf7f2" style="background: #faf7f2; color: #0f172a;" title="Champagne Luxury">
              <span class="swatch-name">Champagne</span>
            </button>
          </div>
        </div>

        <!-- 2. Tab & Accent Colors Options -->
        <div class="style-section-block" style="margin-top: 1.5rem;">
          <label class="glow-label">2. Tab & Accent Colors</label>
          <div class="color-swatches-grid" id="accent-swatches-grid">
            <button type="button" class="swatch-btn active" data-accent="#00f0ff" style="background: #00f0ff; color: #000;" title="Electric Cyan">
              <span class="swatch-name">Electric Cyan</span>
            </button>
            <button type="button" class="swatch-btn" data-accent="#a855f7" style="background: #a855f7; color: #fff;" title="Neon Purple">
              <span class="swatch-name">Neon Purple</span>
            </button>
            <button type="button" class="swatch-btn" data-accent="#10b981" style="background: #10b981; color: #fff;" title="Hyper Emerald">
              <span class="swatch-name">Emerald</span>
            </button>
            <button type="button" class="swatch-btn" data-accent="#eab308" style="background: #eab308; color: #000;" title="Solar Gold">
              <span class="swatch-name">Solar Gold</span>
            </button>
            <button type="button" class="swatch-btn" data-accent="#ff5722" style="background: #ff5722; color: #fff;" title="Flame Orange">
              <span class="swatch-name">Flame Orange</span>
            </button>
            <button type="button" class="swatch-btn" data-accent="#ef4444" style="background: #ef4444; color: #fff;" title="Laser Crimson">
              <span class="swatch-name">Laser Crimson</span>
            </button>
            <button type="button" class="swatch-btn" data-accent="#3b82f6" style="background: #3b82f6; color: #fff;" title="Hyper Blue">
              <span class="swatch-name">Hyper Blue</span>
            </button>
            <button type="button" class="swatch-btn" data-accent="#ec4899" style="background: #ec4899; color: #fff;" title="Neon Pink">
              <span class="swatch-name">Neon Pink</span>
            </button>
            <button type="button" class="swatch-btn" data-accent="#84cc16" style="background: #84cc16; color: #000;" title="Acid Lime">
              <span class="swatch-name">Acid Lime</span>
            </button>
            <button type="button" class="swatch-btn" data-accent="#e2c08d" style="background: #e2c08d; color: #000;" title="Rose Gold">
              <span class="swatch-name">Rose Gold</span>
            </button>
          </div>
        </div>

        <!-- 3. Font Typography Selection -->
        <div class="style-section-block" style="margin-top: 1.5rem;">
          <label class="glow-label">3. Typography & Font Style</label>
          <div class="font-selection-grid" id="font-selection-grid">
            <button type="button" class="font-card-btn active" data-font="inter" style="font-family: 'Inter', sans-serif;">
              <span class="font-title">Inter Modern</span>
              <span class="font-sample">Clean, balanced & highly readable</span>
            </button>
            <button type="button" class="font-card-btn" data-font="outfit" style="font-family: 'Outfit', sans-serif;">
              <span class="font-title">Outfit Sleek</span>
              <span class="font-sample">Futuristic, geometric & bold</span>
            </button>
            <button type="button" class="font-card-btn" data-font="space" style="font-family: 'Space Grotesk', sans-serif;">
              <span class="font-title">Space Grotesk</span>
              <span class="font-sample">Cyberpunk, high-tech & mechanical</span>
            </button>
            <button type="button" class="font-card-btn" data-font="playfair" style="font-family: 'Playfair Display', serif;">
              <span class="font-title">Playfair Luxury</span>
              <span class="font-sample">High couture, editorial & elegant serif</span>
            </button>
            <button type="button" class="font-card-btn" data-font="mono" style="font-family: 'JetBrains Mono', monospace;">
              <span class="font-title">JetBrains Mono</span>
              <span class="font-sample">Developer code, matrix & monospace</span>
            </button>
            <button type="button" class="font-card-btn" data-font="jakarta" style="font-family: 'Plus Jakarta Sans', sans-serif;">
              <span class="font-title">Plus Jakarta</span>
              <span class="font-sample">Neo-grotesque modern digital aesthetic</span>
            </button>
            <button type="button" class="font-card-btn" data-font="syne" style="font-family: 'Syne', sans-serif;">
              <span class="font-title">Syne Avant-Garde</span>
              <span class="font-sample">High impact, daring & artistic display</span>
            </button>
            <button type="button" class="font-card-btn" data-font="montserrat" style="font-family: 'Montserrat', sans-serif;">
              <span class="font-title">Montserrat</span>
              <span class="font-sample">Universal, premium & corporate</span>
            </button>
          </div>
        </div>

        <div class="step3-nav-bar" style="margin-top: 2rem; display: flex; justify-content: space-between; gap: 1rem;">
          <button id="btn-back-step2" class="btn btn-outline">
            <span>← Back to Industries</span>
          </button>
          <button id="btn-launch-ide" class="btn btn-primary">
            <span>Launch Antigravity IDE & Synthesize →</span>
          </button>
        </div>
      </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- STEP 4: ANTIGRAVITY IDE WORKSPACE (LIVE PREVIEW & CODE)        -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <div id="antigravity-ide" class="antigravity-ide-container hidden">
      
      <!-- Top IDE Toolbar Header -->
      <div class="ide-toolbar glass-panel">
        <div class="ide-brand">
          <span class="ide-brand-title">ANTIGRAVITY <span class="text-gradient">IDE</span></span>
          <span id="ide-platform-badge" class="ide-platform-tag">Multi-Scroll Web Architecture</span>
        </div>

        <div class="ide-status-center">
          <div class="ai-sync-indicator">
            <span class="pulse-dot"></span>
            <span>Google Gemini 2.5 Pro (Synced)</span>
          </div>
          <div class="ide-credits-badge">
            <span id="ide-credits-count" class="text-gradient">5 / 5 Build Tries</span>
          </div>
        </div>

        <div class="ide-toolbar-actions" style="display: flex; gap: 0.5rem;">
          <button id="btn-gemini-key" class="btn btn-outline btn-xs" title="Configure Google Gemini API Key">
            <span>Gemini API Key</span>
          </button>
          <button id="btn-switch-platform" class="btn btn-outline btn-xs">
