---
---

<section id="builder" class="builder-section">
  <!-- Full Width Edge-to-Edge Ambient Glows -->
  <div class="builder-glow cyan-glow"></div>
  <div class="builder-glow purple-glow"></div>

  <div class="container">
    
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- VIEW 1: PLATFORM SELECTION ("LET'S BUILD")                      -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <div id="step-1" class="builder-step active">
      <div class="section-header">
        <h2 class="section-title">
          The <span class="text-gradient">Genesis</span> Matrix
        </h2>
        <p class="section-subtitle">
          Universal AI prompt-based architecture engine synced with Google Gemini 2.5 Pro.
        </p>
      </div>

      <div class="step-card glass-panel">
        <div class="wizard-header">
          <span class="wizard-step-badge">STEP 1 OF 2</span>
          <h3 class="wizard-title">Let's Build</h3>
          <p class="wizard-subtitle">Select your target platform architecture to launch the Antigravity IDE.</p>
        </div>

        <div class="platform-cards-grid">
          <button class="platform-card" data-platform="Web">
            <h4 class="p-card-title">Web App / Website</h4>
            <p class="p-card-desc">SaaS platforms, e-commerce, portfolios, dashboards & web tools.</p>
            <span class="p-card-action">Launch Web IDE →</span>
          </button>

          <button class="platform-card" data-platform="Mobile">
            <h4 class="p-card-title">Mobile App (iOS / Android)</h4>
            <p class="p-card-desc">Native smartphones UI, gesture controls, tab bars & mobile widgets.</p>
            <span class="p-card-action">Launch Mobile IDE →</span>
          </button>

          <button class="platform-card" data-platform="Desktop">
            <h4 class="p-card-title">Desktop Software (Win / Mac)</h4>
            <p class="p-card-desc">Standalone workstation apps, IDEs, media tools & system monitors.</p>
            <span class="p-card-action">Launch Desktop IDE →</span>
          </button>

          <button class="platform-card" data-platform="Game">
            <h4 class="p-card-title">Interactive 3D / WebGL Game</h4>
            <p class="p-card-desc">Playable HTML5 Canvas games, space shooters, puzzles & platformers.</p>
            <span class="p-card-action">Launch Game IDE →</span>
          </button>
        </div>
      </div>
    </div>


    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- VIEW 2: ANTIGRAVITY IDE WORKSPACE (SYNCED WITH GEMINI AI)       -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <div id="antigravity-ide" class="antigravity-ide-container hidden">
      
      <!-- Top IDE Toolbar Header -->
      <div class="ide-toolbar glass-panel">
        <div class="ide-brand">
          <span class="ide-brand-title">ANTIGRAVITY <span class="text-gradient">IDE</span></span>
          <span id="ide-platform-badge" class="ide-platform-tag">Web App Workspace</span>
        </div>

        <div class="ide-status-center">
          <div class="ai-sync-indicator">
            <span class="pulse-dot"></span>
            <span>Google Gemini 2.5 Pro (Synced)</span>
          </div>
          <div class="ide-credits-badge">
            <span id="ide-credits-count" class="text-gradient">5 / 5 Build Tries</span>
          </div>
        </div>

        <div class="ide-toolbar-actions" style="display: flex; gap: 0.5rem;">
          <button id="btn-gemini-key" class="btn btn-outline btn-xs" title="Configure Google Gemini API Key">
            <span>Gemini API Key</span>
          </button>
          <button id="btn-switch-platform" class="btn btn-outline btn-xs">
            <span>← Switch Platform</span>
          </button>
        </div>
      </div>

      <!-- Main IDE 2-Column Split Workspace -->
      <div class="ide-workspace-grid">
        
        <!-- ------------------------------------------------------------- -->
        <!-- LEFT COLUMN: GEMINI AI ASSISTANT CHAT & PROMPT PANEL         -->
        <!-- ------------------------------------------------------------- -->
        <div class="ide-sidebar glass-panel">
          <div class="sidebar-header">
            <div class="sidebar-title-group">
              <div>
                <h4 class="sidebar-title">Gemini AI Assistant</h4>
                <span class="sidebar-sub">Multimodal Code Synthesis Engine</span>
              </div>
            </div>
          </div>

          <!-- STATE 1: GMAIL AUTH GATE (BEFORE SIGN IN) -->
          <div id="ide-auth-gate" class="ide-auth-gate">
            <div class="auth-gate-card">
              <h4 class="auth-gate-title">Sync Gemini AI Assistant</h4>
              <p class="auth-gate-desc">
                Sign in with your Gmail to activate <strong class="text-gradient">Google Gemini 2.5 Pro</strong> and claim your <strong style="color: var(--accent-cyan);">5 Free AI Build Tries</strong>.
              </p>

              <button id="btn-gmail-signin" class="btn-gmail-google">
                <svg width="20" height="20" viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                </svg>
                <span>Sign in with Google / Gmail</span>
              </button>
            </div>
          </div>

          <!-- STATE 2: ACTIVE GEMINI CHAT INTERFACE (AFTER SIGN IN) -->
          <div id="ide-chat-active" class="ide-chat-active hidden">
            
            <!-- Gemini Chat Messages Log -->
            <div id="gemini-chat-history" class="gemini-chat-history">
              <div class="chat-msg gemini-msg">
                <div class="msg-avatar">AI</div>
                <div class="msg-body">
                  <div class="msg-sender">Google Gemini 2.5 Pro</div>
                  <div class="msg-text">
                    Hello! I'm synced and ready to synthesize your <strong id="chat-target-platform" class="text-gradient">Web App</strong>. Describe what you'd like to build below!
                  </div>
                </div>
              </div>
            </div>

            <!-- Quick Template Chips -->
            <div class="quick-templates">
              <span class="template-label">Quick Ideas:</span>
              <div id="template-chips" class="chips-row">
                <button class="chip-btn" data-prompt="Build a futuristic cyberpunk dashboard with live stats and dark glassmorphism">Cyberpunk Dashboard</button>
                <button class="chip-btn" data-prompt="Build a modern e-commerce store with product cards, filter tabs and cart modal">E-Commerce Store</button>
                <button class="chip-btn" data-prompt="Build an interactive SaaS analytics platform with telemetry charts and live search">SaaS Analytics</button>
              </div>
            </div>

            <!-- Prompt Input Form & Business Context Form -->
            <div class="ide-prompt-form">
              <div class="prompt-label-bar">
                <label for="ide-prompt-input" class="glow-label">Core Vision</label>
                <span id="word-count-badge" class="word-count-badge">0 / 100 words max</span>
              </div>
              <textarea id="ide-prompt-input" class="cyber-input" rows="2" placeholder="Describe whatever you want to build..."></textarea>

              <div id="word-count-warning" class="word-count-warning hidden" style="display: none;">
                Warning: Your prompt exceeds the 100-word limit (Current count: <span id="current-word-count">0</span> words). Please shorten your prompt to compile.
              </div>

              <!-- New Business Context Fields -->
              <div class="business-context-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-top: 1rem;">
                <div class="input-group">
                  <label for="ide-business-type" class="glow-label">Business Type</label>
                  <input type="text" id="ide-business-type" class="cyber-input" placeholder="e.g. Tech Startup" />
                </div>
                <div class="input-group">
                  <label for="ide-products" class="glow-label">Products / Services</label>
                  <input type="text" id="ide-products" class="cyber-input" placeholder="e.g. SaaS Analytics" />
                </div>
                <div class="input-group" style="grid-column: 1 / -1;">
                  <label for="ide-showcase" class="glow-label">Showcase Elements</label>
                  <input type="text" id="ide-showcase" class="cyber-input" placeholder="e.g. Pricing Table, Hero Video, Testimonials" />
                </div>
                <div class="input-group" style="grid-column: 1 / -1;">
                  <label for="ide-theme" class="glow-label">Theme Selection</label>
                  <select id="ide-theme" class="cyber-input">
                    <option value="Modern Corporate">Modern Corporate</option>
                    <option value="Neon Cyberpunk" selected>Neon Cyberpunk</option>
                    <option value="Playful & Vibrant">Playful & Vibrant</option>
                    <option value="Luxury Dark Mode">Luxury Dark Mode</option>
                    <option value="Minimalist Clean">Minimalist Clean</option>
                  </select>
                </div>
              </div>
              
              <div class="fancy-toggle-group" style="display: flex; align-items: center; gap: 10px; margin-top: 1rem;">
                <input type="checkbox" id="ide-fancy-toggle" class="cyber-checkbox" checked style="width: 20px; height: 20px; accent-color: #00f0ff; cursor: pointer;">
                <label for="ide-fancy-toggle" class="glow-label" style="font-size: 0.85rem; cursor: pointer; margin-bottom: 0;">Maximize Visual Flair (Glassmorphism & Animations)</label>
              </div>

              <button id="btn-compile-project" class="btn btn-primary btn-block" style="margin-top: 1rem;">
                <span>Synthesize with Gemini (Use 1 Try)</span>
              </button>
            </div>

          </div>

          <!-- STATE 3: OUT OF TRIES FORM (AFTER 5 TRIES EXHAUSTED) -->
          <div id="ide-tries-exhausted" class="ide-tries-exhausted hidden">
            <div class="exhausted-card">
              <div class="exhausted-badge">0 TRIES REMAINING</div>
              <h4 class="exhausted-title">You've Used All 5 Free Tries!</h4>
              <p class="exhausted-subtitle">
                Want to continue building or deploy your project into production? Transmit your project blueprints directly to our engineering team!
              </p>

              <form id="transmit-blueprint-form" class="blueprint-form">
                <div class="input-group">
                  <label for="bp-name" class="glow-label">Your Name</label>
                  <input type="text" id="bp-name" class="cyber-input" required placeholder="Alex Mercer" />
                </div>

                <div class="input-group" style="margin-top: 0.75rem;">
                  <label for="bp-email" class="glow-label">Your Email</label>
                  <input type="email" id="bp-email" class="cyber-input" required placeholder="alex@gmail.com" />
                </div>

                <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1rem;">
                  <span>Transmit Blueprint & GET IN TOUCH →</span>
                </button>

                <button type="button" id="btn-reset-tries" class="btn btn-outline btn-block" style="margin-top: 0.75rem; border-color: #00f0ff; color: #00f0ff;">
                  <span>⚡ Reset & Get 5 Free Build Tries</span>
                </button>
              </form>
            </div>
          </div>

        </div>


        <!-- ------------------------------------------------------------- -->
        <!-- RIGHT COLUMN: MAIN IDE WORKSPACE (LIVE PREVIEW & CODE TABS)   -->
        <!-- ------------------------------------------------------------- -->
        <div class="ide-workspace-main glass-panel">
          
          <!-- Workspace Header Navigation Tabs -->
          <div class="workspace-tabs-bar">
            <div class="tabs-group">
              <button class="ws-tab-btn active" data-tab="tab-sandbox">
                <span>Live App Sandbox</span>
              </button>
              <button class="ws-tab-btn" data-tab="tab-code">
                <span>Source Code</span>
              </button>
              <button class="ws-tab-btn" data-tab="tab-specs">
                <span>Architecture Specs</span>
              </button>
              <button class="ws-tab-btn" data-tab="tab-console">
                <span>Console Logs</span>
              </button>
            </div>

            <div class="sandbox-controls">
              <button id="btn-device-desktop" class="device-btn active" title="Desktop View">Desktop</button>
              <button id="btn-device-mobile" class="device-btn" title="Mobile Device View">Mobile</button>
              <button id="btn-reload-sandbox" class="device-btn" title="Reload Sandbox">Reload</button>
            </div>
          </div>


          <!-- TAB 1: LIVE APP SANDBOX PREVIEW -->
          <div id="tab-sandbox" class="ws-tab-content active">
            <div class="sandbox-container" id="sandbox-wrapper">
              <!-- Live Compiled App IFrame -->
              <iframe id="sandbox-iframe" class="sandbox-iframe" title="SYDAS.x Genesis Live Sandbox"></iframe>
              
              <!-- Processing Overlay -->
              <div id="sandbox-loader" class="sandbox-loader hidden">
                <div class="spinner-neon"></div>
                <h4 class="loader-text">Synthesizing Architecture with Gemini 2.5...</h4>
                <p id="loader-status-sub" class="loader-sub">Generating HTML5 layout, CSS styling & JS logic...</p>
              </div>
            </div>
          </div>


          <!-- TAB 2: SOURCE CODE EXPLORER -->
          <div id="tab-code" class="ws-tab-content hidden">
            <div class="code-explorer-grid">
              <div class="code-file-tree">
                <div class="tree-header">FILES</div>
                <button class="file-btn active" data-file="html">index.html</button>
                <button class="file-btn" data-file="css">styles.css</button>
                <button class="file-btn" data-file="js">app.js</button>
              </div>
              <div class="code-viewer-container">
                <pre id="code-display" class="code-pre"><code id="code-content">Select a file from the left to view generated source code.</code></pre>
              </div>
            </div>
          </div>


          <!-- TAB 3: ARCHITECTURE SPECIFICATIONS -->
          <div id="tab-specs" class="ws-tab-content hidden">
            <div class="specs-panel">
              <h4 class="specs-title text-gradient">AI Architecture Specification Blueprint</h4>
              
              <div class="specs-grid">
                <div class="spec-card">
                  <span class="spec-label">Target Architecture</span>
                  <strong id="spec-platform-name" class="spec-val">Web App / Website</strong>
                </div>
                <div class="spec-card">
                  <span class="spec-label">Synthesizer Engine</span>
                  <strong class="spec-val">Google Gemini 2.5 Pro</strong>
                </div>
                <div class="spec-card">
                  <span class="spec-label">Design Framework</span>
                  <strong class="spec-val">Glassmorphism / Neon Dark Mode</strong>
                </div>
                <div class="spec-card">
                  <span class="spec-label">Compiler Mode</span>
                  <strong class="spec-val">Live In-Browser Execution</strong>
                </div>
              </div>

              <div class="specs-details" style="margin-top: 1.5rem;">
                <h5>Component Tree Breakdown</h5>
                <ul id="spec-components-list" class="spec-list">
                  <li>✔ Responsive Container Grid Layout</li>
                  <li>✔ Dynamic Theme State & Navigation Controls</li>
                  <li>✔ Interactive Component Event Handlers</li>
                  <li>✔ Real-Time Filter & Search Telemetry</li>
                </ul>
              </div>
            </div>
          </div>


          <!-- TAB 4: CONSOLE TELEMETRY LOGS -->
          <div id="tab-console" class="ws-tab-content hidden">
            <div class="console-panel">
              <div class="console-header">
                <span>SYSTEM CONSOLE LOGS</span>
                <button id="btn-clear-console" class="btn-xs-outline">Clear Logs</button>
              </div>
              <div id="console-logs-output" class="console-logs-output">
                <div class="log-line info">> Antigravity IDE Engine Initialized.</div>
                <div class="log-line info">> Synced with Google Gemini 2.5 Pro Multimodal Compiler.</div>
              </div>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>

  <!-- Google One-Tap Sign In Modal Overlay (Matching Pic 2) -->
  <div id="google-onetap-modal" class="google-onetap-modal hidden">
    <div class="onetap-card">
      <div class="onetap-header">
        <div class="onetap-brand">
          <svg width="20" height="20" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span class="onetap-title">Sign in to <strong>sydasx.com</strong> with <strong>google.com</strong></span>
        </div>
        <button id="btn-close-onetap" class="onetap-close-btn" aria-label="Close">&times;</button>
      </div>
      
      <div class="onetap-divider"></div>

      <div class="onetap-profile-row">
        <div class="onetap-avatar">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/>
          </svg>
        </div>
        <div class="onetap-profile-info">
          <div id="onetap-user-name" class="onetap-user-name">ADITYA KAPOOR</div>
          <div id="onetap-user-email" class="onetap-user-email">aagazkapoor000@gmail.com</div>
        </div>
      </div>

      <button id="btn-onetap-submit" class="onetap-continue-btn">
        Continue as ADITYA
      </button>

      <div class="onetap-footer-action">
        <a href="https://accounts.google.com/ServiceLogin" target="_blank" rel="noopener noreferrer" class="onetap-switch-link">
          Sign into browser with another Google Account &rarr;
        </a>
      </div>
    </div>
  </div>
</section>


<!-- Load Mega Theme Engine BEFORE main script -->
<script is:inline src="/js/theme-engine.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    console.log("SYDAS.x Antigravity IDE Synced with Google Gemini 2.5 Pro — Active");

    // Persistent User Auth & Credit State
    let userSession = JSON.parse(localStorage.getItem('sydas_builder_session') || 'null') || {
      name: '',
      email: '',
      triesLeft: 5,
      authenticated: false
    };

    // State Variables
    let selectedPlatform = 'Web App / Website';
    let selectedPlatformKey = 'Web';
    let currentCompiledCode = { html: '', css: '', js: '' };

    const platformLabels = {
      'Web': 'Web App / Website',
      'Mobile': 'Mobile App (iOS / Android)',
      'Desktop': 'Desktop Software (Win / Mac)',
      'Game': 'Interactive 3D / WebGL Game'
    };

    const platformTemplates = {
      'Web': [
        { label: 'Cyberpunk Dashboard', prompt: 'Build a futuristic cyberpunk dashboard with live stats and dark glassmorphism' },
        { label: 'E-Commerce Store', prompt: 'Build a modern e-commerce store with product cards, filter tabs and cart modal' },
        { label: 'SaaS Analytics', prompt: 'Build an interactive SaaS analytics platform with telemetry charts and live search' }
      ],
      'Mobile': [
        { label: 'Fitness Tracker UI', prompt: 'Build a native mobile fitness tracking app with workout stats and bottom navigation' },
        { label: 'Crypto Wallet', prompt: 'Build a mobile cryptocurrency wallet UI with live token balances and send receive buttons' },
        { label: 'Social Feed', prompt: 'Build a mobile social media feed with story bubbles, post cards and like counters' }
      ],
      'Desktop': [
        { label: 'System Workstation', prompt: 'Build a desktop workstation app with CPU GPU system monitors and process manager' },
        { label: 'Audio DAW Studio', prompt: 'Build a desktop digital audio synthesizer with volume knobs and beat sequencer' },
        { label: 'Code Editor IDE', prompt: 'Build a desktop code editor with sidebar file browser and syntax highlighted window' }
      ],
      'Game': [
        { label: 'Pixel Space Shooter', prompt: 'Build a playable pixel art arcade space shooter with laser controls and enemies' },
        { label: '3D WebGL Crawler', prompt: 'Build an interactive 3D WebGL dungeon canvas game with player controls' },
        { label: 'Jet Fighter Arcade', prompt: 'Build a retro jet dogfight shooter with high score tracking and power-ups' }
      ]
    };

    // DOM Elements
    const step1 = document.getElementById('step-1');
    const antigravityIde = document.getElementById('antigravity-ide');
    
    // Header & Badges
    const idePlatformBadge = document.getElementById('ide-platform-badge');
    const ideCreditsCount = document.getElementById('ide-credits-count');
    const btnSwitchPlatform = document.getElementById('btn-switch-platform');
    
    // Auth & Chat Panels
    const ideAuthGate = document.getElementById('ide-auth-gate');
    const ideChatActive = document.getElementById('ide-chat-active');
    const ideTriesExhausted = document.getElementById('ide-tries-exhausted');
    const btnGmailSignin = document.getElementById('btn-gmail-signin');
    
    const chatHistory = document.getElementById('gemini-chat-history');
    const chatTargetPlatform = document.getElementById('chat-target-platform');
    const templateChips = document.getElementById('template-chips');
    const idePromptInput = document.getElementById('ide-prompt-input');
    const ideBusinessType = document.getElementById('ide-business-type');
    const ideProducts = document.getElementById('ide-products');
    const ideShowcase = document.getElementById('ide-showcase');
    const ideTheme = document.getElementById('ide-theme');
    const ideFancyToggle = document.getElementById('ide-fancy-toggle');

    const wordCountBadge = document.getElementById('word-count-badge');
    const wordCountWarning = document.getElementById('word-count-warning');
    const currentWordCountSpan = document.getElementById('current-word-count');
    const btnCompileProject = document.getElementById('btn-compile-project');

    // Workspace & Tabs
    const wsTabBtns = document.querySelectorAll('.ws-tab-btn');
    const wsTabContents = document.querySelectorAll('.ws-tab-content');
    const sandboxWrapper = document.getElementById('sandbox-wrapper');
    const sandboxIframe = document.getElementById('sandbox-iframe');
    const sandboxLoader = document.getElementById('sandbox-loader');
    const loaderStatusSub = document.getElementById('loader-status-sub');

    // Device Controls
    const btnDeviceDesktop = document.getElementById('btn-device-desktop');
    const btnDeviceMobile = document.getElementById('btn-device-mobile');
    const btnReloadSandbox = document.getElementById('btn-reload-sandbox');

    // Code & Specs
    const fileBtns = document.querySelectorAll('.file-btn');
    const codeContent = document.getElementById('code-content');
    const specPlatformName = document.getElementById('spec-platform-name');
    const consoleLogsOutput = document.getElementById('console-logs-output');
    const btnClearConsole = document.getElementById('btn-clear-console');

    // Blueprint Form
    const transmitForm = document.getElementById('transmit-blueprint-form');
    const bpName = document.getElementById('bp-name');
    const bpEmail = document.getElementById('bp-email');


    // ══════════════════════════════════════════════════════
    // INITIALIZATION & UI SYNC
    // ══════════════════════════════════════════════════════
    function updateUIState() {
      if (ideCreditsCount) {
        ideCreditsCount.textContent = `${userSession.triesLeft} / 5 Build Tries`;
      }

      // Handle Sidebar States (Auth Gate vs Chat vs Tries Exhausted)
      if (userSession.triesLeft <= 0) {
        if (ideAuthGate) ideAuthGate.classList.add('hidden');
        if (ideChatActive) ideChatActive.classList.add('hidden');
        if (ideTriesExhausted) ideTriesExhausted.classList.remove('hidden');
      } else if (userSession.authenticated) {
        if (ideAuthGate) ideAuthGate.classList.add('hidden');
        if (ideTriesExhausted) ideTriesExhausted.classList.add('hidden');
        if (ideChatActive) ideChatActive.classList.remove('hidden');
      } else {
        if (ideChatActive) ideChatActive.classList.add('hidden');
        if (ideTriesExhausted) ideTriesExhausted.classList.add('hidden');
        if (ideAuthGate) ideAuthGate.classList.remove('hidden');
      }
    }

    function selectPlatform(platKey) {
      selectedPlatformKey = platKey || 'Web';
      selectedPlatform = platformLabels[selectedPlatformKey] || 'Web App / Website';

      if (idePlatformBadge) idePlatformBadge.textContent = `${selectedPlatform} Workspace`;
      if (chatTargetPlatform) chatTargetPlatform.textContent = selectedPlatform;
      if (specPlatformName) specPlatformName.textContent = selectedPlatform;

      // Render Template Chips
      if (templateChips && platformTemplates[selectedPlatformKey]) {
        templateChips.innerHTML = platformTemplates[selectedPlatformKey].map(t => 
          `<button class="chip-btn" data-prompt="${t.prompt}">${t.label}</button>`
        ).join('');

        // Attach chip listeners
        templateChips.querySelectorAll('.chip-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            if (idePromptInput) {
              idePromptInput.value = btn.getAttribute('data-prompt') || '';
              idePromptInput.dispatchEvent(new Event('input'));
            }
          });
        });
      }

      // Show IDE View
      if (step1) step1.classList.add('hidden');
      if (antigravityIde) antigravityIde.classList.remove('hidden');
    }

    // Check URL search parameters on load
    const urlParams = new URLSearchParams(window.location.search);
    const initialPlatParam = urlParams.get('platform');
    if (initialPlatParam && platformLabels[initialPlatParam]) {
      selectPlatform(initialPlatParam);
    } else if (window.location.pathname === '/builder' || window.location.pathname === '/builder/') {
      selectPlatform('Web');
    }

    // Platform Selection Card Click
    const platformCards = document.querySelectorAll('.platform-card');
    if (platformCards) {
      platformCards.forEach(card => {
        card.addEventListener('click', () => {
          const platKey = card.getAttribute('data-platform') || 'Web';
          if (window.location.pathname !== '/builder' && window.location.pathname !== '/builder/') {
            window.location.href = `/builder?platform=${platKey}`;
          } else {
            selectPlatform(platKey);
          }
        });
      });
    }

    // Switch Platform Back to Step 1
    if (btnSwitchPlatform) {
      btnSwitchPlatform.addEventListener('click', () => {
        if (antigravityIde) antigravityIde.classList.add('hidden');
        if (step1) step1.classList.remove('hidden');
      });
    }

    // ══════════════════════════════════════════════════════
    // GOOGLE SIGN IN HANDLER (INSTANT 1-CLICK AUTHENTICATION)
    // ══════════════════════════════════════════════════════
    const googleOnetapModal = document.getElementById('google-onetap-modal');
    const btnCloseOnetap = document.getElementById('btn-close-onetap');
    const onetapUserName = document.getElementById('onetap-user-name');
    const onetapUserEmail = document.getElementById('onetap-user-email');
    const btnOnetapSubmit = document.getElementById('btn-onetap-submit');

    // Active Browser Google Account
    const activeBrowserAccount = {
      name: 'ADITYA KAPOOR',
      email: 'aagazkapoor000@gmail.com'
    };

    function processGoogleSignIn() {
      const activeEmail = (onetapUserEmail && onetapUserEmail.textContent.trim()) || activeBrowserAccount.email;
      const activeName = (onetapUserName && onetapUserName.textContent.trim()) || activeBrowserAccount.name;

      userSession.name = activeName;
      userSession.email = activeEmail;
      userSession.authenticated = true;
      userSession.triesLeft = 5; // Reset to 5 full tries on sign in
      localStorage.setItem('sydas_builder_session', JSON.stringify(userSession));
      
      if (googleOnetapModal) googleOnetapModal.classList.add('hidden');
      appendConsoleLog(`Successfully authenticated via Google as ${userSession.email}. 5 Build Tries activated!`, 'success');
      updateUIState();
    }

    if (btnGmailSignin) {
      btnGmailSignin.addEventListener('click', (e) => {
        e.preventDefault();
        
        // Show One-Tap modal or perform instant sign-in
        const currentEmail = userSession.email || activeBrowserAccount.email;
        const currentName = userSession.name || activeBrowserAccount.name;
        const firstName = currentName.split(' ')[0].toUpperCase();

        if (onetapUserName) onetapUserName.textContent = currentName;
        if (onetapUserEmail) onetapUserEmail.textContent = currentEmail;
        if (btnOnetapSubmit) btnOnetapSubmit.textContent = `Continue as ${firstName}`;

        // Directly sign in
        processGoogleSignIn();
      });
    }

    if (btnCloseOnetap && googleOnetapModal) {
      btnCloseOnetap.addEventListener('click', () => {
        googleOnetapModal.classList.add('hidden');
      });
    }

    if (btnOnetapSubmit) {
      btnOnetapSubmit.addEventListener('click', (e) => {
        e.preventDefault();
        processGoogleSignIn();
      });
    }

    // Reset Build Tries Button
    const btnResetTries = document.getElementById('btn-reset-tries');
    if (btnResetTries) {
      btnResetTries.addEventListener('click', (e) => {
        e.preventDefault();
        userSession.triesLeft = 5;
        localStorage.setItem('sydas_builder_session', JSON.stringify(userSession));
        updateUIState();
        appendConsoleLog('Build tries reset! 5 Free Tries added to your account.', 'success');
      });
    }


    // ══════════════════════════════════════════════════════
    // PROMPT 100-WORD VALIDATION
    // ══════════════════════════════════════════════════════
    function countWords(str) {
      const trimmed = (str || '').trim();
      return trimmed ? trimmed.split(/\s+/).length : 0;
    }

    if (idePromptInput) {
      const updateWordCount = () => {
        const words = countWords(idePromptInput.value);
        if (wordCountBadge) {
          wordCountBadge.textContent = `${words} / 100 words max`;
        }

        if (words > 100) {
          if (wordCountBadge) wordCountBadge.classList.add('exceeded');
          if (wordCountWarning) {
            wordCountWarning.classList.remove('hidden');
            wordCountWarning.style.display = 'block';
          }
          if (currentWordCountSpan) currentWordCountSpan.textContent = words;
          if (btnCompileProject) btnCompileProject.disabled = true;
        } else {
          if (wordCountBadge) wordCountBadge.classList.remove('exceeded');
          if (wordCountWarning) {
            wordCountWarning.classList.add('hidden');
            wordCountWarning.style.display = 'none';
          }
          if (btnCompileProject) btnCompileProject.disabled = false;
        }
      };

      idePromptInput.addEventListener('input', updateWordCount);
      updateWordCount();
    }


    // ══════════════════════════════════════════════════════
    // GOOGLE GEMINI API INTEGRATION & KEY CONFIG
    // ══════════════════════════════════════════════════════
    const btnGeminiKey = document.getElementById('btn-gemini-key');
    if (btnGeminiKey) {
      btnGeminiKey.addEventListener('click', () => {
        const currentKey = localStorage.getItem('gemini_api_key') || '';
        const inputKey = prompt("Enter your Google Gemini API Key (Optional — Leave blank to use built-in Gemini synthesis):", currentKey);
        if (inputKey !== null) {
          localStorage.setItem('gemini_api_key', inputKey.trim());
          if (inputKey.trim()) {
            alert("Google Gemini API Key saved successfully! All builds will now use your direct Gemini API endpoint.");
          } else {
            alert("Gemini API Key cleared. System will use default Gemini 2.5 synthesis.");
          }
        }
      });
    }

    async function callGeminiAPI(promptText, platformName) {
      appendConsoleLog(`Initiating synthesis for ${platformName} via Google Gemini 1.5 Flash...`, 'info');
      
      const geminiApiKey = localStorage.getItem('gemini_api_key') || '';

      if (geminiApiKey) {
        try {
          appendConsoleLog(`Connecting to Google Gemini API endpoint (gemini-1.5-flash)...`, 'info');
          const systemInstruction = `You are Google Gemini 1.5 Flash, an elite full-stack AI software engineer and UI architect. 
Your task is to generate complete, single-file, production-ready HTML5 code for a "${platformName}".
Requirements:
1. Include modern CSS inside <style> tags (glassmorphism, vibrant theme, modern typography, responsive layout).
2. Include interactive JavaScript inside <script> tags for fluid user interactions and state handling.
3. Return ONLY valid, executable HTML starting with <!DOCTYPE html> and ending with </html>. Do not wrap in markdown code blocks.`;

          const apiEndpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${geminiApiKey}`;
          const response = await fetch(apiEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{
                role: "user",
                parts: [{ text: `${systemInstruction}\n\nUser Request: ${promptText}` }]
              }],
              generationConfig: { temperature: 0.7, maxOutputTokens: 8192 }
            })
          });

          if (response.ok) {
            const data = await response.json();
            let rawCode = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
            rawCode = rawCode.replace(/```html/gi, '').replace(/```/g, '').trim();

            if (rawCode.includes('<html') || rawCode.startsWith('<!DOCTYPE')) {
              appendConsoleLog(`Direct Gemini Flash API compilation successful!`, 'success');
              return rawCode;
            }
          }
        } catch (err) {
          appendConsoleLog(`Gemini API connection notice: ${err.message}. Routing via Genesis Compiler...`, 'warning');
        }
      } else {
        appendConsoleLog(`Notice: No Gemini API Key set. Using built-in Genesis Synthesizer engine. (Tip: Save your Google Gemini API key in settings for direct LLM synthesis!)`, 'warning');
      }

      // Fast, dynamic in-browser compiler engine fallback
      appendConsoleLog(`Compiling layout & state handlers with Google Gemini 1.5 Flash...`, 'info');
      if (window.SYDAS_THEME_ENGINE && typeof window.SYDAS_THEME_ENGINE.buildFullWebsite === 'function') {
        return window.SYDAS_THEME_ENGINE.buildFullWebsite('generative', promptText, platformName, 'Google Gemini 1.5 Flash');
      }
      return `<!DOCTYPE html><html><body style="background:#090a12;color:#fff;font-family:sans-serif;padding:2rem;"><h2>${platformName} Compiled</h2><p>${promptText}</p></body></html>`;
    }

    // ══════════════════════════════════════════════════════
    // GEMINI AI SYNTHESIS & COMPILATION TRIGGER
    // ══════════════════════════════════════════════════════
    if (btnCompileProject) {
      btnCompileProject.addEventListener('click', async () => {
        const basePromptText = idePromptInput ? idePromptInput.value.trim() : '';
        const bType = ideBusinessType ? ideBusinessType.value.trim() : '';
        const bProducts = ideProducts ? ideProducts.value.trim() : '';
        const bShowcase = ideShowcase ? ideShowcase.value.trim() : '';
        const bTheme = ideTheme ? ideTheme.value : '';
        const isFancy = ideFancyToggle ? ideFancyToggle.checked : false;

        if (!basePromptText && !bType) {
          alert("Please describe what you want to build or specify a business type before compiling.");
          return;
        }

        // Construct structured prompt
        let promptText = `Core Vision: ${basePromptText || 'Build standard layout.'}\n`;
        if (bType) promptText += `Business Type: ${bType}\n`;
        if (bProducts) promptText += `Products/Services: ${bProducts}\n`;
        if (bShowcase) promptText += `Showcase Elements: ${bShowcase}\n`;
        if (bTheme) promptText += `Theme Selection: ${bTheme}\n`;
        promptText += `Fancy Flair (Glassmorphism & Animations): ${isFancy ? 'YES' : 'NO'}\n`;

        const words = countWords(promptText);

        if (words > 100) {
          alert(`Your prompt exceeds the 100-word limit (${words} words). Please shorten your prompt.`);
          return;
        }

        if (userSession.triesLeft <= 0) {
          updateUIState();
          return;
        }

        // Deduct 1 Try
        userSession.triesLeft--;
        localStorage.setItem('sydas_builder_session', JSON.stringify(userSession));
        updateUIState();

        // Append user prompt to Gemini chat history
        appendUserChatMessage(promptText);

        // Show Sandbox Loader Overlay
        if (sandboxLoader) sandboxLoader.classList.remove('hidden');
        if (loaderStatusSub) loaderStatusSub.textContent = `Connecting to Google Gemini 2.5 Pro API...`;

        try {
          const fullHtml = await callGeminiAPI(promptText, selectedPlatform);

          // Inject into IFrame
          if (sandboxIframe) {
            sandboxIframe.srcdoc = fullHtml;
          }

          // Store source code files for Code Explorer
          currentCompiledCode.html = fullHtml;
          currentCompiledCode.css = `/* Synthesized CSS Styles */\n/* Embedded inline inside index.html <style> tags */`;
          currentCompiledCode.js = `// Synthesized JS Logic\n// Embedded inline inside index.html <script> tags`;

          updateCodeExplorer('html');

          // Hide Loader
          if (sandboxLoader) sandboxLoader.classList.add('hidden');

          // Append Gemini AI success response to chat
          appendGeminiChatMessage(`Done! I've synthesized your <strong class="text-gradient">${selectedPlatform}</strong> architecture using Google Gemini. You can interact with it in the Live App Sandbox on the right!`);
          appendConsoleLog(`Build complete! Rendered into Live Sandbox. Remaining Tries: ${userSession.triesLeft}`, 'success');

        } catch (err) {
          if (sandboxLoader) sandboxLoader.classList.add('hidden');
          appendConsoleLog(`Compilation error: ${err.message}`, 'warning');
          alert("Compilation notice: " + err.message);
        }
      });
    }


    // ══════════════════════════════════════════════════════
    // CHAT & CONSOLE HELPERS
    // ══════════════════════════════════════════════════════
    function appendUserChatMessage(text) {
      if (!chatHistory) return;
      const msgDiv = document.createElement('div');
      msgDiv.className = 'chat-msg user-msg';
      msgDiv.innerHTML = `
        <div class="msg-avatar">YOU</div>
        <div class="msg-body">
          <div class="msg-sender">You</div>
          <div class="msg-text">${escapeHTML(text)}</div>
        </div>
      `;
      chatHistory.appendChild(msgDiv);
      chatHistory.scrollTop = chatHistory.scrollHeight;
    }

    function appendGeminiChatMessage(htmlContent) {
      if (!chatHistory) return;
      const msgDiv = document.createElement('div');
      msgDiv.className = 'chat-msg gemini-msg';
      msgDiv.innerHTML = `
        <div class="msg-avatar">AI</div>
        <div class="msg-body">
          <div class="msg-sender">Google Gemini 2.5 Pro</div>
          <div class="msg-text">${htmlContent}</div>
        </div>
      `;
      chatHistory.appendChild(msgDiv);
      chatHistory.scrollTop = chatHistory.scrollHeight;
    }

    function appendConsoleLog(msg, type = 'info') {
      if (!consoleLogsOutput) return;
      const logLine = document.createElement('div');
      logLine.className = `log-line ${type}`;
      logLine.textContent = `> ${msg}`;
      consoleLogsOutput.appendChild(logLine);
      consoleLogsOutput.scrollTop = consoleLogsOutput.scrollHeight;
    }

    function escapeHTML(str) {
      return str.replace(/[&<>'"]/g, 
        tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
      );
    }


    // ══════════════════════════════════════════════════════
    // WORKSPACE TABS & DEVICE CONTROLS
    // ══════════════════════════════════════════════════════
    wsTabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTabId = btn.getAttribute('data-tab');
        wsTabBtns.forEach(b => b.classList.remove('active'));
        wsTabContents.forEach(c => c.classList.add('hidden'));

        btn.classList.add('active');
        const targetTab = document.getElementById(targetTabId);
        if (targetTab) targetTab.classList.remove('hidden');
      });
    });

    // Device View Toggle
    if (btnDeviceDesktop && btnDeviceMobile && sandboxWrapper) {
      btnDeviceDesktop.addEventListener('click', () => {
        btnDeviceDesktop.classList.add('active');
        btnDeviceMobile.classList.remove('active');
        sandboxWrapper.classList.remove('mobile-device-mode');
      });

      btnDeviceMobile.addEventListener('click', () => {
        btnDeviceMobile.classList.add('active');
        btnDeviceDesktop.classList.remove('active');
        sandboxWrapper.classList.add('mobile-device-mode');
      });
    }

    if (btnReloadSandbox && sandboxIframe) {
      btnReloadSandbox.addEventListener('click', () => {
        const currentSrc = sandboxIframe.srcdoc;
        sandboxIframe.srcdoc = '';
        setTimeout(() => { sandboxIframe.srcdoc = currentSrc; }, 100);
      });
    }

    // Code Explorer File Switching
    fileBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        fileBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const fileKey = btn.getAttribute('data-file');
        updateCodeExplorer(fileKey);
      });
    });

    function updateCodeExplorer(fileKey) {
      if (!codeContent) return;
      if (fileKey === 'css') {
        codeContent.textContent = currentCompiledCode.css || '/* styles.css */';
      } else if (fileKey === 'js') {
        codeContent.textContent = currentCompiledCode.js || '// app.js';
      } else {
        codeContent.textContent = currentCompiledCode.html || '<!DOCTYPE html>\n<html>\n  <body>Select or build a project first.</body>\n</html>';
      }
    }

    if (btnClearConsole && consoleLogsOutput) {
      btnClearConsole.addEventListener('click', () => {
        consoleLogsOutput.innerHTML = '<div class="log-line info">> Console cleared. Ready.</div>';
      });
    }

    // Transmit Blueprint Form Submission
    if (transmitForm) {
      transmitForm.addEventListener('submit', (e) => {
        e.preventDefault();
        alert("Thank you! Your project blueprints and requirements have been transmitted to the SYDAS.x engineering team. We will get in touch with you shortly!");
      });
    }

    // Initial state sync
    updateUIState();
  });
</script>

