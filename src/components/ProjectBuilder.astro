<!-- Load Mega Theme Engine BEFORE main script -->
<script is:inline src="/js/theme-engine.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    console.log("SYDAS.x Genesis Matrix Industry Architect v6.0 — Multi-Scroll Active");

    // Persistent User Auth & Credit State
    let userSession = JSON.parse(localStorage.getItem('sydas_builder_session') || 'null') || {
      name: '',
      email: '',
      triesLeft: 5,
      authenticated: false
    };

    // State Variables
    let selectedBrandName = '';
    let selectedIndustryKey = 'ecommerce';
    let selectedIndustryLabel = 'E-Commerce';
    let selectedBgColor = '#08090d';
    let selectedAccentColor = '#00f0ff';
    let selectedFontKey = 'inter';
    let selectedFontName = 'Inter Modern';

    let currentCompiledCode = { html: '', css: '', js: '' };

    // DOM Elements — Steps
    const step1 = document.getElementById('step-1');
    const step2 = document.getElementById('step-2');
    const step3 = document.getElementById('step-3');
    const antigravityIde = document.getElementById('antigravity-ide');

    // Step 1 Elements
    const brandNameInput = document.getElementById('brand-name-input');
    const btnToStep2 = document.getElementById('btn-to-step2');

    // Step 2 Elements
    const industryGrid = document.getElementById('industry-grid');
    const btnBackStep1 = document.getElementById('btn-back-step1');

    // Step 3 Elements
    const studioBrandLabel = document.getElementById('studio-brand-label');
    const bgSwatches = document.querySelectorAll('#bg-swatches-grid .swatch-btn');
    const accentSwatches = document.querySelectorAll('#accent-swatches-grid .swatch-btn');
    const fontCardBtns = document.querySelectorAll('#font-selection-grid .font-card-btn');
    const btnBackStep2 = document.getElementById('btn-back-step2');
    const btnLaunchIde = document.getElementById('btn-launch-ide');

    // IDE Elements
    const idePlatformBadge = document.getElementById('ide-platform-badge');
    const ideCreditsCount = document.getElementById('ide-credits-count');
    const btnSwitchPlatform = document.getElementById('btn-switch-platform');
    
    // Auth & Chat Panels
    const ideAuthGate = document.getElementById('ide-auth-gate');
    const ideChatActive = document.getElementById('ide-chat-active');
    const ideTriesExhausted = document.getElementById('ide-tries-exhausted');
    const btnGmailSignin = document.getElementById('btn-gmail-signin');
    
    const chatHistory = document.getElementById('gemini-chat-history');
    const chatBrandName = document.getElementById('chat-brand-name');
    const chatIndLabel = document.getElementById('chat-ind-label');
    const summaryBrand = document.getElementById('summary-brand');
    const summaryIndustry = document.getElementById('summary-industry');
    const summaryBgDot = document.getElementById('summary-bg-dot');
    const summaryBgVal = document.getElementById('summary-bg-val');
    const summaryAccentDot = document.getElementById('summary-accent-dot');
    const summaryAccentVal = document.getElementById('summary-accent-val');
    const summaryFontVal = document.getElementById('summary-font-val');
    const btnCompileProject = document.getElementById('btn-compile-project');

    // Workspace & Tabs
    const wsTabBtns = document.querySelectorAll('.ws-tab-btn');
    const wsTabContents = document.querySelectorAll('.ws-tab-content');
    const sandboxWrapper = document.getElementById('sandbox-wrapper');
    const sandboxIframe = document.getElementById('sandbox-iframe');
    const sandboxLoader = document.getElementById('sandbox-loader');
    const loaderStatusSub = document.getElementById('loader-status-sub');

    // Device Controls
    const btnDeviceDesktop = document.getElementById('btn-device-desktop');
    const btnDeviceMobile = document.getElementById('btn-device-mobile');
    const btnReloadSandbox = document.getElementById('btn-reload-sandbox');

    // Code & Specs
    const fileBtns = document.querySelectorAll('.file-btn');
    const codeContent = document.getElementById('code-content');
    const specPlatformName = document.getElementById('spec-platform-name');
    const consoleLogsOutput = document.getElementById('console-logs-output');
    const btnClearConsole = document.getElementById('btn-clear-console');

    // Blueprint Form
    const transmitForm = document.getElementById('transmit-blueprint-form');


    // ══════════════════════════════════════════════════════
    // STEP 1 → STEP 2 NAVIGATION (BRAND NAME)
    // ══════════════════════════════════════════════════════
    if (brandNameInput && btnToStep2) {
      brandNameInput.addEventListener('input', () => {
        const val = brandNameInput.value.trim();
        btnToStep2.disabled = val.length < 2;
      });

      btnToStep2.addEventListener('click', () => {
        selectedBrandName = brandNameInput.value.trim();
        if (selectedBrandName.length < 2) return;
        
        step1.classList.add('hidden');
        step1.classList.remove('active');
        step2.classList.remove('hidden');
        step2.classList.add('active');
      });

      brandNameInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && brandNameInput.value.trim().length >= 2) {
          btnToStep2.click();
        }
      });
    }

    if (btnBackStep1) {
      btnBackStep1.addEventListener('click', () => {
        step2.classList.add('hidden');
        step2.classList.remove('active');
        step1.classList.remove('hidden');
        step1.classList.add('active');
        if (brandNameInput) brandNameInput.focus();
      });
    }


    // ══════════════════════════════════════════════════════
    // STEP 2 → STEP 3 (INDUSTRY SELECTION → CUSTOMIZATION STUDIO)
    // ══════════════════════════════════════════════════════
    if (industryGrid) {
      const industryCards = industryGrid.querySelectorAll('.industry-card');
      industryCards.forEach(card => {
        card.addEventListener('click', () => {
          selectedIndustryKey = card.getAttribute('data-industry') || 'ecommerce';
          
          if (window.SYDAS_THEME_ENGINE?.INDUSTRIES?.[selectedIndustryKey]) {
            selectedIndustryLabel = window.SYDAS_THEME_ENGINE.INDUSTRIES[selectedIndustryKey].label;
            const defPalette = window.SYDAS_THEME_ENGINE.INDUSTRIES[selectedIndustryKey].defaultPalette;
            if (defPalette) {
              selectedBgColor = defPalette.bg;
              selectedAccentColor = defPalette.primary;
            }
          } else {
            selectedIndustryLabel = card.querySelector('.ind-title')?.textContent || 'Custom';
          }

          if (studioBrandLabel) studioBrandLabel.textContent = `${selectedBrandName} (${selectedIndustryLabel})`;

          step2.classList.add('hidden');
          step2.classList.remove('active');
          step3.classList.remove('hidden');
          step3.classList.add('active');

          appendConsoleLog(`Selected Industry: ${selectedIndustryLabel}`, 'info');
        });
      });
    }

    if (btnBackStep2) {
      btnBackStep2.addEventListener('click', () => {
        step3.classList.add('hidden');
        step3.classList.remove('active');
        step2.classList.remove('hidden');
        step2.classList.add('active');
      });
    }


    // ══════════════════════════════════════════════════════
    // STEP 3: CUSTOMIZATION STUDIO CONTROLS
    // ══════════════════════════════════════════════════════
    // Background Swatches
    bgSwatches.forEach(swatch => {
      swatch.addEventListener('click', () => {
        bgSwatches.forEach(s => s.classList.remove('active'));
        swatch.classList.add('active');
        selectedBgColor = swatch.getAttribute('data-color') || '#08090d';
        updateSummaryCard();
      });
    });

    // Accent Swatches
    accentSwatches.forEach(swatch => {
      swatch.addEventListener('click', () => {
        accentSwatches.forEach(s => s.classList.remove('active'));
        swatch.classList.add('active');
        selectedAccentColor = swatch.getAttribute('data-accent') || '#00f0ff';
        updateSummaryCard();
      });
    });

    // Font Cards
    fontCardBtns.forEach(card => {
      card.addEventListener('click', () => {
        fontCardBtns.forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        selectedFontKey = card.getAttribute('data-font') || 'inter';
        selectedFontName = card.querySelector('.font-title')?.textContent || 'Inter Modern';
        updateSummaryCard();
      });
    });

    function updateSummaryCard() {
      if (summaryBgDot) summaryBgDot.style.background = selectedBgColor;
      if (summaryBgVal) summaryBgVal.textContent = selectedBgColor;
      if (summaryAccentDot) summaryAccentDot.style.background = selectedAccentColor;
      if (summaryAccentVal) summaryAccentVal.textContent = selectedAccentColor;
      if (summaryFontVal) summaryFontVal.textContent = selectedFontName;
    }

    // Step 3 → IDE Launch
    if (btnLaunchIde) {
      btnLaunchIde.addEventListener('click', () => {
        step3.classList.add('hidden');
        step3.classList.remove('active');
        antigravityIde.classList.remove('hidden');

        // Update IDE header & summaries
        if (idePlatformBadge) idePlatformBadge.textContent = `${selectedIndustryLabel} — ${selectedBrandName}`;
        if (specPlatformName) specPlatformName.textContent = selectedIndustryLabel;
        if (chatBrandName) chatBrandName.textContent = selectedBrandName;
        if (chatIndLabel) chatIndLabel.textContent = selectedIndustryLabel;
        if (summaryBrand) summaryBrand.textContent = selectedBrandName;
        if (summaryIndustry) summaryIndustry.textContent = selectedIndustryLabel;

        updateSummaryCard();
        updateUIState();

        // Automatically trigger first synthesis if authenticated
        if (userSession.authenticated && userSession.triesLeft > 0) {
          triggerCompilation();
        }
      });
    }


    // ══════════════════════════════════════════════════════
    // SWITCH PLATFORM (START OVER)
    // ══════════════════════════════════════════════════════
    if (btnSwitchPlatform) {
      btnSwitchPlatform.addEventListener('click', () => {
        antigravityIde.classList.add('hidden');
        step1.classList.remove('hidden');
        step1.classList.add('active');
        if (brandNameInput) {
          brandNameInput.value = selectedBrandName;
          brandNameInput.focus();
        }
      });
    }


    // ══════════════════════════════════════════════════════
    // INITIALIZATION & UI SYNC
    // ══════════════════════════════════════════════════════
    function updateUIState() {
      if (ideCreditsCount) {
        ideCreditsCount.textContent = `${userSession.triesLeft} / 5 Build Tries`;
      }

      if (userSession.triesLeft <= 0) {
        if (ideAuthGate) ideAuthGate.classList.add('hidden');
        if (ideChatActive) ideChatActive.classList.add('hidden');
        if (ideTriesExhausted) ideTriesExhausted.classList.remove('hidden');
      } else if (userSession.authenticated) {
        if (ideAuthGate) ideAuthGate.classList.add('hidden');
        if (ideTriesExhausted) ideTriesExhausted.classList.add('hidden');
        if (ideChatActive) ideChatActive.classList.remove('hidden');
      } else {
        if (ideChatActive) ideChatActive.classList.add('hidden');
        if (ideTriesExhausted) ideTriesExhausted.classList.add('hidden');
        if (ideAuthGate) ideAuthGate.classList.remove('hidden');
      }
    }


    // ══════════════════════════════════════════════════════
    // GOOGLE SIGN IN HANDLER
    // ══════════════════════════════════════════════════════
    const googleOnetapModal = document.getElementById('google-onetap-modal');
    const btnCloseOnetap = document.getElementById('btn-close-onetap');
    const onetapUserName = document.getElementById('onetap-user-name');
    const onetapUserEmail = document.getElementById('onetap-user-email');
    const btnOnetapSubmit = document.getElementById('btn-onetap-submit');

    const activeBrowserAccount = {
      name: 'ADITYA KAPOOR',
      email: 'aagazkapoor000@gmail.com'
    };

    function processGoogleSignIn() {
      const activeEmail = (onetapUserEmail && onetapUserEmail.textContent.trim()) || activeBrowserAccount.email;
      const activeName = (onetapUserName && onetapUserName.textContent.trim()) || activeBrowserAccount.name;

      userSession.name = activeName;
      userSession.email = activeEmail;
      userSession.authenticated = true;
      userSession.triesLeft = 5;
      localStorage.setItem('sydas_builder_session', JSON.stringify(userSession));
      
      if (googleOnetapModal) googleOnetapModal.classList.add('hidden');
      appendConsoleLog(`Authenticated via Google as ${userSession.email}. 5 Build Tries active!`, 'success');
      updateUIState();

      // Trigger initial synthesis upon sign in
      if (selectedBrandName) {
        triggerCompilation();
      }
    }

    if (btnGmailSignin) {
      btnGmailSignin.addEventListener('click', (e) => {
        e.preventDefault();
        processGoogleSignIn();
      });
    }

    if (btnCloseOnetap && googleOnetapModal) {
      btnCloseOnetap.addEventListener('click', () => {
        googleOnetapModal.classList.add('hidden');
      });
    }

    if (btnOnetapSubmit) {
      btnOnetapSubmit.addEventListener('click', (e) => {
        e.preventDefault();
        processGoogleSignIn();
      });
    }

    // Reset Build Tries Button
    const btnResetTries = document.getElementById('btn-reset-tries');
    if (btnResetTries) {
      btnResetTries.addEventListener('click', (e) => {
        e.preventDefault();
        userSession.triesLeft = 5;
        localStorage.setItem('sydas_builder_session', JSON.stringify(userSession));
        updateUIState();
        appendConsoleLog('Build tries reset! 5 Free Tries added to your account.', 'success');
      });
    }


    // ══════════════════════════════════════════════════════
    // GOOGLE GEMINI API & THEME ENGINE SYNTHESIS
    // ══════════════════════════════════════════════════════
    const btnGeminiKey = document.getElementById('btn-gemini-key');
    if (btnGeminiKey) {
      btnGeminiKey.addEventListener('click', () => {
        const currentKey = localStorage.getItem('gemini_api_key') || '';
        const inputKey = prompt("Enter your Google Gemini API Key (Optional — Leave blank to use built-in Genesis multi-scroll synthesizer):", currentKey);
        if (inputKey !== null) {
          localStorage.setItem('gemini_api_key', inputKey.trim());
          if (inputKey.trim()) {
            alert("Google Gemini API Key saved! Builds will use your direct Gemini endpoint.");
          } else {
            alert("Gemini API Key cleared. System will use default Genesis Synthesizer engine.");
          }
        }
      });
    }

    async function callGeminiAPI(brandName, industryKey, options) {
      appendConsoleLog(`Initiating multi-scroll synthesis for "${brandName}" (${industryKey})...`, 'info');
      
      const geminiApiKey = localStorage.getItem('gemini_api_key') || '';

      if (geminiApiKey) {
        try {
          appendConsoleLog(`Connecting to Google Gemini API endpoint (gemini-1.5-flash)...`, 'info');
          const indLabel = selectedIndustryLabel || industryKey;
          const systemInstruction = `You are Google Gemini 1.5 Flash, an elite senior full-stack web engineer.
Generate a complete, production-ready, single-file HTML5 website for a "${indLabel}" company called "${brandName}".
CRITICAL REQUIREMENTS:
1. Multi-scroll website (at least 2 to 3 full viewport scrolls long) with top bar, sticky navbar, hero section, trust metrics, product catalog, checkout section, FAQ accordions, and footer.
2. Background color: ${options.bgColor || '#08090d'}.
3. Accent/Tab color: ${options.primaryColor || '#00f0ff'}.
4. Font family: ${options.fontKey || 'inter'}.
5. Must include multiple products with details, and when clicking "Buy Now", it must smooth-scroll to the checkout section.
6. Checkout MUST ONLY provide Pay on Delivery (Cash on Delivery / COD). DO NOT ask for credit cards or any cards.
7. Ask for customer Name, Phone, Email, Street Address, City, Zip.
8. Upon checkout submission, dynamically display an official printable/downloadable Digital Receipt.
9. Return ONLY raw HTML starting with <!DOCTYPE html>.`;

          const apiEndpoint = `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${geminiApiKey}`;
          const response = await fetch(apiEndpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{ role: "user", parts: [{ text: `${systemInstruction}\n\nBrand: ${brandName}\nIndustry: ${indLabel}` }] }],
              generationConfig: { temperature: 0.7, maxOutputTokens: 8192 }
            })
          });

          if (response.ok) {
            const data = await response.json();
            let rawCode = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
            rawCode = rawCode.replace(/```html/gi, '').replace(/```/g, '').trim();

            if (rawCode.includes('<html') || rawCode.startsWith('<!DOCTYPE')) {
              appendConsoleLog(`Direct Gemini API compilation successful!`, 'success');
              return rawCode;
            }
          }
        } catch (err) {
          appendConsoleLog(`Gemini API notice: ${err.message}. Routing via Genesis Engine...`, 'warning');
        }
      }

      // Genesis Multi-Scroll Industry Architect Engine v6.0
      appendConsoleLog(`Compiling with Genesis Multi-Scroll Engine v6.0...`, 'info');
      if (window.SYDAS_THEME_ENGINE && typeof window.SYDAS_THEME_ENGINE.buildFullWebsite === 'function') {
        return window.SYDAS_THEME_ENGINE.buildFullWebsite('generative', brandName, industryKey, options);
      }
      return `<!DOCTYPE html><html><body style="background:#090a12;color:#fff;font-family:sans-serif;padding:2rem;"><h2>${brandName}</h2><p>${industryKey} website compiled.</p></body></html>`;
    }

    async function triggerCompilation() {
      if (!selectedBrandName) {
        selectedBrandName = 'Genesis Store';
      }

      if (userSession.triesLeft <= 0) {
        updateUIState();
        return;
      }

      // Deduct 1 Try
      userSession.triesLeft--;
      localStorage.setItem('sydas_builder_session', JSON.stringify(userSession));
      updateUIState();

      // Show Sandbox Loader Overlay
      if (sandboxLoader) sandboxLoader.classList.remove('hidden');
      if (loaderStatusSub) loaderStatusSub.textContent = `Synthesizing multi-scroll COD architecture for ${selectedBrandName}...`;

      try {
        const options = {
          bgColor: selectedBgColor,
          primaryColor: selectedAccentColor,
          accentColor: selectedAccentColor,
          fontKey: selectedFontKey
        };

        const fullHtml = await callGeminiAPI(selectedBrandName, selectedIndustryKey, options);

        // Inject into IFrame
        if (sandboxIframe) {
          sandboxIframe.srcdoc = fullHtml;
        }

        // Store source code
        currentCompiledCode.html = fullHtml;
        currentCompiledCode.css = `/* Synthesized Custom Theme & Typography Styles */\n/* Embedded inline inside index.html <style> tags */`;
        currentCompiledCode.js = `// Synthesized Pay-on-Delivery & Digital Receipt Logic\n// Embedded inline inside index.html <script> tags`;

        updateCodeExplorer('html');

        // Hide Loader
        if (sandboxLoader) sandboxLoader.classList.add('hidden');

        // Append success response to chat
        appendGeminiChatMessage(`Synthesized your multi-scroll <strong class="text-gradient">${selectedIndustryLabel}</strong> website for <strong>${selectedBrandName}</strong>!<br/>
        &bull; <strong>Background:</strong> ${selectedBgColor}<br/>
        &bull; <strong>Accent / Tab:</strong> ${selectedAccentColor}<br/>
        &bull; <strong>Typography:</strong> ${selectedFontName}<br/>
        &bull; <strong>Checkout:</strong> 100% Pay on Delivery with Instant Digital Receipt.`);

        appendConsoleLog(`Multi-scroll compilation complete! Tries remaining: ${userSession.triesLeft}`, 'success');

      } catch (err) {
        if (sandboxLoader) sandboxLoader.classList.add('hidden');
        appendConsoleLog(`Compilation error: ${err.message}`, 'warning');
        alert("Compilation notice: " + err.message);
      }
    }

    if (btnCompileProject) {
      btnCompileProject.addEventListener('click', triggerCompilation);
    }


    // ══════════════════════════════════════════════════════
    // CHAT & CONSOLE HELPERS
    // ══════════════════════════════════════════════════════
    function appendGeminiChatMessage(htmlContent) {
      if (!chatHistory) return;
      const msgDiv = document.createElement('div');
      msgDiv.className = 'chat-msg gemini-msg';
      msgDiv.innerHTML = `
        <div class="msg-avatar">AI</div>
        <div class="msg-body">
          <div class="msg-sender">Google Gemini 2.5 Pro</div>
          <div class="msg-text">${htmlContent}</div>
        </div>
      `;
      chatHistory.appendChild(msgDiv);
      chatHistory.scrollTop = chatHistory.scrollHeight;
    }

    function appendConsoleLog(msg, type = 'info') {
      if (!consoleLogsOutput) return;
      const logLine = document.createElement('div');
      logLine.className = `log-line ${type}`;
      logLine.textContent = `> ${msg}`;
      consoleLogsOutput.appendChild(logLine);
      consoleLogsOutput.scrollTop = consoleLogsOutput.scrollHeight;
    }


    // ══════════════════════════════════════════════════════
    // WORKSPACE TABS & DEVICE CONTROLS
    // ══════════════════════════════════════════════════════
    wsTabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTabId = btn.getAttribute('data-tab');
        wsTabBtns.forEach(b => b.classList.remove('active'));
        wsTabContents.forEach(c => c.classList.add('hidden'));

        btn.classList.add('active');
        const targetTab = document.getElementById(targetTabId);
        if (targetTab) targetTab.classList.remove('hidden');
      });
    });

    if (btnDeviceDesktop && btnDeviceMobile && sandboxWrapper) {
      btnDeviceDesktop.addEventListener('click', () => {
        btnDeviceDesktop.classList.add('active');
        btnDeviceMobile.classList.remove('active');
        sandboxWrapper.classList.remove('mobile-device-mode');
      });

      btnDeviceMobile.addEventListener('click', () => {
        btnDeviceMobile.classList.add('active');
        btnDeviceDesktop.classList.remove('active');
        sandboxWrapper.classList.add('mobile-device-mode');
      });
    }

    if (btnReloadSandbox && sandboxIframe) {
      btnReloadSandbox.addEventListener('click', () => {
        const currentSrc = sandboxIframe.srcdoc;
        sandboxIframe.srcdoc = '';
        setTimeout(() => { sandboxIframe.srcdoc = currentSrc; }, 100);
      });
    }

    fileBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        fileBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const fileKey = btn.getAttribute('data-file');
        updateCodeExplorer(fileKey);
      });
    });

    function updateCodeExplorer(fileKey) {
      if (!codeContent) return;
      if (fileKey === 'css') {
        codeContent.textContent = currentCompiledCode.css || '/* styles.css */';
      } else if (fileKey === 'js') {
        codeContent.textContent = currentCompiledCode.js || '// app.js';
      } else {
        codeContent.textContent = currentCompiledCode.html || '<!DOCTYPE html>\n<html>\n  <body>Select or build a project first.</body>\n</html>';
      }
    }

    if (btnClearConsole && consoleLogsOutput) {
      btnClearConsole.addEventListener('click', () => {
        consoleLogsOutput.innerHTML = '<div class="log-line info">> Console cleared. Ready.</div>';
      });
    }

    if (transmitForm) {
      transmitForm.addEventListener('submit', (e) => {
        e.preventDefault();
        alert("Thank you! Your project blueprints and customization requirements have been transmitted to the SYDAS.x engineering team. We will get in touch with you shortly!");
      });
    }

    // Initial state sync
    updateUIState();
  });
</script>

