---
---

<!-- Uncatchable Intimidating Primary Rocket & Enemy Space Battle Engine -->
<div id="space-battle-canvas-container" class="space-battle-container" aria-hidden="true">
  <!-- HTML Overlay for Taunt Bubble -->
  <div id="rocket-taunt" class="rocket-taunt">Catch me if you can!</div>

  <!-- Primary Invincible Player Rocket -->
  <div id="rocket-ship" class="rocket-ship">
    <svg width="38" height="38" viewBox="0 0 24 24" fill="none" class="rocket-svg" xmlns="http://www.w3.org/2000/svg">
      <!-- Forcefield Shield Aura -->
      <circle cx="12" cy="12" r="11" fill="none" stroke="#00F0FF" stroke-width="0.9" stroke-dasharray="3 2" class="player-shield" />
      <!-- Nose Cone & Body -->
      <path d="M12 1C12 1 17 5 17 12C17 15.5 15 17.5 15 17.5L12 16L9 17.5C9 17.5 7 15.5 7 12C7 5 12 1 12 1Z" fill="#00F0FF" stroke="#FFFFFF" stroke-width="1" />
      <path d="M12 1C12 1 14.5 4.5 14.5 8.5H9.5C9.5 4.5 12 1 12 1Z" fill="#FF007A" />
      <!-- Cockpit Window -->
      <circle cx="12" cy="9.5" r="2.2" fill="#05050A" stroke="#00F0FF" stroke-width="1" />
      <circle cx="12.7" cy="8.8" r="0.7" fill="#FFFFFF" />
      <!-- Left & Right Wings -->
      <path d="M7 11.5L3.5 15L7 16V11.5Z" fill="#7000FF" stroke="#FFFFFF" stroke-width="0.5" />
      <path d="M17 11.5L20.5 15L17 16V11.5Z" fill="#7000FF" stroke="#FFFFFF" stroke-width="0.5" />
      <!-- Thruster Flame -->
      <path class="rocket-flame flame-outer" d="M9.5 17.5L12 23.5L14.5 17.5Z" fill="#FF9900" />
      <path class="rocket-flame flame-inner" d="M10.5 17.5L12 21.5L13.5 17.5Z" fill="#FFFF00" />
    </svg>
  </div>

  <!-- Battle Lasers, Explosions & Particles Canvas -->
  <canvas id="battle-canvas" class="battle-canvas"></canvas>
</div>

<style>
  .space-battle-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 999995;
    pointer-events: none;
    overflow: hidden;
  }

  .battle-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Primary Player Rocket */
  .rocket-ship {
    position: absolute;
    top: 0;
    left: 0;
    width: 42px;
    height: 42px;
    z-index: 999999;
    pointer-events: auto;
    user-select: none;
    will-change: transform;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 0 12px rgba(0, 240, 255, 0.9)) drop-shadow(0 0 22px rgba(112, 0, 255, 0.6));
  }

  .rocket-svg {
    image-rendering: pixelated;
    transform-origin: center center;
  }

  .player-shield {
    animation: shieldSpin 2.5s linear infinite;
  }

  @keyframes shieldSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Animated Flame */
  .rocket-flame {
    animation: flameFlicker 0.1s infinite alternate ease-in-out;
    transform-origin: center top;
  }

  @keyframes flameFlicker {
    0% { transform: scaleY(1) scaleX(1); opacity: 0.9; }
    100% { transform: scaleY(1.4) scaleX(0.8); opacity: 1; }
  }

  /* Taunt Speech Bubble */
  .rocket-taunt {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1000000;
    background: rgba(10, 10, 22, 0.95);
    border: 1px solid #00F0FF;
    box-shadow: 0 0 16px rgba(0, 240, 255, 0.6);
    color: #FFFFFF;
    font-family: monospace;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.35rem 0.65rem;
    border-radius: 8px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate3d(-50%, -45px, 0) scale(0.85);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .rocket-taunt.visible {
    opacity: 1;
    transform: translate3d(-50%, -45px, 0) scale(1);
  }

  /* Quantum Warp Effect */
  .rocket-ship.warp-flash {
    animation: quantumWarp 0.3s ease-out;
  }

  @keyframes quantumWarp {
    0% { filter: brightness(3) drop-shadow(0 0 35px #FF007A); transform: scale(1.6); }
    100% { filter: drop-shadow(0 0 12px rgba(0, 240, 255, 0.9)); transform: scale(1); }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('battle-canvas');
    const shipEl = document.getElementById('rocket-ship');
    const tauntEl = document.getElementById('rocket-taunt');

    if (!canvas || !shipEl || !tauntEl) return;

    const ctx = canvas.getContext('2d');
    
    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // Player Rocket State
    let px = window.innerWidth * 0.75;
    let py = window.innerHeight * 0.3;
    let pvx = (Math.random() - 0.5) * 2;
    let pvy = (Math.random() - 0.5) * 2;
    let pAngle = 0;
    let mouseX = -9999;
    let mouseY = -9999;
    let lastTauntTime = 0;
    let playerShootCooldown = 0;
    let screenShake = 0;

    // Green Enemy Ships State (Color: Green #00FF66)
    const MAX_ENEMIES = 4;
    let enemies = [];

    // Battle Objects Arrays
    let lasers = [];
    let particles = [];
    let shockwaves = [];
    let explosionTexts = [];

    const TAUNTS = [
      "Catch me if you can!",
      "Too slow!",
      "Nice try!",
      "SYDAS.x Speed Activated!",
      "99 Years Ahead of You!",
      "Quantum Dodge!",
      "Untouchable Rocket!",
      "SYDAS.x Dominance!"
    ];

    // Spawn 1 Green Enemy Ship
    function spawnEnemy() {
      const margin = 60;
      let ex, ey;

      if (Math.random() < 0.5) {
        ex = Math.random() < 0.5 ? -margin : window.innerWidth + margin;
        ey = Math.random() * window.innerHeight;
      } else {
        ex = Math.random() * window.innerWidth;
        ey = Math.random() < 0.5 ? -margin : window.innerHeight + margin;
      }

      enemies.push({
        id: Math.random().toString(36).substr(2, 9),
        x: ex,
        y: ey,
        vx: (Math.random() - 0.5) * 3,
        vy: (Math.random() - 0.5) * 3,
        angle: 0,
        size: 26,
        color: '#00FF66',
        hp: 1,
        shootCooldown: Math.floor(Math.random() * 40) + 20
      });
    }

    // Initialize Fleet
    for (let i = 0; i < MAX_ENEMIES; i++) {
      spawnEnemy();
    }

    // Mouse & Touch Movement
    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
    });

    window.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        mouseX = e.touches[0].clientX;
        mouseY = e.touches[0].clientY;
      }
    });

    // Taunt Trigger
    function triggerTaunt(forceText) {
      const now = Date.now();
      if (now - lastTauntTime < 1400 && !forceText) return;
      lastTauntTime = now;

      const randomText = forceText || TAUNTS[Math.floor(Math.random() * TAUNTS.length)];
      tauntEl.textContent = randomText;
      tauntEl.classList.add('visible');

      setTimeout(() => {
        tauntEl.classList.remove('visible');
      }, 1600);
    }

    // Emergency Evasion Trigger
    shipEl.addEventListener('mouseenter', () => doEvasionBoost(true));
    shipEl.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      doEvasionBoost(true);
    });

    function doEvasionBoost(isEmergency) {
      const dx = px - mouseX;
      const dy = py - mouseY;
      let escapeAngle = Math.atan2(dy, dx);
      if (dx === 0 && dy === 0) escapeAngle = Math.random() * Math.PI * 2;

      const boostSpeed = isEmergency ? 28 : 16;
      pvx = Math.cos(escapeAngle) * boostSpeed;
      pvy = Math.sin(escapeAngle) * boostSpeed;

      triggerTaunt(isEmergency ? "Quantum Warp!" : null);

      if (isEmergency) {
        shipEl.classList.add('warp-flash');
        setTimeout(() => shipEl.classList.remove('warp-flash'), 300);
      }
    }

    // Destroy enemy cleanly without explosion animations
    function explodeEnemy(ex, ey) {
      // RESPOND RULE: 1 Destroyed = 1 New Green Enemy Spawned!
      spawnEnemy();
    }

    // Main Game & Physics Loop
    function gameLoop() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Screen Shake Handling
      if (screenShake > 0) {
        ctx.save();
        const shakeX = (Math.random() - 0.5) * screenShake;
        const shakeY = (Math.random() - 0.5) * screenShake;
        ctx.translate(shakeX, shakeY);
        screenShake *= 0.85;
        if (screenShake < 0.5) screenShake = 0;
      }

      // ==========================================
      // 1. PLAYER ROCKET MECHANICS & EVASION
      // ==========================================
      const threshold = 180;
      const dx = px - mouseX;
      const dy = py - mouseY;
      const dist = Math.hypot(dx, dy);

      if (dist < threshold) {
        const escapeAngle = Math.atan2(dy, dx);
        const force = (threshold - dist) / threshold * 2.5;
        pvx += Math.cos(escapeAngle) * force;
        pvy += Math.sin(escapeAngle) * force;
        if (dist < 80) triggerTaunt();
      }

      // Target Nearest Green Enemy
      let targetEnemy = null;
      let minDist = Infinity;
      enemies.forEach(e => {
        const edist = Math.hypot(e.x - px, e.y - py);
        if (edist < minDist) {
          minDist = edist;
          targetEnemy = e;
        }
      });

      if (targetEnemy && dist >= threshold) {
        const tax = targetEnemy.x - px;
        const tay = targetEnemy.y - py;
        const tdist = Math.hypot(tax, tay);
        if (tdist > 40) {
          pvx += (tax / tdist) * 0.35;
          pvy += (tay / tdist) * 0.35;
        }
      }

      const maxSpeed = dist < threshold ? 25 : 8;
      const currentSpeed = Math.hypot(pvx, pvy);
      if (currentSpeed > maxSpeed) {
        pvx = (pvx / currentSpeed) * maxSpeed;
        pvy = (pvy / currentSpeed) * maxSpeed;
      }
      pvx *= 0.94;
      pvy *= 0.94;

      px += pvx;
      py += pvy;

      const W = window.innerWidth;
      const H = window.innerHeight;
      const margin = 30;
      if (px < margin) { px = margin; pvx = Math.abs(pvx) + 8; if (mouseX < 100) px = W - 100; }
      else if (px > W - margin) { px = W - margin; pvx = -Math.abs(pvx) - 8; if (mouseX > W - 100) px = 100; }
      if (py < margin) { py = margin; pvy = Math.abs(pvy) + 8; if (mouseY < 100) py = H - 100; }
      else if (py > H - margin) { py = H - margin; pvy = -Math.abs(pvy) - 8; if (mouseY > H - 100) py = 100; }

      if (Math.hypot(pvx, pvy) > 0.5) {
        const targetAngle = Math.atan2(pvy, pvx) * (180 / Math.PI) + 90;
        pAngle += (targetAngle - pAngle) * 0.18;
      }

      // Render Player Ship DOM transform
      shipEl.style.transform = `translate3d(${px - 21}px, ${py - 21}px, 0) rotate(${pAngle}deg)`;
      tauntEl.style.transform = `translate3d(${px}px, ${py - 10}px, 0) scale(${tauntEl.classList.contains('visible') ? 1 : 0.85})`;

      // ==========================================
      // 2. PLAYER LASER FIRING AT ENEMIES
      // ==========================================
      playerShootCooldown--;
      if (playerShootCooldown <= 0 && targetEnemy) {
        playerShootCooldown = 15;
        const fireAngle = Math.atan2(targetEnemy.y - py, targetEnemy.x - px);
        const lSpeed = 16;
        lasers.push({
          x: px,
          y: py,
          vx: Math.cos(fireAngle) * lSpeed,
          vy: Math.sin(fireAngle) * lSpeed,
          isPlayer: true,
          color: '#00F0FF',
          life: 60
        });
      }

      // ==========================================
      // 3. GREEN ENEMY SHIPS AI & FIRING
      // ==========================================
      for (let i = enemies.length - 1; i >= 0; i--) {
        const e = enemies[i];

        const edx = px - e.x;
        const edy = py - e.y;
        const edist = Math.hypot(edx, edy);

        if (edist > 10) {
          e.vx += (edx / edist) * 0.18;
          e.vy += (edy / edist) * 0.18;
        }

        e.vx += (Math.random() - 0.5) * 0.5;
        e.vy += (Math.random() - 0.5) * 0.5;

        e.vx *= 0.95;
        e.vy *= 0.95;

        e.x += e.vx;
        e.y += e.vy;

        e.angle = Math.atan2(e.vy, e.vx) + Math.PI / 2;

        e.shootCooldown--;
        if (e.shootCooldown <= 0) {
          e.shootCooldown = 45;
          const eFireAngle = Math.atan2(py - e.y, px - e.x);
          const elSpeed = 10;
          lasers.push({
            x: e.x,
            y: e.y,
            vx: Math.cos(eFireAngle) * elSpeed,
            vy: Math.sin(eFireAngle) * elSpeed,
            isPlayer: false,
            color: '#00FF66',
            life: 70
          });
        }

        // Ramming Collision: Player Rocket crushes Green Enemy Ship!
        if (edist < 35) {
          explodeEnemy(e.x, e.y);
          enemies.splice(i, 1);
          triggerTaunt("SYDAS.Xxx CRUSH!");
          continue;
        }

        // Draw Green Enemy Ship
        ctx.save();
        ctx.translate(e.x, e.y);
        ctx.rotate(e.angle);

        ctx.fillStyle = '#00FF66';
        ctx.shadowColor = '#00FF66';
        ctx.shadowBlur = 12;

        ctx.beginPath();
        ctx.moveTo(0, -14);
        ctx.lineTo(11, 12);
        ctx.lineTo(4, 8);
        ctx.lineTo(0, 14);
        ctx.lineTo(-4, 8);
        ctx.lineTo(-11, 12);
        ctx.closePath();
        ctx.fill();

        ctx.fillStyle = '#FF0055';
        ctx.beginPath();
        ctx.arc(0, -2, 3, 0, Math.PI * 2);
        ctx.fill();

        ctx.restore();
      }

      // ==========================================
      // 4. LASER PHYSICS & HIT DETECTION
      // ==========================================
      for (let i = lasers.length - 1; i >= 0; i--) {
        const l = lasers[i];
        l.x += l.vx;
        l.y += l.vy;
        l.life--;

        ctx.save();
        ctx.strokeStyle = l.color;
        ctx.lineWidth = l.isPlayer ? 3.5 : 2;
        ctx.shadowColor = l.color;
        ctx.shadowBlur = 14;

        ctx.beginPath();
        ctx.moveTo(l.x, l.y);
        ctx.lineTo(l.x - l.vx * 1.5, l.y - l.vy * 1.5);
        ctx.stroke();
        ctx.restore();

        if (l.isPlayer) {
          for (let j = enemies.length - 1; j >= 0; j--) {
            const e = enemies[j];
            if (Math.hypot(l.x - e.x, l.y - e.y) < 24) {
              explodeEnemy(e.x, e.y);
              enemies.splice(j, 1);
              lasers.splice(i, 1);
              break;
            }
          }
        } else {
          // Deflect off Player Shield
          if (Math.hypot(l.x - px, l.y - py) < 25) {
            lasers.splice(i, 1);
            for (let s = 0; s < 6; s++) {
              particles.push({
                x: px,
                y: py,
                vx: (Math.random() - 0.5) * 8,
                vy: (Math.random() - 0.5) * 8,
                size: 2,
                color: '#00F0FF',
                life: 0.6,
                decay: 0.08
              });
            }
          }
        }

        if (l.life <= 0 || l.x < -50 || l.x > W + 50 || l.y < -50 || l.y > H + 50) {
          lasers.splice(i, 1);
        }
      }

      // ==========================================
      // 5. CANVAS EXPLOSION TEXTS (PURE CANVAS RENDERING - NO DOM REMNANTS)
      // ==========================================
      for (let i = explosionTexts.length - 1; i >= 0; i--) {
        const et = explosionTexts[i];
        et.y += et.vy;
        et.scale += (et.maxScale - et.scale) * 0.15;
        et.opacity -= 0.025;

        ctx.save();
        ctx.translate(et.x, et.y);
        ctx.scale(et.scale, et.scale);
        ctx.globalAlpha = Math.max(0, et.opacity);

        // Main Glow Title: SYDAS.Xxx
        ctx.font = '900 24px "Outfit", sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillStyle = '#00F0FF';
        ctx.shadowColor = '#FF007A';
        ctx.shadowBlur = 25;
        ctx.fillText(et.text, 0, 0);

        // Subtext: DESTINATION CLEARED
        ctx.font = '800 10px monospace';
        ctx.fillStyle = '#CCFF00';
        ctx.shadowColor = '#00F0FF';
        ctx.shadowBlur = 12;
        ctx.fillText(et.subtext, 0, 18);

        ctx.restore();

        if (et.opacity <= 0) {
          explosionTexts.splice(i, 1);
        }
      }

      // ==========================================
      // 6. SHOCKWAVE RINGS RENDER
      // ==========================================
      for (let i = shockwaves.length - 1; i >= 0; i--) {
        const sw = shockwaves[i];
        sw.r += (sw.maxR - sw.r) * 0.15;
        sw.opacity -= 0.035;

        ctx.save();
        ctx.beginPath();
        ctx.arc(sw.x, sw.y, sw.r, 0, Math.PI * 2);
        ctx.strokeStyle = sw.color;
        ctx.lineWidth = sw.width;
        ctx.shadowColor = sw.color;
        ctx.shadowBlur = 15;
        ctx.globalAlpha = Math.max(0, sw.opacity);
        ctx.stroke();
        ctx.restore();

        if (sw.opacity <= 0 || sw.r >= sw.maxR - 2) {
          shockwaves.splice(i, 1);
        }
      }

      // ==========================================
      // 7. EXPLOSION PARTICLES RENDER
      // ==========================================
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.life -= p.decay;

        ctx.save();
        ctx.globalAlpha = Math.max(0, p.life);
        ctx.fillStyle = p.color;
        ctx.shadowColor = p.color;
        ctx.shadowBlur = 10;
        ctx.fillRect(p.x - p.size / 2, p.y - p.size / 2, p.size, p.size);
        ctx.restore();

        if (p.life <= 0) {
          particles.splice(i, 1);
        }
      }

      if (screenShake > 0) ctx.restore();

      requestAnimationFrame(gameLoop);
    }

    requestAnimationFrame(gameLoop);
  });
</script>
