---
---

<section class="hero">
  <div class="hero-bg-image bg-1" style="background-image: url('/images/egyptian-bg.png');"></div>
  <div class="hero-bg-image bg-2" style="background-image: url('/images/japanese-bg.png');"></div>
  <div class="hero-bg-image bg-3" style="background-image: url('/images/norse-bg.png');"></div>
  <div class="hero-bg-image bg-4" style="background-image: url('/images/greek-bg.png');"></div>
  <div class="hero-bg-image bg-5" style="background-image: url('/images/mayan-bg.png');"></div>
  
  <div class="hero-bg-glow cyan-glow"></div>
  <div class="hero-bg-glow purple-glow"></div>
  
  <div class="container hero-container">
    

    <h1 class="hero-title">
      Architecting the <span class="text-gradient">Future</span> of Digital Experiences
    </h1>

    <p class="hero-subtitle">
      We build world-class applications, stunning websites, and bespoke software solutions. Designed for performance. Crafted like art.
    </p>

    <div class="hero-actions">
      <a href="#builder" class="btn btn-primary">
        <span>Initialize Project</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
      <a href="#services" class="btn btn-outline">
        <span>Explore Services</span>
      </a>
    </div>

  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding: 6rem 0 4rem;
    overflow: hidden;
  }

  .hero-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    z-index: 0;
    mix-blend-mode: luminosity;
    mask-image: linear-gradient(to bottom, black 30%, rgba(0, 0, 0, 0.4) 75%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 30%, rgba(0, 0, 0, 0.4) 75%, transparent 100%);
    animation: crossfade 25s infinite linear;
  }

  .bg-1 { animation-delay: 0s; }
  .bg-2 { animation-delay: 5s; }
  .bg-3 { animation-delay: 10s; }
  .bg-4 { animation-delay: 15s; }
  .bg-5 { animation-delay: 20s; }

  @keyframes crossfade {
    0% { opacity: 0; transform: scale(1); }
    10% { opacity: 0.15; transform: scale(1.02); }
    20% { opacity: 0.15; transform: scale(1.04); }
    30% { opacity: 0; transform: scale(1.06); }
    100% { opacity: 0; transform: scale(1.1); }
  }

  .hero-bg-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    z-index: 0;
    opacity: 0.15;
    animation: pulseGlow 8s ease-in-out infinite alternate;
    will-change: opacity, transform;
  }

  .cyan-glow {
    top: -10%;
    left: 20%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, var(--accent-cyan) 0%, transparent 70%);
  }

  .purple-glow {
    bottom: -10%;
    right: 10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, var(--accent-purple) 0%, transparent 70%);
    animation-delay: -4s;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-full);
    background: rgba(0, 240, 255, 0.05);
    border: 1px solid rgba(0, 240, 255, 0.3);
    box-shadow: var(--shadow-neon);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2.5rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-cyan);
    box-shadow: 0 0 10px var(--accent-cyan);
    animation: blink 2s infinite;
  }

  .hero-title {
    font-size: clamp(3rem, 6vw, 5rem);
    letter-spacing: -0.04em;
    margin-bottom: 1.5rem;
    max-width: 1000px;
    text-transform: uppercase;
    line-height: 1;
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--text-secondary);
    max-width: 700px;
    margin-bottom: 3.5rem;
    font-weight: 300;
  }

  .hero-actions {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  @keyframes pulseGlow {
    0% { transform: scale(1); opacity: 0.3; }
    100% { transform: scale(1.1); opacity: 0.5; }
  }
</style>
