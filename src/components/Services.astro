<style>
  .services {
    padding: 7rem 0 6rem;
    position: relative;
    width: 100%;
    overflow: hidden;
    background: radial-gradient(circle at 50% 30%, rgba(13, 17, 30, 0.7) 0%, rgba(6, 8, 14, 0.95) 100%);
  }

  .services-glow {
    position: absolute;
    width: 550px;
    height: 550px;
    border-radius: 50%;
    filter: blur(140px);
    opacity: 0.15;
    pointer-events: none;
    z-index: 0;
  }

  .left-glow {
    top: 10%;
    left: -150px;
    background: var(--accent-cyan);
  }

  .right-glow {
    bottom: 10%;
    right: -150px;
    background: var(--accent-purple);
  }

  /* ═══════════════════════════════════════════════════════════════════ */
  /* FULL BACKGROUND QUIRKY CHARACTER PARADE ANIMATION                   */
  /* Exact Editorial Flat Vector Aesthetic from Reference Image          */
  /* ═══════════════════════════════════════════════════════════════════ */
  .capabilities-bg-parade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
    opacity: 0.55;
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease;
  }

  /* Boost parade glow and presence when hovering on Mobile Architecture */
  .services:has(.mobile-service-card:hover) .capabilities-bg-parade,
  .services:has(.mobile-service-card:focus-within) .capabilities-bg-parade {
    opacity: 1;
    filter: drop-shadow(0 0 20px rgba(0, 240, 255, 0.25));
  }

  .services:has(.mobile-service-card:hover) .actor-speech {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .services:has(.mobile-service-card:hover) .parade-endless-track {
    animation-duration: 14s; /* Hilarious turbo walking speed when hovered */
  }

  /* Endless Walking Track (2x width for continuous scroll) */
  .parade-endless-track {
    position: absolute;
    bottom: 30px;
    left: 0;
    width: 200%;
    display: flex;
    align-items: flex-end;
    animation: paradeMarchAcross 26s linear infinite;
  }

  @keyframes paradeMarchAcross {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .parade-troupe {
    width: 50%;
    display: flex;
    justify-content: space-around;
    align-items: flex-end;
    padding: 0 4vw;
  }

  /* Individual Character Stage */
  .character-actor {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform-origin: bottom center;
  }

  .char-svg {
    display: block;
    overflow: visible;
  }

  /* Character 1: Pink Noodle */
  .actor-pink-noodle .char-svg {
    width: 100px;
    height: 165px;
    animation: noodleBob 0.65s ease-in-out infinite alternate;
  }

  @keyframes noodleBob {
    0% { transform: translateY(0) rotate(-2deg); }
    100% { transform: translateY(-8px) rotate(3deg); }
  }

  .actor-pink-noodle .leg-left {
    transform-origin: 48px 135px;
    animation: noodleLegL 0.65s ease-in-out infinite alternate;
  }

  .actor-pink-noodle .leg-right {
    transform-origin: 72px 135px;
    animation: noodleLegR 0.65s ease-in-out infinite alternate 0.32s;
  }

  @keyframes noodleLegL {
    0% { transform: rotate(18deg); }
    100% { transform: rotate(-22deg); }
  }

  @keyframes noodleLegR {
    0% { transform: rotate(-22deg); }
    100% { transform: rotate(18deg); }
  }

  .actor-pink-noodle .arm-w1 {
    transform-origin: 42px 108px;
    animation: noodleArmSwing1 0.7s infinite alternate ease-in-out;
  }

  .actor-pink-noodle .arm-w2 {
    transform-origin: 78px 108px;
    animation: noodleArmSwing2 0.7s infinite alternate ease-in-out 0.35s;
  }

  @keyframes noodleArmSwing1 {
    0% { transform: rotate(-25deg); }
    100% { transform: rotate(30deg); }
  }

  @keyframes noodleArmSwing2 {
    0% { transform: rotate(30deg); }
    100% { transform: rotate(-25deg); }
  }

  /* Character 2: Tall Blue Star Strutter */
