---
const services = [
  {
    id: "mobile-architecture",
    title: "Mobile Architecture",
    description: "Native and cross-platform mobile applications engineered for ultimate performance and fluid UX.",
    isMobile: true
  },
  {
    id: "web-platforms",
    title: "Web Platforms",
    description: "High-conversion, ultra-fast web experiences built with next-gen frameworks like Astro, React, and Vue."
  },
  {
    id: "enterprise-software",
    title: "Enterprise Software",
    description: "Bespoke internal tools, CRM systems, and scalable backend infrastructures tailored to your exact needs."
  },
  {
    id: "interactive-experiences",
    title: "Interactive Experiences",
    description: "Web-based games, 3D product configurators, and immersive WebGL experiences that captivate users."
  }
];
---

<section id="services" class="services">
  <!-- Full Width Background Glows -->
  <div class="services-glow left-glow"></div>
  <div class="services-glow right-glow"></div>

  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        World-Class <span class="text-gradient">Capabilities</span>
      </h2>
      <p class="section-subtitle">
        We forge digital solutions that push the boundaries of technology and design.
      </p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <div class={`service-card glass-panel ${service.isMobile ? 'mobile-service-card' : ''}`} tabindex="0">
          <div class="service-header">
            <h3 class="service-title">{service.title}</h3>
            <span class="hover-indicator" aria-hidden="true">+</span>
          </div>
          <div class="service-details">
            <p class="service-description">{service.description}</p>
            
            {service.isMobile && (
              <div class="funny-mobile-showcase">
                <!-- Hilarious Animated Mobile Architecture Rig -->
                <div class="funny-phone-stage">
                  <div class="funny-phone-character">
                    <!-- Builder Hardhat on top of phone -->
                    <div class="phone-hat-wrap">
                      <span class="phone-hat">👷</span>
                      <span class="phone-wifi-horns">📡</span>
                    </div>

                    <!-- Smartphone Body -->
                    <div class="phone-chassis">
                      <!-- Notch & Status Bar -->
                      <div class="phone-top-bar">
                        <span class="phone-time">9:41</span>
                        <div class="phone-speaker-notch"></div>
                        <span class="phone-battery">🔋100%</span>
                      </div>

                      <!-- Interactive Phone Screen -->
                      <div class="phone-screen">
                        <!-- Funny Push Notification -->
                        <div class="funny-push-notif">
                          <span class="notif-app-icon">🤖</span>
                          <div class="notif-copy">
                            <span class="notif-sender">App Store Bot:</span>
                            <span class="notif-msg">"0 crash reports! Did you bribe the CPU?"</span>
                          </div>
                        </div>

                        <!-- Animated Expressive Face -->
                        <div class="phone-avatar-face">
                          <div class="avatar-eyes">
                            <span class="face-eye left"></span>
                            <span class="face-eye right"></span>
                          </div>
                          <div class="avatar-mouth"></div>
                          <div class="avatar-shades">😎</div>
                        </div>

                        <!-- Live Terminal Jokes -->
                        <div class="phone-code-ticker">
                          <div class="ticker-text">⚡ 60 FPS ➔ 120 FPS ➔ 999 FPS Overclocked!</div>
                          <div class="ticker-sub">☕ Bugs swallowed: 0 remaining</div>
                        </div>

                        <!-- Frantic Robotic Finger Tapping -->
                        <div class="hyper-finger-actor">
                          <span class="finger-pointer">👆</span>
                          <span class="sparkle sp1">✨</span>
                          <span class="sparkle sp2">💥</span>
                          <span class="sparkle sp3">⚡</span>
                        </div>
                      </div>

                      <!-- Comical Dancing Feet -->
                      <div class="phone-dancing-shoes">
                        <span class="shoe s-left">👟</span>
                        <span class="shoe s-right">👟</span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- World-Class Architecture Guarantee Badge -->
                <div class="funny-badge-pill">
                  <span class="pill-radar"></span>
                  <span><strong>Architecture:</strong> Zero Lag • Quantum Smooth • Coffee Powered</span>
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding: 6rem 0;
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .services-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.12;
    pointer-events: none;
  }

  .left-glow {
    top: 10%;
    left: -150px;
    background: var(--accent-cyan);
  }

  .right-glow {
    bottom: 10%;
    right: -150px;
    background: var(--accent-purple);
  }

  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 4rem;
  }

  .section-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .section-subtitle {
    color: var(--text-secondary);
    font-size: 1.2rem;
    font-weight: 300;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
    width: 100%;
    align-items: start;
  }

  .service-card {
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    z-index: 1;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
  }

  .service-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 1rem;
  }

  .service-title {
    font-size: 1.3rem;
    margin-bottom: 0;
    color: var(--text-primary);
    position: relative;
    z-index: 2;
    transition: color 0.3s ease;
    line-height: 1.35;
  }

  .hover-indicator {
    font-size: 1.25rem;
    color: var(--accent-cyan);
    opacity: 0.6;
    transition: transform 0.35s ease, opacity 0.35s ease, color 0.35s ease;
    font-weight: 300;
    flex-shrink: 0;
  }

  /* Details Hidden by Default */
  .service-details {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(8px);
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), 
                opacity 0.35s ease, 
                transform 0.35s ease,
                margin-top 0.35s ease;
    margin-top: 0;
    width: 100%;
  }

  .service-description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    position: relative;
    z-index: 2;
  }

  /* Reveal Details ONLY on Hover / Focus - NO GLOW EFFECT */
  .service-card:hover,
  .service-card:focus-within {
    box-shadow: none;
    border-color: rgba(255, 255, 255, 0.12);
  }

  .service-card:hover .service-title,
  .service-card:focus-within .service-title {
    color: var(--accent-cyan);
  }

  .service-card:hover .hover-indicator,
  .service-card:focus-within .hover-indicator {
    transform: rotate(45deg);
    opacity: 1;
    color: var(--accent-purple);
  }

  .service-card:hover .service-details,
  .service-card:focus-within .service-details {
    max-height: 160px;
    opacity: 1;
    transform: translateY(0);
    margin-top: 1rem;
  }

  /* Expanded height for Mobile Architecture funny animation card */
  .service-card.mobile-service-card:hover .service-details,
  .service-card.mobile-service-card:focus-within .service-details {
    max-height: 520px;
  }

  /* ═══════════════════════════════════════════════════════ */
  /* FUNNY MOBILE ARCHITECTURE ANIMATION STYLES              */
  /* ═══════════════════════════════════════════════════════ */
  .funny-mobile-showcase {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px dashed rgba(0, 240, 255, 0.25);
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .funny-phone-stage {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0.75rem 0;
    perspective: 800px;
  }

  .funny-phone-character {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: phoneWiggle 2.8s ease-in-out infinite;
    transform-origin: bottom center;
  }

  @keyframes phoneWiggle {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    25% { transform: translateY(-6px) rotate(-3deg); }
    50% { transform: translateY(-2px) rotate(1deg); }
    75% { transform: translateY(-7px) rotate(3deg); }
  }

  /* Builder Hardhat & Antenna */
  .phone-hat-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 85%;
    margin-bottom: -6px;
    z-index: 10;
    pointer-events: none;
  }

  .phone-hat {
    font-size: 1.4rem;
    filter: drop-shadow(0 2px 6px rgba(255, 200, 0, 0.5));
    animation: hatBounce 1.4s ease-in-out infinite alternate;
  }

  @keyframes hatBounce {
    0% { transform: rotate(-5deg) translateY(0); }
    100% { transform: rotate(5deg) translateY(-3px); }
  }

  .phone-wifi-horns {
    font-size: 1.1rem;
    animation: wifiSignal 1.2s ease-in-out infinite alternate;
  }

  @keyframes wifiSignal {
    0% { opacity: 0.5; transform: scale(0.9); }
    100% { opacity: 1; transform: scale(1.2) translateY(-2px); filter: drop-shadow(0 0 8px #00f0ff); }
  }

  /* Smartphone Chassis */
  .phone-chassis {
    width: 190px;
    background: linear-gradient(145deg, #1e222d, #0d0f14);
    border: 2px solid rgba(0, 240, 255, 0.4);
    border-radius: 24px;
    padding: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7),
                0 0 20px rgba(0, 240, 255, 0.25),
                inset 0 0 12px rgba(255, 255, 255, 0.05);
    position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .mobile-service-card:hover .phone-chassis {
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.8),
                0 0 25px rgba(0, 240, 255, 0.4),
                inset 0 0 12px rgba(0, 240, 255, 0.15);
  }

  /* Top Bar / Notch */
  .phone-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2px 6px 4px;
    font-family: monospace;
    font-size: 0.6rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .phone-speaker-notch {
    width: 38px;
    height: 4px;
    background: #000000;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* OLED Screen */
  .phone-screen {
    background: #06080d;
    border-radius: 16px;
    padding: 8px 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    overflow: hidden;
    min-height: 140px;
  }

  /* Funny Push Notification */
  .funny-push-notif {
    width: 100%;
    background: rgba(0, 240, 255, 0.08);
    border: 1px solid rgba(0, 240, 255, 0.3);
    border-radius: 8px;
    padding: 4px 6px;
    display: flex;
    align-items: center;
    gap: 5px;
    animation: notifSlideDown 4s ease-in-out infinite;
    backdrop-filter: blur(4px);
  }

  @keyframes notifSlideDown {
    0%, 15% { transform: translateY(-30px); opacity: 0; }
    25%, 85% { transform: translateY(0); opacity: 1; }
    95%, 100% { transform: translateY(-30px); opacity: 0; }
  }

  .notif-app-icon {
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .notif-copy {
    display: flex;
    flex-direction: column;
    text-align: left;
    overflow: hidden;
  }

  .notif-sender {
    font-size: 0.58rem;
    font-weight: 800;
    color: var(--accent-cyan);
    white-space: nowrap;
  }

  .notif-msg {
    font-size: 0.52rem;
    color: #ffffff;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Expressive LED Avatar Face */
  .phone-avatar-face {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 4px 0;
  }

  .avatar-eyes {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .face-eye {
    width: 7px;
    height: 7px;
    background: var(--accent-cyan);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent-cyan);
    animation: eyeBlink 3.5s infinite;
  }

  @keyframes eyeBlink {
    0%, 92%, 100% { transform: scaleY(1); }
    95% { transform: scaleY(0.1); }
  }

  .avatar-mouth {
    width: 14px;
    height: 6px;
    border-bottom: 2px solid var(--accent-cyan);
    border-radius: 0 0 10px 10px;
    margin-top: 3px;
    box-shadow: 0 2px 4px rgba(0, 240, 255, 0.4);
  }

  .avatar-shades {
    position: absolute;
    top: -5px;
    font-size: 1.1rem;
    opacity: 0;
    transform: scale(0.5) rotate(-10deg);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .mobile-service-card:hover .avatar-shades {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }

  /* Live Terminal Joke Ticker */
  .phone-code-ticker {
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 3px 5px;
    width: 100%;
    text-align: center;
    font-family: monospace;
  }

  .ticker-text {
    font-size: 0.55rem;
    font-weight: 800;
    color: #00ff88;
    white-space: nowrap;
    animation: textFlash 1.8s infinite alternate;
  }

  @keyframes textFlash {
    0% { color: #00ff88; }
    50% { color: var(--accent-cyan); }
    100% { color: #ff00ea; }
  }

  .ticker-sub {
    font-size: 0.5rem;
    color: rgba(255, 255, 255, 0.6);
    margin-top: 1px;
  }

  /* Rapid Robotic Finger Tapping */
  .hyper-finger-actor {
    position: absolute;
    right: 12px;
    bottom: 8px;
    display: flex;
    align-items: center;
    pointer-events: none;
  }

  .finger-pointer {
    font-size: 1.2rem;
    animation: fingerTapRapid 0.45s infinite alternate ease-in-out;
  }

  @keyframes fingerTapRapid {
    0% { transform: translateY(0) rotate(-15deg); }
    100% { transform: translateY(-8px) rotate(-5deg); }
  }

  .sparkle {
    position: absolute;
    font-size: 0.75rem;
    opacity: 0;
    animation: sparkPop 0.9s infinite ease-out;
  }

  .sp1 { top: -10px; left: -10px; animation-delay: 0.1s; }
  .sp2 { top: -14px; left: 6px; animation-delay: 0.4s; }
  .sp3 { top: -4px; left: -18px; animation-delay: 0.7s; }

  @keyframes sparkPop {
    0% { transform: scale(0.2); opacity: 0; }
    50% { transform: scale(1.3); opacity: 1; }
    100% { transform: scale(0.4) translateY(-10px); opacity: 0; }
  }

  /* Dancing Shoes */
  .phone-dancing-shoes {
    display: flex;
    justify-content: space-around;
    width: 100%;
    margin-top: 6px;
    padding: 0 15px;
  }

  .shoe {
    font-size: 1.1rem;
    display: inline-block;
  }

  .s-left {
    animation: shoeTapLeft 0.6s infinite alternate ease-in-out;
  }

  .s-right {
    animation: shoeTapRight 0.6s infinite alternate ease-in-out 0.3s;
  }

  @keyframes shoeTapLeft {
    0% { transform: translateY(0) rotate(0deg); }
    100% { transform: translateY(-4px) rotate(-15deg); }
  }

  @keyframes shoeTapRight {
    0% { transform: translateY(0) rotate(0deg); }
    100% { transform: translateY(-4px) rotate(15deg); }
  }

  /* Guarantee Badge Pill */
  .funny-badge-pill {
    margin-top: 0.85rem;
    background: rgba(0, 240, 255, 0.06);
    border: 1px solid rgba(0, 240, 255, 0.25);
    border-radius: 20px;
    padding: 0.4rem 0.75rem;
    font-size: 0.72rem;
    color: var(--text-primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
    box-shadow: 0 0 10px rgba(0, 240, 255, 0.1);
  }

  .pill-radar {
    width: 7px;
    height: 7px;
    background: var(--accent-cyan);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent-cyan);
    animation: radarPulse 1.2s infinite ease-out;
    flex-shrink: 0;
  }

  @keyframes radarPulse {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.6); opacity: 0.4; }
    100% { transform: scale(1); opacity: 1; }
  }

  @media (max-width: 1200px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
