---
const services = [
  {
    title: "Mobile Architecture",
    description: "Native and cross-platform mobile applications engineered for ultimate performance and fluid UX."
  },
  {
    title: "Web Platforms",
    description: "High-conversion, ultra-fast web experiences built with next-gen frameworks like Astro, React, and Vue."
  },
  {
    title: "Enterprise Software",
    description: "Bespoke internal tools, CRM systems, and scalable backend infrastructures tailored to your exact needs."
  },
  {
    title: "Interactive Experiences",
    description: "Web-based games, 3D product configurators, and immersive WebGL experiences that captivate users."
  }
];
---

<section id="services" class="services">
  <!-- Full Width Background Glows -->
  <div class="services-glow left-glow"></div>
  <div class="services-glow right-glow"></div>

  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        World-Class <span class="text-gradient">Capabilities</span>
      </h2>
      <p class="section-subtitle">
        We forge digital solutions that push the boundaries of technology and design.
      </p>
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <div class="service-card glass-panel" tabindex="0">
          <div class="service-header">
            <h3 class="service-title">{service.title}</h3>
            <span class="hover-indicator" aria-hidden="true">+</span>
          </div>
          <div class="service-details">
            <p class="service-description">{service.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding: 6rem 0;
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .services-glow {
    position: absolute;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.12;
    pointer-events: none;
  }

  .left-glow {
    top: 10%;
    left: -150px;
    background: var(--accent-cyan);
  }

  .right-glow {
    bottom: 10%;
    right: -150px;
    background: var(--accent-purple);
  }

  .section-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 4rem;
  }

  .section-title {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin-bottom: 1.25rem;
    text-transform: uppercase;
  }

  .section-subtitle {
    color: var(--text-secondary);
    font-size: 1.2rem;
    font-weight: 300;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
    width: 100%;
    align-items: start;
  }

  .service-card {
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    position: relative;
    z-index: 1;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
  }

  .service-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 1rem;
  }

  .service-title {
    font-size: 1.3rem;
    margin-bottom: 0;
    color: var(--text-primary);
    position: relative;
    z-index: 2;
    transition: color 0.3s ease;
    line-height: 1.35;
  }

  .hover-indicator {
    font-size: 1.25rem;
    color: var(--accent-cyan);
    opacity: 0.6;
    transition: transform 0.35s ease, opacity 0.35s ease, color 0.35s ease;
    font-weight: 300;
    flex-shrink: 0;
  }

  /* Details Hidden by Default */
  .service-details {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(8px);
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1), 
                opacity 0.35s ease, 
                transform 0.35s ease,
                margin-top 0.35s ease;
    margin-top: 0;
    width: 100%;
  }

  .service-description {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    position: relative;
    z-index: 2;
  }

  /* Reveal Details ONLY on Hover / Focus - NO GLOW EFFECT */
  .service-card:hover,
  .service-card:focus-within {
    box-shadow: none;
    border-color: rgba(255, 255, 255, 0.12);
  }

  .service-card:hover .service-title,
  .service-card:focus-within .service-title {
    color: var(--accent-cyan);
  }

  .service-card:hover .hover-indicator,
  .service-card:focus-within .hover-indicator {
    transform: rotate(45deg);
    opacity: 1;
    color: var(--accent-purple);
  }

  .service-card:hover .service-details,
  .service-card:focus-within .service-details {
    max-height: 160px;
    opacity: 1;
    transform: translateY(0);
    margin-top: 1rem;
  }

  @media (max-width: 1200px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
